<!-- Views/Shared/_FavoritePartial.cshtml -->
@{
    var count = ViewBag.FavoriteCount ?? 0;
    var isGuest = ViewBag.IsGuest ?? false;
    var maxGuestItems = 5;
    var maxUserItems = 20;
}

<div class="relative group" id="favorite-container">
    <a asp-controller="Favorites" asp-action="Index"
       class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-800 transition-colors">

        <div class="relative">
            <svg class="w-6 h-6 text-gray-300 hover:text-red-400 transition-colors"
                 fill="@(count > 0 ? "currentColor" : "none")"
                 stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>

            @if (count > 0)
            {
                <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"
                      id="favorite-count-badge">
                    @count
                </span>
            }
        </div>

        <span class="hidden md:inline text-gray-300">Избранное</span>
    </a>

    <!-- Выпадающее меню (опционально) -->
    <div class="absolute right-0 mt-2 w-64 bg-gray-900 rounded-xl shadow-2xl border border-gray-800 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 z-50">
        <div class="p-4">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-white">Избранное</h3>
                <span class="text-sm text-gray-400">@count/@(isGuest? maxGuestItems : maxUserItems)</span>
            </div>

            @if (count == 0)
            {
                <p class="text-gray-400 text-sm text-center py-4">
                    Пока ничего нет
                </p>
            }
            else
            {
                <div id="favorite-dropdown-items" class="max-h-48 overflow-y-auto">
                    <!-- Динамически загружаемые элементы -->
                    <div class="text-center py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500 mx-auto"></div>
                        <p class="text-gray-400 text-sm mt-2">Загрузка...</p>
                    </div>
                </div>
            }

            <div class="mt-4 pt-4 border-t border-gray-800">
                <a asp-controller="Favorites" asp-action="Index"
                   class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-sm transition-colors">
                    Перейти в избранное
                </a>

                @if (isGuest && count > 0)
                {
                    <p class="text-xs text-gray-400 mt-2 text-center">
                        Войдите, чтобы сохранить избранное навсегда
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Функция для загрузки последних избранных в выпадающее меню
    async function loadFavoriteDropdown() {
        try {
            const response = await fetch('/Favorites?handler=recent');
            if (response.ok) {
                const html = await response.text();
                document.getElementById('favorite-dropdown-items').innerHTML = html;
            }
        } catch (error) {
            console.error('Error loading favorites dropdown:', error);
        }
    }

    // Загружаем при наведении
    document.getElementById('favorite-container')?.addEventListener('mouseenter', loadFavoriteDropdown);
</script>