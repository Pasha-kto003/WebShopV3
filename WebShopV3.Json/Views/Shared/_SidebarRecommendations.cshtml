@using WebShopV3.Json.Models.Recommendation
@model WebShopV3.Controllers.RecommendationViewModel
@{
    if (!Model.Recommendations.Any()) return;
}

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <h3 class="font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 text-blue-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
        </svg>
        @(string.IsNullOrEmpty(Model.Title) ? "Рекомендуем" : Model.Title)
    </h3>
    
    <div class="space-y-3">
        @foreach (var item in Model.Recommendations.Take(4))
        {
            <a href="@GetProductUrl(item)" 
               class="flex items-start p-2 rounded hover:bg-gray-50 group">
                <!-- Изображение -->
                <div class="flex-shrink-0 w-12 h-12 bg-gray-100 rounded overflow-hidden mr-3">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" 
                             class="w-full h-full object-cover">
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                            @GetCategoryIcon(item.ComponentType)
                        </div>
                    }
                </div>
                
                <!-- Информация -->
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate group-hover:text-blue-600">
                        @item.Name
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-gray-900">
                            @item.Price.ToString("C")
                        </span>
                        @if (item.RelevanceScore > 0.8)
                        {
                            <span class="text-xs px-1 py-0.5 bg-yellow-100 text-yellow-800 rounded">
                                ★
                            </span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
    
    @if (Model.Recommendations.Count > 4)
    {
        <div class="mt-4 pt-3 border-t border-gray-200">
            <a href="@Url.Action("ForYou", "Recommendation")" 
               class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                Все рекомендации →
            </a>
        </div>
    }
</div>

@functions {
    string GetProductUrl(RecommendationItem item)
    {
        return item.ProductType == "Computer" 
            ? Url.Action("ComputerDetails", "Home", new { id = item.Id })
            : Url.Action("ComponentDetails", "Home", new { id = item.Id });
    }
    
    string GetCategoryIcon(string? category)
    {
        return category?.ToUpper() switch
        {
            "CPU" => "⚡",
            "GPU" => "🎮",
            _ => "🔧"
        };
    }
}