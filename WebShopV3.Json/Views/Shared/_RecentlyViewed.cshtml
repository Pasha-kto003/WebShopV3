<!-- Views/Shared/_RecentlyViewed.cshtml -->
@model List<Computer>

@if (Model != null && Model.Any())
{
    <div class="mt-16 pt-12 border-t border-gray-800" id="recently-viewed-section" data-total-items="@Model.Count">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-bold text-white mb-2">Вы недавно смотрели</h2>
                <p class="text-gray-400 text-sm">Собранные ПК, которые вы просматривали ранее</p>
            </div>
            
            <div class="flex items-center gap-4">
                <!-- Счетчик -->
                <div class="text-sm text-gray-500 hidden sm:block">
                    <span id="recently-viewed-counter">1-@Math.Min(4, Model.Count)</span> из <span>@Model.Count</span>
                </div>
                
                <!-- Кнопка очистки -->
                <form asp-controller="Home" asp-action="ClearViewHistory" method="post" 
                      onsubmit="return confirm('Очистить историю просмотров?');" class="inline-block">
                    @Html.AntiForgeryToken()
                    <button type="submit" 
                            class="flex items-center gap-2 text-sm text-gray-400 hover:text-white px-4 py-2 rounded-lg border border-gray-700 hover:border-red-500 hover:bg-red-500/10 transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Очистить
                    </button>
                </form>
            </div>
        </div>
        
        <!-- Контейнер для карточек -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6" id="recently-viewed-container">
            @for (int i = 0; i < Model.Count; i++)
            {
                var computer = Model[i];
                <div class="recently-viewed-item @(i >= 4 ? "hidden" : "")" data-index="@i">
                    <div class="group relative bg-gray-900/50 rounded-xl overflow-hidden border border-gray-800 hover:border-primary transition-all duration-300 hover:shadow-lg hover:shadow-primary/10">
                        <a asp-controller="Home" asp-action="ComputerDetails" asp-route-id="@computer.Id" 
                           class="block hover:no-underline">
                            
                            <!-- Изображение -->
                            <div class="relative h-48 bg-gradient-to-br from-gray-900 to-black overflow-hidden">
                                @if (!string.IsNullOrEmpty(computer.ImageUrl))
                                {
                                    <img src="/Images/computers/@computer.ImageUrl" alt="@computer.Name" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <div class="text-6xl opacity-20">🖥️</div>
                                    </div>
                                }
                                
                                <!-- Бейдж цены -->
                                <div class="absolute top-3 right-3 bg-primary/90 text-dark font-bold text-sm px-3 py-1 rounded-full">
                                    @computer.Price.ToString("C")
                                </div>
                            </div>
                            
                            <!-- Контент карточки -->
                            <div class="p-5">
                                <!-- Название -->
                                <h3 class="text-white font-bold text-base line-clamp-2 mb-3 group-hover:text-primary transition-colors min-h-[3rem]">
                                    @computer.Name
                                </h3>
                                
                                <!-- Статистика -->
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center text-gray-400 text-sm">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <span>@computer.ComputerComponents?.Count комп.</span>
                                    </div>
                                </div>
                                
                                <!-- Ключевые компоненты -->
                                @if (computer.ComputerComponents != null)
                                {
                                    var cpu = computer.ComputerComponents
                                        .Select(cc => cc.Component)
                                        .FirstOrDefault(c => c.Type == "CPU");
                                    var gpu = computer.ComputerComponents
                                        .Select(cc => cc.Component)
                                        .FirstOrDefault(c => c.Type == "GPU");
                                    var ramCount = computer.ComputerComponents
                                        .Select(cc => cc.Component)
                                        .Count(c => c.Type == "RAM");
                                    
                                    <div class="space-y-2 text-sm">
                                        @if (cpu != null)
                                        {
                                            <div class="flex items-center">
                                                <span class="text-xs text-gray-500 w-10">CPU:</span>
                                                <span class="text-gray-300 truncate flex-1">@cpu.Name</span>
                                            </div>
                                        }
                                        
                                        @if (gpu != null)
                                        {
                                            <div class="flex items-center">
                                                <span class="text-xs text-gray-500 w-10">GPU:</span>
                                                <span class="text-gray-300 truncate flex-1">@gpu.Name</span>
                                            </div>
                                        }
                                        
                                        @if (ramCount > 0)
                                        {
                                            <div class="flex items-center">
                                                <span class="text-xs text-gray-500 w-10">RAM:</span>
                                                <span class="text-gray-300">@ramCount модуля</span>
                                            </div>
                                        }
                                    </div>
                                }
                                
                                <!-- Кнопка -->
                                <div class="mt-5 pt-4 border-t border-gray-800">
                                    <div class="w-full bg-gray-800 hover:bg-gray-700 text-white text-sm py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2 group-hover:bg-primary group-hover:text-dark font-medium">
                                        <span>Посмотреть</span>
                                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
        
        <!-- Пагинация - показываем только если больше 4 карточек -->
        @if (Model.Count > 4)
        {
            <div class="flex flex-col items-center gap-4 mt-8 pt-6 border-t border-gray-800">
                <!-- Основная пагинация -->
                <div class="flex items-center gap-2">
                    <!-- Кнопка "Назад" -->
                    <button onclick="prevPage()" 
                            class="p-2 rounded-lg border border-gray-700 text-gray-400 hover:text-white hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed transition-all"
                            id="prev-page-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>
                    
                    <!-- Номера страниц -->
                    <div class="flex items-center gap-1" id="page-numbers">
                        @{
                            int totalPages = (int)Math.Ceiling(Model.Count / 4.0);
                        }
                        
                        @for (int i = 1; i <= Math.Min(5, totalPages); i++)
                        {
                            <button onclick="goToPage(@i)" 
                                    class="page-btn w-10 h-10 rounded-lg flex items-center justify-center text-sm font-medium transition-all @(i == 1 ? "bg-primary text-dark" : "bg-gray-800 text-gray-400 hover:bg-gray-700")">
                                @i
                            </button>
                        }
                        
                        @if (totalPages > 5)
                        {
                            <span class="text-gray-500 px-2">...</span>
                            <button onclick="goToPage(@totalPages)" 
                                    class="page-btn w-10 h-10 rounded-lg flex items-center justify-center text-sm bg-gray-800 text-gray-400 hover:bg-gray-700">
                                @totalPages
                            </button>
                        }
                    </div>
                    
                    <!-- Кнопка "Вперед" -->
                    <button onclick="nextPage()" 
                            class="p-2 rounded-lg border border-gray-700 text-gray-400 hover:text-white hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed transition-all"
                            id="next-page-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>
                
                <!-- Информация о текущей странице -->
                <div class="text-center text-sm text-gray-500">
                    Страница <span id="current-page">1</span> из <span id="total-pages">@totalPages</span>
                </div>
            </div>
        }
    </div>
    
    <script>
        // Инициализация пагинации
        let currentPage = 1;
        const itemsPerPage = 4;
        const totalItems = @Model.Count;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        
        // Функция для перехода на страницу
        function goToPage(page) {
            if (page < 1 || page > totalPages) return;
            
            currentPage = page;
            
            // Показать/скрыть карточки
            const items = document.querySelectorAll('.recently-viewed-item');
            items.forEach((item, index) => {
                const startIndex = (page - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                
                if (index >= startIndex && index < endIndex) {
                    item.classList.remove('hidden');
                    // Добавляем анимацию
                    setTimeout(() => {
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                    }, (index - startIndex) * 100);
                } else {
                    item.classList.add('hidden');
                }
            });
            
            // Обновить UI
            updatePageDisplay();
            updatePageButtons();
            updateCounter();
        }
        
        // Следующая страница
        function nextPage() {
            goToPage(currentPage + 1);
        }
        
        // Предыдущая страница
        function prevPage() {
            goToPage(currentPage - 1);
        }
        
        // Обновить отображение страницы
        function updatePageDisplay() {
            document.getElementById('current-page').textContent = currentPage;
            document.getElementById('total-pages').textContent = totalPages;
            
            // Обновить активную кнопку страницы
            document.querySelectorAll('.page-btn').forEach(btn => {
                const pageNum = parseInt(btn.textContent);
                if (pageNum === currentPage) {
                    btn.classList.remove('bg-gray-800', 'text-gray-400');
                    btn.classList.add('bg-primary', 'text-dark');
                } else {
                    btn.classList.remove('bg-primary', 'text-dark');
                    btn.classList.add('bg-gray-800', 'text-gray-400');
                }
            });
        }
        
        // Обновить кнопки навигации
        function updatePageButtons() {
            const prevBtn = document.getElementById('prev-page-btn');
            const nextBtn = document.getElementById('next-page-btn');
            
            if (prevBtn) {
                prevBtn.disabled = currentPage === 1;
                prevBtn.classList.toggle('opacity-50', currentPage === 1);
                prevBtn.classList.toggle('cursor-not-allowed', currentPage === 1);
            }
            
            if (nextBtn) {
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.classList.toggle('opacity-50', currentPage === totalPages);
                nextBtn.classList.toggle('cursor-not-allowed', currentPage === totalPages);
            }
        }
        
        // Обновить счетчик
        function updateCounter() {
            const start = ((currentPage - 1) * itemsPerPage) + 1;
            const end = Math.min(currentPage * itemsPerPage, totalItems);
            
            document.getElementById('recently-viewed-counter').textContent = `${start}-${end}`;
        }
        
        // Инициализация при загрузке
        document.addEventListener('DOMContentLoaded', function() {
            if (totalItems > 0) {
                updatePageButtons();
                updateCounter();
                
                // Добавить анимацию для видимых карточек
                const visibleItems = document.querySelectorAll('.recently-viewed-item:not(.hidden)');
                visibleItems.forEach((item, index) => {
                    item.style.opacity = '0';
                    item.style.transform = 'translateY(20px)';
                    item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    
                    setTimeout(() => {
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                    }, index * 100);
                });
            }
        });
        
        // Обработка клавиатуры
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') {
                prevPage();
            } else if (e.key === 'ArrowRight') {
                nextPage();
            }
        });
    </script>
    
    <style>
        .recently-viewed-item {
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
        
        .recently-viewed-item.hidden {
            display: none;
        }
        
        /* Анимация появления */
        .recently-viewed-item:not(.hidden) {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Стили для кнопок пагинации */
        .page-btn {
            transition: all 0.2s ease;
        }
        
        .page-btn:active {
            transform: scale(0.95);
        }
        
        /* Адаптивность */
        @@media (max-width: 768px) {
            #recently-viewed-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @@media (max-width: 640px) {
            #recently-viewed-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
else
{
    <!-- Пустое состояние -->
    <div class="mt-16 pt-12 border-t border-gray-800 text-center py-12">
        <div class="inline-block p-8 rounded-2xl bg-gray-900/30 border border-gray-800 max-w-md">
            <div class="text-6xl mb-4 opacity-30">👀</div>
            <h3 class="text-xl font-bold text-white mb-3">История просмотров пуста</h3>
            <p class="text-gray-400 mb-6">
                Здесь будут отображаться сборки ПК, которые вы посмотрите.
                Перейдите в каталог и выберите интересующие вас конфигурации.
            </p>
            <a asp-controller="Home" asp-action="Catalog" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-dark font-semibold rounded-lg hover:bg-green-400 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                Перейти в каталог
            </a>
        </div>
    </div>
}