<script>
            // Функция для страницы корзины
            function initCartPage() {
                // Проверяем, существует ли jQuery
                if (typeof $ === 'undefined') {
                    console.error('jQuery не подключен');
                    return;
                }


                loadSimilarComputers();

                // Обновление при изменении корзины
                $(document).on('cartUpdated', function() {
                    setTimeout(loadSimilarComputers, 500);
                });

                // Кнопка обновления
                $('#refreshSimilarComputers').on('click', function() {
                    loadSimilarComputers(true);
                });

                // Обновление количества
                $('.quantity-increase').on('click', function () {
                    const cartItem = $(this).closest('.cart-item');
                    const computerId = cartItem.data('computer-id');
                    const componentId = cartItem.data('component-id');
                    const quantityElement = cartItem.find('.quantity');
                    let quantity = parseInt(quantityElement.text()) || 0;
                    const newQuantity = quantity + 1;
                    quantityElement.text(newQuantity);
                    updateCartQuantity(computerId, componentId, newQuantity);
                });

                $('.quantity-decrease').on('click', function () {
                    const cartItem = $(this).closest('.cart-item');
                    const computerId = cartItem.data('computer-id');
                    const componentId = cartItem.data('component-id');
                    const quantityElement = cartItem.find('.quantity');
                    let quantity = parseInt(quantityElement.text()) || 0;
                    if (quantity > 1) {
                        const newQuantity = quantity - 1;
                        quantityElement.text(newQuantity);
                        updateCartQuantity(computerId, componentId, newQuantity);
                    }
                });

                // Удаление из корзины
                $('.remove-from-cart').on('click', function () {
                    const cartItem = $(this).closest('.cart-item');
                    const computerId = cartItem.data('computer-id');
                    const componentId = cartItem.data('component-id');
                    removeFromCart(computerId, componentId);
                });

                // Очистка корзины
                $('#clear-cart').on('click', function () {
                    if (!$(this).length) return;
                    if (confirm('Вы уверены, что хотите очистить корзину?')) {
                        clearCart();
                    }
                });

                // Добавление в избранное
                $('.add-to-favorites').on('click', function () {
                    const computerId = $(this).data('computer-id');
                    addToFavorites(computerId);
                });

                // Добавление аксессуаров
                $('.add-accessory').on('click', function () {
                    const name = $(this).data('name');
                    const price = $(this).data('price');
                    showCartNotification(`Товар "${name}" добавлен в корзину!`);
                });

                // Обновление дополнительных услуг
                $('.service-checkbox').on('change', function () {
                    updateCartTotals();
                });

                // Применение промокода
                $('#applyPromoBtn').on('click', function () {
                    const promoCode = $('#promoCodeInput').val().trim();
                    if (promoCode) {
                        applyPromoCode(promoCode);
                    } else {
                        showCartNotification('Введите промокод', 'error');
                    }
                });

                function loadSimilarComputers() {
                    $.ajax({
                        url: '@Url.Action("GetSimilarComputers", "Cart")',
                        type: 'GET',
                        dataType: 'json',
                        success: function(response) {
                            if (response && response.success && response.recommendations && response.recommendations.length > 0) {
                                renderSimilarComputers(response.recommendations);
                            } else {
                                showNoRecommendations();
                            }
                        },
                        error: function() {
                            showNoRecommendations();
                        }
                    });
                }

                function renderSimilarComputers(computers) {
                    const container = $('#similarComputersContainer');
                    container.empty();

                    computers.forEach(computer => {
                        // Упрощенная карточка
                        const computerCard = `
                            <div class="bg-dark-card rounded-xl border border-gray-800 hover:border-primary/40 transition duration-200 overflow-hidden group">
                                <!-- Изображение (компактное) -->
                                <div class="h-32 bg-gradient-to-br from-primary/5 to-primary/10 overflow-hidden relative">
                                    <img src="/Images/computers/${computer.imageUrl || 'default-computer.jpg'}"
                                         alt="${computer.name}"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                         onerror="this.src='/Images/computers/default-computer.jpg'">
                                    <div class="absolute top-2 left-2">
                                        <span class="inline-block bg-primary/90 text-dark text-xs px-2 py-1 rounded font-medium">
                                            ${computer.category || 'Рекомендация'}
                                        </span>
                                    </div>
                                </div>

                                <!-- Контент (компактный) -->
                                <div class="p-3">
                                    <!-- Название -->
                                    <h3 class="text-white font-semibold text-sm mb-1 line-clamp-1" title="${computer.name}">
                                        ${computer.name}
                                    </h3>

                                    <!-- Цена -->
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-primary font-bold text-base">${formatPrice(computer.price)}</span>
                                    </div>

                                    <!-- Кнопки -->
                                    <div class="flex space-x-2">
                                        <a href="@Url.Action("ComputerDetails", "Home")/${computer.id}"
                                           class="flex-1 bg-gray-700 text-white px-2 py-1.5 rounded text-xs font-medium hover:bg-gray-600 transition duration-200 text-center">
                                            Подробнее
                                        </a>
                                        <button type="button"
                                                class="flex-1 add-to-cart-btn bg-primary text-dark px-2 py-1.5 rounded text-xs font-medium hover:bg-green-400 transition duration-200"
                                                data-computer-id="${computer.id}">
                                            В корзину
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;

                        container.append(computerCard);
                    });

                    // Добавляем обработчики
                    $('.add-to-cart-btn').on('click', function() {
                        const computerId = $(this).data('computer-id');
                        addComputerToCart(computerId);
                    });
                }

                function showNoRecommendations() {
                    const container = $('#similarComputersContainer');
                    container.html(`
                        <div class="col-span-full text-center py-8">
                            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                                </svg>
                            </div>
                            <h3 class="text-base font-semibold text-white mb-1">Нет рекомендаций</h3>
                            <p class="text-gray-400 text-sm">Добавьте товары в корзину</p>
                        </div>
                    `);
                }

                function getAntiForgeryToken() {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    if (!token) {
                        console.error('AntiForgeryToken не найден');
                    }
                    return token;
                }

                // Обновление количества через контроллер
                function updateCartQuantity(computerId, componentId, quantity) {
                    const token = getAntiForgeryToken();
                    if (!token) return;

                    const requestData = {
                        quantity: quantity,
                        __RequestVerificationToken: token
                    };

                    // Добавляем только тот ID, который есть
                    if (computerId) {
                        requestData.computerId = computerId;
                    }
                    if (componentId) {
                        requestData.componentId = componentId;
                    }

                    console.log('Sending update request:', requestData);

                    $.ajax({
                        url: '@Url.Action("UpdateQuantity", "Cart")',
                        type: 'POST',
                        data: requestData,
                        dataType: 'json',
                        success: function (response) {
                            console.log('Update response:', response);
                            if (response && response.success) {
                                // Обновляем общую сумму в правой панели
                                if (response.totalAmount !== undefined) {
                                    $('#subtotal').text(formatPrice(response.totalAmount));
                                    $('#total').text(formatPrice(response.totalAmount));
                                }

                                // Обновляем общее количество товаров
                                if (response.totalItems !== undefined) {
                                    // Обновляем текст "Товары (X шт.)"
                                    $('.cart-summary .text-gray-400:contains("Товары")').each(function() {
                                        const text = $(this).text();
                                        if (text.includes('Товары')) {
                                            $(this).text(`Товары (${response.totalItems} шт.)`);
                                        }
                                    });
                                }

                                showCartNotification('Количество обновлено');
                            } else {
                                // Если ошибка - восстанавливаем предыдущее значение
                                const cartItem = findCartItem(computerId, componentId);
                                if (cartItem) {
                                    const quantityElement = cartItem.find('.quantity');
                                    const oldQuantity = parseInt(quantityElement.text()) || 1;
                                    quantityElement.text(oldQuantity);
                                }
                                showCartNotification(response?.message || 'Ошибка при обновлении', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Ошибка при обновлении количества:', error, xhr.responseText);
                            // Восстанавливаем предыдущее значение при ошибке
                            const cartItem = findCartItem(computerId, componentId);
                            if (cartItem) {
                                const quantityElement = cartItem.find('.quantity');
                                const oldQuantity = parseInt(quantityElement.text()) || 1;
                                quantityElement.text(oldQuantity);
                            }
                            showCartNotification('Ошибка при обновлении количества', 'error');
                        }
                    });
                }

                // Удаление из корзины через контроллер
                function removeFromCart(computerId, componentId) {
                    if (!confirm('Удалить товар из корзины?')) {
                        return;
                    }

                    const token = getAntiForgeryToken();
                    if (!token) return;

                    const requestData = {
                        __RequestVerificationToken: token
                    };

                    // Добавляем только тот ID, который есть
                    if (computerId) {
                        requestData.computerId = computerId;
                    }
                    if (componentId) {
                        requestData.componentId = componentId;
                    }

                    console.log('Sending remove request:', requestData);

                    $.ajax({
                        url: '@Url.Action("RemoveFromCart", "Cart")',
                        type: 'POST',
                        data: requestData,
                        dataType: 'json',
                        success: function (response) {
                            console.log('Remove response:', response);
                            if (response && response.success) {
                                // Находим и удаляем элемент
                                const cartItem = findCartItem(computerId, componentId);
                                if (cartItem) {
                                    cartItem.fadeOut(300, function () {
                                        $(this).remove();

                                        // Проверяем, пуста ли корзина
                                        if ($('.cart-item').length === 0) {
                                            // Если корзина пуста, перезагружаем страницу
                                            location.reload();
                                        } else {
                                            // Обновляем общие суммы
                                            if (response.totalAmount !== undefined) {
                                                $('#subtotal').text(formatPrice(response.totalAmount));
                                                $('#total').text(formatPrice(response.totalAmount));
                                            }

                                            // Обновляем общее количество товаров
                                            if (response.totalItems !== undefined) {
                                                $('.cart-summary .text-gray-400:contains("Товары")').each(function() {
                                                    const text = $(this).text();
                                                    if (text.includes('Товары')) {
                                                        $(this).text(`Товары (${response.totalItems} шт.)`);
                                                    }
                                                });
                                            }
                                        }
                                    });
                                }

                                showCartNotification('Товар удален из корзины');
                            } else {
                                showCartNotification(response?.message || 'Ошибка при удалении', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Ошибка при удалении товара:', error, xhr.responseText);
                            showCartNotification('Ошибка при удалении товара', 'error');
                        }
                    });
                }

                // Поиск элемента корзины по ID
                function findCartItem(computerId, componentId) {
                    let selector = '.cart-item';
                    if (computerId) {
                        selector = `.cart-item[data-computer-id="${computerId}"]`;
                    } else if (componentId) {
                        selector = `.cart-item[data-component-id="${componentId}"]`;
                    }
                    return $(selector).first();
                }

                // Очистка корзины через контроллер
                function clearCart() {
                    const token = getAntiForgeryToken();
                    if (!token) return;

                    $.ajax({
                        url: '@Url.Action("Clear", "Cart")',
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token
                        },
                        dataType: 'json',
                        success: function (response) {
                            if (response && response.success) {
                                location.reload();
                            } else {
                                showCartNotification(response?.message || 'Ошибка при очистке', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Ошибка при очистке корзины:', error);
                            showCartNotification('Ошибка при очистке корзины', 'error');
                        }
                    });
                }

                // Добавление в избранное
                function addToFavorites(computerId) {
                    const token = getAntiForgeryToken();
                    if (!token) return;

                    $.ajax({
                        url: '@Url.Action("Add", "Favorites")',
                        type: 'POST',
                        data: {
                            computerId: computerId,
                            __RequestVerificationToken: token
                        },
                        dataType: 'json',
                        success: function (response) {
                            if (response && response.success) {
                                showCartNotification('Товар добавлен в избранное');
                            } else {
                                showCartNotification(response?.message || 'Ошибка при добавлении', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Ошибка при добавлении в избранное:', error);
                            showCartNotification('Ошибка при добавлении в избранное', 'error');
                        }
                    });
                }

                // Применение промокода (заглушка)
                function applyPromoCode(promoCode) {
                    // Здесь можно добавить логику применения промокода через AJAX
                    showCartNotification('Промокод "' + promoCode + '" применен!');
                    updateCartTotals();
                }

                // Обновление итогов с учетом дополнительных услуг
                function updateCartTotals() {
                    // Получаем сумму товаров из корзины
                    let subtotal = 0;
                    $('.cart-item').each(function () {
                        const price = parseFloat($(this).data('price')) || 0;
                        const quantity = parseInt($(this).find('.quantity').text()) || 0;
                        subtotal += price * quantity;
                    });

                    // Сумма дополнительных услуг
                    let servicesTotal = 0;
                    $('.service-checkbox:checked').each(function () {
                        servicesTotal += parseFloat($(this).data('price')) || 0;
                    });

                    // Итоговая сумма
                    const total = subtotal + servicesTotal;

                    // Обновляем отображение
                    $('#servicesTotal').text(formatPrice(servicesTotal));
                    $('#total').text(formatPrice(total));
                }

                // Форматирование цены
                function formatPrice(price) {
                    if (isNaN(price)) {
                        return '0 ₽';
                    }
                    return new Intl.NumberFormat('ru-RU').format(price) + ' ₽';
                }

                // Показать уведомление
                function showCartNotification(message, type = 'success') {
                    const alertClass = type === 'success'
                        ? 'bg-green-500/20 border-green-500/30 text-green-400'
                        : 'bg-red-500/20 border-red-500/30 text-red-400';

                    // Удаляем предыдущие уведомления
                    $('.cart-notification').remove();

                    const notification = $(`
                        <div class="cart-notification fixed top-4 right-4 z-50 p-4 rounded-lg border backdrop-blur-sm transition-all duration-300 transform translate-x-full max-w-md ${alertClass}">
                            <div class="flex items-center">
                                ${type === 'success' ?
                                    '<svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' :
                                    '<svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'
                                }
                                <span class="text-sm">${message}</span>
                            </div>
                        </div>
                    `);

                    $('body').append(notification);

                    // Показываем уведомление
                    setTimeout(() => {
                        notification.removeClass('translate-x-full');
                    }, 100);

                    // Скрываем через 3 секунды
                    setTimeout(() => {
                        notification.addClass('translate-x-full');
                        setTimeout(() => {
                            notification.remove();
                        }, 300);
                    }, 3000);
                }

                // Инициализация анимации появления элементов
                initAnimations();

                // Инициализация общих сумм
                updateCartTotals();
            }

            // Инициализация анимаций
            function initAnimations() {
                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -50px 0px'
                };

                if ('IntersectionObserver' in window) {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('animate-fade-in');
                                observer.unobserve(entry.target);
                            }
                        });
                    }, observerOptions);

                    // Наблюдаем за всеми элементами корзины
                    document.querySelectorAll('.cart-item, .cart-summary, .services-section, .accessory-item, .empty-cart').forEach((el) => {
                        if (el) observer.observe(el);
                    });
                }
            }

            function loadSimilarComputers(forceRefresh = false) {
                const container = $('#similarComputersContainer');
                const emptyState = $('#noSimilarComputers');

                // Показываем индикатор загрузки
                container.html(`
                    <div class="col-span-full text-center py-12">
                        <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary mb-4"></div>
                        <p class="text-gray-400">${forceRefresh ? 'Обновляем поиск...' : 'Ищем похожие компьютеры...'}</p>
                    </div>
                `);
                emptyState.addClass('hidden');
                container.removeClass('hidden');

                $.ajax({
                    url: '@Url.Action("GetSimilarComputers", "Cart")',
                    type: 'GET',
                    data: { refresh: forceRefresh },
                    dataType: 'json',
                    success: function(response) {
                        if (response && response.success) {
                            if (response.recommendations && response.recommendations.length > 0) {
                                renderSimilarComputers(response.recommendations);
                            } else {
                                showNoSimilarComputers();
                            }
                        } else {
                            showNoSimilarComputers();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Ошибка при загрузке похожих компьютеров:', error);
                        showNoSimilarComputers();
                    }
                });
            }

            // Функция отображения похожих компьютеров
            function renderSimilarComputers(computers) {
                const container = $('#similarComputersContainer');
                const emptyState = $('#noSimilarComputers');

                container.empty();

                computers.forEach((computer, index) => {
                    const imageUrl = getComputerImageUrl(computer.imageUrl);
                    const description = computer.description || 'Мощный компьютер для различных задач';
                    const truncatedDescription = description.length > 80
                        ? description.substring(0, 80) + '...'
                        : description;

                    // Вычисляем процент схожести (если есть)
                    let similarityBadge = '';
                    if (computer.similarityScore !== undefined) {
                        const similarityPercent = Math.round(computer.similarityScore * 100);
                        similarityBadge = `
                            <div class="absolute top-3 right-3">
                                <span class="bg-green-500/90 text-white text-xs px-2 py-1 rounded font-semibold">
                                    ${similarityPercent}% совпадение
                                </span>
                            </div>
                        `;
                    }

                    const itemHtml = `
                        <div class="group bg-dark-card rounded-2xl border border-gray-800 hover:border-primary/50 transition-all duration-300 overflow-hidden similar-computer-item"
                             data-computer-id="${computer.id}"
                             style="animation-delay: ${index * 100}ms">

                            <!-- Изображение -->
                            <div class="relative h-48 overflow-hidden">
                                <img src="${imageUrl}"
                                     alt="${computer.name}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                <div class="absolute inset-0 bg-gradient-to-t from-dark/90 via-dark/50 to-transparent"></div>

                                <!-- Категория/совпадение -->
                                <div class="absolute top-3 left-3">
                                    <span class="bg-primary/90 text-dark text-xs px-2 py-1 rounded font-semibold">
                                        ${computer.category || 'Рекомендация'}
                                    </span>
                                </div>

                                ${similarityBadge}

                                <!-- Кнопка быстрого добавления -->
                                <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                    <button type="button"
                                            class="add-similar-computer-quick bg-primary text-dark p-2 rounded-full hover:bg-green-400 transition-colors duration-200 shadow-lg"
                                            data-computer-id="${computer.id}"
                                            data-name="${computer.name}"
                                            title="Добавить в корзину">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Информация -->
                            <div class="p-4">
                                <h4 class="text-white font-semibold text-lg mb-2 line-clamp-1">${computer.name}</h4>
                                <p class="text-gray-400 text-sm mb-4 line-clamp-2">${truncatedDescription}</p>

                                <!-- Цена и кнопка -->
                                <div class="flex items-center justify-between">
                                    <div>
                                        <span class="text-primary font-bold text-xl">${formatPrice(computer.price)}</span>
                                    </div>
                                    <div class="flex space-x-2">
                                        <button type="button"
                                                onclick="window.location.href='@Url.Action("Details", "Computer")/${computer.id}'"
                                                class="view-computer-details bg-gray-700 text-white px-3 py-2 rounded-lg text-sm font-semibold hover:bg-gray-600 transition-colors duration-200">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                            </svg>
                                            Подробнее
                                        </button>
                                        <button type="button"
                                                class="add-similar-computer bg-primary text-dark px-4 py-2 rounded-lg text-sm font-semibold hover:bg-green-400 transition-colors duration-200"
                                                data-computer-id="${computer.id}"
                                                data-name="${computer.name}">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                            </svg>
                                            В корзину
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    container.append(itemHtml);
                });

                // Добавляем обработчики
                attachSimilarComputerHandlers();

                // Анимация появления
                $('.similar-computer-item').each(function(index) {
                    $(this).css({
                        opacity: 0,
                        transform: 'translateY(20px)'
                    }).delay(index * 100).animate({
                        opacity: 1,
                        transform: 'translateY(0)'
                    }, 300);
                });

                emptyState.addClass('hidden');
                container.removeClass('hidden');
            }

            // Функция показа отсутствия рекомендаций
            function showNoSimilarComputers() {
                const container = $('#similarComputersContainer');
                const emptyState = $('#noSimilarComputers');

                container.addClass('hidden');
                emptyState.removeClass('hidden');
            }

            // Функция для получения URL изображения компьютера
            function getComputerImageUrl(imageUrl) {
                if (!imageUrl) {
                    return '/Images/default-computer.jpg';
                }

                if (imageUrl.startsWith('http') || imageUrl.startsWith('/')) {
                    return imageUrl;
                }

                return '/Images/' + imageUrl;
            }

            // Прикрепление обработчиков для похожих компьютеров
            function attachSimilarComputerHandlers() {
                // Основная кнопка добавления
                $('.add-similar-computer').on('click', function() {
                    const computerId = $(this).data('computer-id');
                    const name = $(this).data('name');
                    addComputerToCart(computerId, 1, name);
                });

                // Кнопка быстрого добавления
                $('.add-similar-computer-quick').on('click', function() {
                    const computerId = $(this).data('computer-id');
                    const name = $(this).data('name');
                    addComputerToCart(computerId, 1, name);
                });

                // Клик по карточке для просмотра деталей (кроме кнопок)
                $('.similar-computer-item').on('click', function(e) {
                    if (!$(e.target).closest('button').length) {
                        const computerId = $(this).data('computer-id');
                        window.location.href = '@Url.Action("Details", "Computer")/' + computerId;
                    }
                });
            }

            function addComputerToCart(computerId, quantity, name) {
                const token = getAntiForgeryToken();
                if (!token) return;

                showCartNotification(`Добавляем "${name}"...`, 'info');

                $.ajax({
                    url: '@Url.Action("AddToCart", "Cart")',
                    type: 'POST',
                    data: {
                        computerId: computerId,
                        quantity: quantity,
                        __RequestVerificationToken: token
                    },
                    dataType: 'json',
                    success: function(response) {
                        if (response && response.success) {
                            showCartNotification(`"${name}" добавлен в корзину!`);

                            // Триггерим событие обновления
                            $(document).trigger('cartUpdated');

                            // Обновляем счетчик
                            updateCartCounter();

                            // Перезагружаем через 1.5 секунды
                            setTimeout(() => {
                                location.reload();
                            }, 1500);
                        } else {
                            showCartNotification(response?.message || 'Ошибка при добавлении', 'error');
                        }
                    },
                    error: function() {
                        showCartNotification('Ошибка при добавлении в корзину', 'error');
                    }
                });
            }

            // Инициализация при загрузке документа
            $(document).ready(function() {
                initCartPage();
            });
</script>