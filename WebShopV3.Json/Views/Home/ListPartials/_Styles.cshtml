@* Views/Shared/ListPartials/_Styles.cshtml *@
<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

    .gradient-border {
        position: relative;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(16, 185, 129, 0.1));
        border-radius: 20px;
    }

        .gradient-border::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, #3B82F6, #10B981, #8B5CF6);
            border-radius: 22px;
            z-index: -1;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .gradient-border:hover::before {
            opacity: 1;
        }

    .image-container {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
    }

        .image-container::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 40%;
            background: linear-gradient(to top, rgba(30, 41, 59, 0.9), transparent);
        }

    .price-tag {
        background: linear-gradient(135deg, #3B82F6, #8B5CF6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        white-space: nowrap;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #3B82F6, #10B981);
        position: relative;
        overflow: hidden;
    }

        .btn-gradient::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s;
        }

        .btn-gradient:hover::before {
            left: 100%;
        }

    .specs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .spec-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .spec-icon {
        width: 12px;
        height: 12px;
        background: linear-gradient(135deg, #3B82F6, #8B5CF6);
        border-radius: 50%;
    }

    .stock-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
        display: inline-block;
    }

    .stock-high {
        background-color: #10B981;
    }

    .stock-medium {
        background-color: #F59E0B;
    }

    .stock-low {
        background-color: #EF4444;
    }

    .rating-stars {
        display: inline-flex;
        gap: 2px;
    }

    .star {
        color: #F59E0B;
        font-size: 0.875rem;
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: linear-gradient(135deg, #EF4444, #F59E0B);
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.75rem;
        z-index: 10;
        animation: bounce 2s infinite;
    }

    .compare-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(30, 41, 59, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #94a3b8;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .compare-btn:hover {
            background: rgba(59, 130, 246, 0.2);
            color: white;
            border-color: #3B82F6;
        }

        .compare-btn.checked {
            background: rgba(59, 130, 246, 0.3);
            color: white;
            border-color: #3B82F6;
        }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* Адаптивные стили */
    .product-card {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* Увеличиваем ширину карточек */
    .product-card {
        min-height: 620px;
    }

    /* Для мобильных устройств делаем карточки нормальной ширины */
    @@media (max-width: 768px) {
        .product-card {
            min-height: auto;
        }
    }

    /* Стили для вид списком */
    .list-view-card {
        display: grid;
        grid-template-columns: 200px 1fr auto;
        gap: 24px;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .list-view-card {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>