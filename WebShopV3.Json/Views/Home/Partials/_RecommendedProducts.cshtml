@using WebShopV3.Json.Models.Recommendation
@model WebShopV3.Json.Models.Computer
@inject WebShopV3.Json.Services.IRecommendationService RecommendationService
@{
    var recommendedComputers = ViewBag.RecommendedComputers as List<WebShopV3.Json.Models.Computer> ?? new List<WebShopV3.Json.Models.Computer>();
    var recommendedComponents = ViewBag.RecommendedComponents as List<WebShopV3.Json.Models.Component> ?? new List<WebShopV3.Json.Models.Component>();
    
    // Получаем рекомендации из сервиса
    var userId = User.Identity?.IsAuthenticated == true ? 
        int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value) : (int?)null;
    var guestId = Context.Request.Cookies["GuestId"] ?? Context.Session.Id;
    
    // Запрашиваем рекомендации
    List<RecommendationItem> aiRecommendations = new List<RecommendationItem>();
    
    if (Model != null && Model.Id > 0)
    {
        aiRecommendations = await RecommendationService.GetSimilarProductsAsync(Model.Id, "Computer", 8);
    }
    else
    {
        var request = new RecommendationRequest
        {
            UserId = userId,
            GuestId = guestId,
            CurrentProductId = Model?.Id,
            CurrentProductType = "Computer",
            Limit = 8,
            IncludeComputers = true,
            IncludeComponents = true
        };
        aiRecommendations = await RecommendationService.GetRecommendationsAsync(request);
    }
    
    // Создаем класс для хранения рекомендаций
    var allRecommended = new List<ProductRecommendation>();
    
    // 1. Добавляем AI рекомендации
    foreach (var rec in aiRecommendations)
    {
        allRecommended.Add(new ProductRecommendation
        {
            Id = rec.Id,
            Name = rec.Name,
            Price = rec.Price,
            ImageUrl = rec.ImageUrl,
            Type = rec.ProductType,
            ComponentType = rec.ComponentType,
            Description = rec.Description,
            Quantity = rec.StockQuantity,
            RelevanceScore = rec.RelevanceScore,
            IsAI = true,
            ScoreFactors = rec.ScoreFactors
        });
    }
    
    // 2. Добавляем рекомендации из ViewBag
    foreach (var computer in recommendedComputers)
    {
        if (!allRecommended.Any(r => r.Id == computer.Id && r.Type == "Computer"))
        {
            allRecommended.Add(new ProductRecommendation
            {
                Id = computer.Id,
                Name = computer.Name,
                Price = computer.Price,
                ImageUrl = computer.ImageUrl,
                Type = "Computer",
                ComponentType = null,
                Description = computer.Description,
                Quantity = computer.Quantity,
                RelevanceScore = 0.7,
                IsAI = false,
                ScoreFactors = new Dictionary<string, double>()
            });
        }
    }
    
    foreach (var component in recommendedComponents)
    {
        if (!allRecommended.Any(r => r.Id == component.Id && r.Type == "Component"))
        {
            allRecommended.Add(new ProductRecommendation
            {
                Id = component.Id,
                Name = component.Name,
                Price = component.Price,
                ImageUrl = component.ImageUrl,
                Type = "Component",
                ComponentType = component.Type,
                Description = component.Description,
                Quantity = component.Quantity,
                RelevanceScore = 0.6,
                IsAI = false,
                ScoreFactors = new Dictionary<string, double>()
            });
        }
    }
    
    // Сортируем по релевантности
    allRecommended = allRecommended
        .OrderByDescending(r => r.IsAI)
        .ThenByDescending(r => r.RelevanceScore)
        .ToList();
    
    // Пагинация
    var pageSize = 4;
    var totalPages = (int)Math.Ceiling((double)allRecommended.Count / pageSize);
    var currentPage = Context.Request.Query.ContainsKey("page") ? 
        int.TryParse(Context.Request.Query["page"], out var page) ? page : 1 : 1;
    currentPage = Math.Max(1, Math.Min(currentPage, totalPages));
    var startIndex = (currentPage - 1) * pageSize;
    var pagedProducts = allRecommended.Skip(startIndex).Take(pageSize).ToList();
}

<!-- Класс для хранения рекомендаций -->
@functions {
    public class ProductRecommendation
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string? ImageUrl { get; set; }
        public string Type { get; set; } = string.Empty; // "Computer" или "Component"
        public string? ComponentType { get; set; }
        public string? Description { get; set; }
        public int Quantity { get; set; }
        public double RelevanceScore { get; set; }
        public bool IsAI { get; set; }
        public Dictionary<string, double> ScoreFactors { get; set; } = new();
    }

    public string GetShortTypeName(string? type)
    {
        return type switch
        {
            "CPU" => "Проц.",
            "GPU" => "Видео",
            "RAM" => "ОЗУ",
            "SSD" => "SSD",
            "HDD" => "HDD",
            "PSU" => "БП",
            "MB" => "Мат. плата",
            "Case" => "Корпус",
            _ => type?.Length > 4 ? type.Substring(0, 4) : type ?? ""
        };
    }

    public string GetComponentIcon(string? type)
    {
        return type switch
        {
            "CPU" => "⚙️",
            "GPU" => "🎮",
            "RAM" => "💾",
            "SSD" => "💿",
            "HDD" => "📀",
            "PSU" => "⚡",
            "MB" => "🔌",
            "Case" => "📦",
            _ => "🔧"
        };
    }
}

<!-- Секция с рекомендованными товарами -->
<div class="mt-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-3xl font-bold text-white mb-2">
                @if (Model != null)
                {
                    @:Похожие товары
                }
                else
                {
                    @:Рекомендуемые товары
                }
            </h2>
            
            <!-- Статистика рекомендаций -->
            <div class="flex items-center space-x-4 text-sm text-gray-400">
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-primary rounded-full mr-2"></span>
                    <span>AI-подбор</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                    <span>Аналогичные</span>
                </div>
                <div class="flex items-center">
                    <svg class="w-4 h-4 text-yellow-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span>На основе ваших интересов</span>
                </div>
            </div>
        </div>
        
        <!-- Фильтры и сортировка -->
        <div class="flex items-center space-x-4">
            <div class="relative">
                <select id="recommendedFilter" class="bg-dark border border-gray-700 rounded-lg px-4 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary transition duration-200 appearance-none pr-10">
                    <option value="all">Все товары</option>
                    <option value="ai">AI-рекомендации</option>
                    <option value="computers">Компьютеры</option>
                    <option value="components">Комплектующие</option>
                </select>
                <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
            
            <div class="relative">
                <select id="recommendedSort" class="bg-dark border border-gray-700 rounded-lg px-4 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary transition duration-200 appearance-none pr-10">
                    <option value="relevance">По релевантности</option>
                    <option value="price_asc">По возрастанию цены</option>
                    <option value="price_desc">По убыванию цены</option>
                    <option value="new">Новинки</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Сетка рекомендованных товаров -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" id="recommendedProductsGrid">
        @if (pagedProducts.Any())
        {
            @foreach (var product in pagedProducts)
            {
                var isComputer = product.Type == "Computer";
                var isAI = product.IsAI;
                var productId = product.Id;
                var productName = product.Name;
                var productPrice = product.Price;
                var productImage = product.ImageUrl;
                var productDescription = product.Description;
                var productQuantity = product.Quantity;
                var productComponentType = product.ComponentType;
                var relevanceScore = product.RelevanceScore;
                var scoreFactors = product.ScoreFactors;
                
                <div class="bg-dark-card rounded-xl border border-gray-800 overflow-hidden hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 product-card flex flex-col h-full relative"
                     data-product-type="@(isComputer ? "computer" : "component")"
                     data-product-id="@productId"
                     data-relevance="@relevanceScore"
                     data-price="@productPrice"
                     data-is-ai="@isAI.ToString().ToLower()">
                    
                    <!-- AI бейдж -->
                    @if (isAI)
                    {
                        <div class="absolute top-2 left-2 z-20">
                            <span class="bg-gradient-to-r from-primary to-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full flex items-center">
                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                                </svg>
                                AI
                            </span>
                        </div>
                    }
                    
                    <!-- Изображение товара -->
                    <div class="relative h-40 overflow-hidden flex-shrink-0">
                        @if (!string.IsNullOrEmpty(productImage))
                        {
                            <img src="/Images/@(isComputer ? "computers" : "components")/@productImage" 
                                 alt="@productName"
                                 class="w-full h-full object-cover transform hover:scale-105 transition duration-500">
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center @(isComputer ? "bg-gradient-to-br from-primary/20 to-primary/10" : "bg-gradient-to-br from-blue-500/20 to-blue-500/10")">
                                <span class="text-4xl">
                                    @if (isComputer)
                                    {
                                        @:🖥️
                                    }
                                    else
                                    {
                                        @GetComponentIcon(productComponentType)
                                    }
                                </span>
                            </div>
                        }
                        
                        <!-- Бейдж типа товара -->
                        <div class="absolute @(isAI ? "top-10" : "top-2") left-2">
                            <span class="@(isComputer ? "bg-primary/20 text-primary" : "bg-blue-500/20 text-blue-400") text-xs font-bold px-2 py-1 rounded-full">
                                @if (isComputer)
                                {
                                    @:ПК
                                }
                                else
                                {
                                    @GetShortTypeName(productComponentType)
                                }
                            </span>
                        </div>
                        
                        <!-- Бейдж наличия -->
                        <div class="absolute top-2 right-2 @(productQuantity > 0 ? "bg-green-500/20 text-green-400" : "bg-red-500/20 text-red-400") text-xs font-bold px-2 py-1 rounded-full">
                            @if (productQuantity > 10)
                            {
                                <span>✓ В наличии</span>
                            }
                            else if (productQuantity > 0)
                            {
                                <span>Осталось: @productQuantity</span>
                            }
                            else
                            {
                                <span>Нет в наличии</span>
                            }
                        </div>
                        
                        <!-- Бейдж релевантности -->
                        @if (relevanceScore > 0.8)
                        {
                            <div class="absolute bottom-2 right-2">
                                <div class="flex items-center bg-yellow-500/20 text-yellow-400 text-xs font-bold px-2 py-1 rounded-full">
                                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                    <span>@((relevanceScore * 100).ToString("F0"))%</span>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <!-- Информация о товаре -->
                    <div class="p-4 flex-grow flex flex-col">
                        <h3 class="text-base font-bold text-white mb-2 line-clamp-1 hover:text-primary transition duration-200">
                            @if (isComputer)
                            {
                                <a asp-controller="Home" asp-action="ComputerDetails" asp-route-id="@productId" class="hover:text-primary">@productName</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="ComponentDetails" asp-route-id="@productId" class="hover:text-primary">@productName</a>
                            }
                        </h3>
                        
                        @if (!string.IsNullOrEmpty(productDescription))
                        {
                            <p class="text-gray-400 text-xs mb-3 line-clamp-2 flex-grow">@productDescription</p>
                        }
                        else
                        {
                            <div class="flex-grow"></div>
                        }
                        
                        <!-- Показатели релевантности (только для AI) -->
                        @if (isAI && scoreFactors.Any())
                        {
                            <div class="mb-3">
                                <div class="text-xs text-gray-500 mb-1">Показатели подбора:</div>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var factor in scoreFactors.Take(3))
                                    {
                                        <span class="text-xs px-2 py-1 bg-gray-800 rounded">
                                            @factor.Key: @(factor.Value.ToString("P0"))
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        
                        <div class="mt-auto">
                            <div class="flex items-center justify-between mb-2">
                                <div class="text-lg font-bold text-primary">@productPrice.ToString("C")</div>
                                @if (isComputer && Model != null)
                                {
                                    <div class="text-xs text-gray-400">
                                        @{
                                            var priceDiff = productPrice - Model.Price;
                                            if (Math.Abs(priceDiff) > 0.01m)
                                            {
                                                if (priceDiff > 0)
                                                {
                                                    <span class="text-red-400">+@priceDiff.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-green-400">@priceDiff.ToString("C")</span>
                                                }
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            
                            <!-- Действия -->
                            <div class="flex space-x-2">
                                @if (productQuantity > 0)
                                {
                                    <button class="w-full bg-primary/10 text-primary hover:bg-primary hover:text-dark px-3 py-2 rounded-lg font-semibold text-sm transition duration-200 flex items-center justify-center add-to-cart-btn"
                                            data-product-id="@productId"
                                            data-product-type="@(isComputer ? "computer" : "component")"
                                            data-product-name="@productName">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                                        </svg>
                                        В корзину
                                    </button>
                                }
                                else
                                {
                                    <span class="w-full bg-gray-800 text-gray-500 px-3 py-2 rounded-lg font-semibold text-sm text-center cursor-not-allowed block">
                                        Нет в наличии
                                    </span>
                                }
                                
                                <!-- Кнопка сравнения -->
                                <button class="bg-gray-800 text-gray-400 hover:text-white hover:bg-gray-700 px-3 py-2 rounded-lg transition duration-200 compare-btn"
                                        data-product-id="@productId"
                                        data-product-type="@(isComputer ? "Computer" : "Component")">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-4 text-center py-12">
                <svg class="w-16 h-16 text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-gray-400 text-lg mb-4">Рекомендуемые товары отсутствуют</p>
                <button id="refreshRecommendations" class="px-6 py-2 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-dark transition duration-200">
                    Обновить рекомендации
                </button>
            </div>
        }
    </div>

    <!-- Пагинация -->
    @if (totalPages > 1)
    {
        <div class="flex justify-center items-center space-x-2">
            @if (currentPage > 1)
            {
                <a href="?page=@(currentPage - 1)#recommendations" 
                   class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition duration-200">
                    ← Назад
                </a>
            }
            
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="px-4 py-2 bg-primary text-white rounded-lg">@i</span>
                }
                else if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                {
                    <a href="?page=@i#recommendations" 
                       class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition duration-200">@i</a>
                }
                else if (i == currentPage - 2 || i == currentPage + 2)
                {
                    <span class="px-2 text-gray-500">...</span>
                }
            }
            
            @if (currentPage < totalPages)
            {
                <a href="?page=@(currentPage + 1)#recommendations" 
                   class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition duration-200">
                    Далее →
                </a>
            }
            
            <!-- Кнопка для получения больше рекомендаций -->
            @if (allRecommended.Count < 20)
            {
                <button id="loadMoreRecommendations" 
                        class="ml-4 px-6 py-2 bg-primary/20 text-primary rounded-lg hover:bg-primary hover:text-dark transition duration-200">
                    Показать больше
                </button>
            }
        </div>
    }
</div>

<!-- JavaScript для работы с рекомендациями -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // Фильтрация рекомендаций
            $('#recommendedFilter').change(function() {
                filterRecommendations();
            });
            
            // Сортировка рекомендаций
            $('#recommendedSort').change(function() {
                sortRecommendations();
            });
            
            // Обновление рекомендаций
            $('#refreshRecommendations').click(function() {
                refreshRecommendations();
            });
            
            // Загрузка больше рекомендаций
            $('#loadMoreRecommendations').click(function() {
                loadMoreRecommendations();
            });
            
            // Трекинг просмотра рекомендаций
            trackRecommendationViews();
        });
        
        function filterRecommendations() {
            const filterValue = $('#recommendedFilter').val();
            const cards = $('.product-card');
            
            cards.hide();
            
            if (filterValue === 'all') {
                cards.show();
            } else if (filterValue === 'ai') {
                cards.filter('[data-is-ai="true"]').show();
            } else if (filterValue === 'computers') {
                cards.filter('[data-product-type="computer"]').show();
            } else if (filterValue === 'components') {
                cards.filter('[data-product-type="component"]').show();
            }
            
            // Показываем сообщение, если ничего не найдено
            const visibleCards = cards.filter(':visible');
            if (visibleCards.length === 0) {
                $('#recommendedProductsGrid').append(`
                    <div class="col-span-4 text-center py-12">
                        <p class="text-gray-400 text-lg">По выбранному фильтру товары не найдены</p>
                    </div>
                `);
            }
        }
        
        function sortRecommendations() {
            const sortValue = $('#recommendedSort').val();
            const container = $('#recommendedProductsGrid');
            const cards = container.children('.product-card').toArray();
            
            cards.sort(function(a, b) {
                const aEl = $(a);
                const bEl = $(b);
                
                switch (sortValue) {
                    case 'price_asc':
                        return parseFloat(aEl.data('price')) - parseFloat(bEl.data('price'));
                    case 'price_desc':
                        return parseFloat(bEl.data('price')) - parseFloat(aEl.data('price'));
                    case 'new':
                        // Сортируем по ID (предполагаем, что новые имеют больший ID)
                        return bEl.data('product-id') - aEl.data('product-id');
                    case 'relevance':
                    default:
                        return parseFloat(bEl.data('relevance')) - parseFloat(aEl.data('relevance'));
                }
            });
            
            // Переставляем карточки
            container.empty().append(cards);
        }
        
        function refreshRecommendations() {
            $.ajax({
                url: '@Url.Action("QuickView", "Recommendation")',
                type: 'GET',
                data: {
                    type: '@(Model != null ? "similar" : "popular")',
                    productId: '@Model?.Id',
                    productType: 'Computer'
                },
                success: function(data) {
                    if (data && data.success) {
                        // Обновляем сетку рекомендаций
                        updateRecommendationsGrid(data.recommendations);
                    }
                },
                error: function() {
                    showNotification('Ошибка при обновлении рекомендаций', 'error');
                }
            });
        }
        
        function loadMoreRecommendations() {
            $.ajax({
                url: '@Url.Action("Sidebar", "Recommendation")',
                type: 'GET',
                data: {
                    productId: '@Model?.Id',
                    productType: 'Computer',
                    limit: 8
                },
                success: function(data) {
                    if (data) {
                        $('#recommendedProductsGrid').append(data);
                        initRecommendationCards();
                    }
                },
                error: function() {
                    showNotification('Ошибка при загрузке рекомендаций', 'error');
                }
            });
        }
        
        function trackRecommendationViews() {
            const viewedIds = [];
            $('.product-card').each(function() {
                const productId = $(this).data('product-id');
                const productType = $(this).data('product-type');
                viewedIds.push({ id: productId, type: productType });
            });
            
            // Отправляем данные на сервер (опционально)
            if (viewedIds.length > 0) {
                $.ajax({
                    url: '@Url.Action("TrackViews", "Recommendation")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ products: viewedIds }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });
            }
        }
        
        function updateRecommendationsGrid(recommendations) {
            const grid = $('#recommendedProductsGrid');
            grid.empty();
            
            if (recommendations && recommendations.length > 0) {
                // Здесь нужно реализовать логику создания карточек из данных
                // Для простоты показываем сообщение
                grid.html(`
                    <div class="col-span-4 text-center py-12">
                        <p class="text-gray-400 text-lg">Рекомендации обновлены</p>
                    </div>
                `);
                
                // Перезагружаем страницу через 1 секунду
                setTimeout(() => {
                    location.reload();
                }, 1000);
            } else {
                grid.html(`
                    <div class="col-span-4 text-center py-12">
                        <p class="text-gray-400 text-lg">Рекомендации временно недоступны</p>
                    </div>
                `);
            }
        }
        
        // Инициализация обработчиков (уже есть в основном коде)
    </script>
}