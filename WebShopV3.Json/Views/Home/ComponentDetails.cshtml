@model WebShopV3.Json.Models.Component
@using WebShopV3.Json.Models

@{
    ViewData["Title"] = Model.Name;
    
    // Получаем данные из ViewBag
    var relatedComponents = ViewBag.RelatedComponents as List<Component> ?? new List<Component>();
    var characteristics = ViewBag.ComponentCharacteristics as List<ComponentCharacteristic> ?? new List<ComponentCharacteristic>();

    // Определяем цвет для типа компонента
    var typeBadgeClass = Model.Type switch
    {
        "CPU" => "bg-blue-600",
        "GPU" => "bg-purple-600",
        "RAM" => "bg-green-600",
        "SSD" => "bg-yellow-600",
        "HDD" => "bg-yellow-700",
        "MB" => "bg-red-600",
        "PSU" => "bg-gray-600",
        "CASE" => "bg-indigo-600",
        "COOLER" => "bg-cyan-600",
        "MONITOR" => "bg-pink-600",
        _ => "bg-gray-600"
    };

    var typeName = Model.Type switch
    {
        "CPU" => "Процессор",
        "GPU" => "Видеокарта",
        "RAM" => "Оперативная память",
        "SSD" => "SSD накопитель",
        "HDD" => "Жесткий диск",
        "MB" => "Материнская плата",
        "PSU" => "Блок питания",
        "CASE" => "Корпус",
        "COOLER" => "Система охлаждения",
        "MONITOR" => "Монитор",
        _ => "Комплектующее"
    };
}

<div class="min-h-screen bg-gradient-to-b from-gray-900 to-black pt-6 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Хлебные крошки -->
        <nav class="flex mb-8" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a asp-action="Index" asp-controller="Home" class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-green-400 transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                        </svg>
                        Главная
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <a asp-action="Catalog" asp-controller="Home" asp-route-productType="components" class="ml-1 text-sm font-medium text-gray-400 hover:text-green-400 transition-colors md:ml-2">Комплектующие</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">@Model.Name</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Левая колонка: Изображение -->
            <div class="space-y-6">
                <!-- Изображение товара -->
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800">
                    <div class="aspect-square rounded-xl overflow-hidden bg-dark-card flex items-center justify-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="/Images/components/@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-contain p-4" />
                        }
                        else
                        {
                            <div class="text-gray-500 text-center p-8">
                                <svg class="w-32 h-32 mx-auto text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <p class="mt-4">Изображение отсутствует</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Статус наличия -->
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            @if (Model.Quantity > 0)
                            {
                                <div class="w-3 h-3 rounded-full bg-green-500 mr-3"></div>
                                <span class="text-green-400 text-lg font-medium">В наличии: @Model.Quantity шт.</span>
                            }
                            else
                            {
                                <div class="w-3 h-3 rounded-full bg-red-500 mr-3"></div>
                                <span class="text-red-400 text-lg font-medium">Нет в наличии</span>
                            }
                        </div>
                        <span class="px-3 py-1 @typeBadgeClass text-white text-sm font-medium rounded-full">
                            @typeName
                        </span>
                    </div>
                    
                    <!-- Быстрая доставка -->
                    <div class="mt-6 pt-6 border-t border-gray-800">
                        <div class="flex items-center text-gray-400">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-medium">Быстрая доставка:</span>
                            <span class="ml-2 text-gray-300">1-3 рабочих дня</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Правая колонка: Основная информация и кнопки -->
            <div class="space-y-6">
                <!-- Заголовок и цена -->
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800">
                    <div class="flex justify-between items-start mb-4">
                        <h1 class="text-3xl font-bold text-white">@Model.Name</h1>
                    </div>
                    
                    <div class="flex items-center mb-6">
                        <div class="text-4xl font-bold text-white">@Model.Price.ToString("N0") ₽</div>
                    </div>

                    <!-- Ключевые характеристики -->
                    <div class="mb-6">
                        <h3 class="text-lg font-bold text-white mb-3">Ключевые характеристики:</h3>
                        <ul class="space-y-2">
                            @if (!string.IsNullOrEmpty(Model.Socket))
                            {
                                <li class="flex items-center text-gray-300">
                                    <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>Сокет: <span class="font-medium text-white">@Model.Socket</span></span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.MemoryType))
                            {
                                <li class="flex items-center text-gray-300">
                                    <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>Тип памяти: <span class="font-medium text-white">@Model.MemoryType</span></span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.FormFactor))
                            {
                                <li class="flex items-center text-gray-300">
                                    <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>Форм-фактор: <span class="font-medium text-white">@Model.FormFactor</span></span>
                                </li>
                            }
                            @if (Model.Quantity > 0)
                            {
                                <li class="flex items-center text-gray-300">
                                    <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>В наличии: <span class="font-medium text-white">@Model.Quantity шт.</span></span>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Кнопки действий -->
                    <div class="space-y-4">
                        <!-- Счетчик количества -->
                        @*<div class="flex items-center justify-between bg-gray-900/50 rounded-xl p-4 border border-gray-800">
                            <span class="text-gray-300">Количество:</span>
                            <div class="flex items-center space-x-3">
                                <button class="w-8 h-8 rounded-lg bg-gray-800 text-white flex items-center justify-center hover:bg-gray-700 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                    </svg>
                                </button>
                                <span class="text-xl font-bold text-white">1</span>
                                <button class="w-8 h-8 rounded-lg bg-gray-800 text-white flex items-center justify-center hover:bg-gray-700 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        *@
                        <!-- Основные кнопки -->
                        <div class="grid grid-cols-2 gap-4">
                            <a href="@Url.Action("AddToCart", "Cart", new { componentId = @Model.Id, quantity = 1 })" class="w-full bg-gradient-to-r from-primary to-green-400 text-dark py-4 rounded-lg font-bold text-lg hover:shadow-lg hover:shadow-primary/25 transition duration-300 flex items-center justify-center add-to-cart-details">
                                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                                </svg>
                                Добавить в корзину
                            </a>
                            
                            <button class="bg-gray-800 hover:bg-gray-700 text-white font-medium py-4 px-6 rounded-xl transition-colors flex items-center justify-center border border-gray-700">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                </svg>
                                В избранное
                            </button>
                        </div>

                        <!-- Кнопка назад -->
                        <a asp-action="Catalog" asp-controller="Home" asp-route-productType="components"
                           class="inline-flex items-center text-gray-400 hover:text-gray-300 transition-colors">
                            <svg class="w-4 h-4 mr-2 transform rotate-180" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                            Назад
                        </a>
                    </div>
                </div>

                <!-- Описание -->
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800">
                    <h2 class="text-xl font-bold text-white mb-4">Описание</h2>
                    <div class="text-gray-300 whitespace-pre-line">@Model.Description</div>
                    
                    @if (!string.IsNullOrEmpty(Model.Specifications))
                    {
                        <div class="mt-6">
                            <h3 class="text-lg font-bold text-white mb-3">Спецификации</h3>
                            <div class="text-gray-300 whitespace-pre-line">@Model.Specifications</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Все характеристики -->
        <div class="mt-8">
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800">
                <h2 class="text-xl font-bold text-white mb-4">Все характеристики</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-3">
                        @if (!string.IsNullOrEmpty(Model.Socket))
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Сокет</span>
                                <span class="text-white font-medium">@Model.Socket</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.MemoryType))
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Тип памяти</span>
                                <span class="text-white font-medium">@Model.MemoryType</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.FormFactor))
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Форм-фактор</span>
                                <span class="text-white font-medium">@Model.FormFactor</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.PowerConnector))
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Разъем питания</span>
                                <span class="text-white font-medium">@Model.PowerConnector</span>
                            </div>
                        }
                    </div>
                    
                    <div class="space-y-3">
                        @if (Model.MaxMemory.HasValue)
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Макс. объем памяти</span>
                                <span class="text-white font-medium">@Model.MaxMemory ГБ</span>
                            </div>
                        }
                        
                        @if (Model.MemorySlots.HasValue)
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">Слоты памяти</span>
                                <span class="text-white font-medium">@Model.MemorySlots</span>
                            </div>
                        }
                        
                        <!-- Дополнительные характеристики из ComponentCharacteristics -->
                        @foreach (var characteristic in characteristics)
                        {
                            <div class="flex justify-between py-3 border-b border-gray-800">
                                <span class="text-gray-400">@characteristic.Characteristic?.Name</span>
                                <span class="text-white font-medium">
                                    @characteristic.Value
                                    @if (!string.IsNullOrEmpty(characteristic.Characteristic?.Unit))
                                    {
                                        @characteristic.Characteristic.Unit
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Похожие товары -->
        @if (relatedComponents.Any())
        {
            <div class="mt-12">
                <h2 class="text-2xl font-bold text-white mb-6">Похожие товары</h2>
        
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    @foreach (var component in relatedComponents)
                    {
                        <a asp-action="ComponentDetails" asp-controller="Home" asp-route-id="@component.Id" 
                           class="bg-dark rounded-2xl overflow-hidden border border-gray-800 hover:border-green-800 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-green-900/20 group">
                    
                            <!-- Верхняя часть с изображением -->
                            <div class="relative h-48 bg-gradient-to-br from-gray-900 to-gray-800 overflow-hidden">
                                @if (!string.IsNullOrEmpty(component.ImageUrl))
                                {
                                    <img src="/Images/components/@component.ImageUrl" 
                                         alt="@component.Name" 
                                         class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-105" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <div class="text-center p-4">
                                            <svg class="w-16 h-16 mx-auto text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                }
                        
                                <!-- Бейдж типа в левом верхнем углу -->
                                <div class="absolute top-3 left-3">
                                    @{
                                        var relatedTypeBadgeClass = component.Type switch
                                        {
                                            "CPU" => "bg-gradient-to-r from-blue-600 to-blue-500",
                                            "GPU" => "bg-gradient-to-r from-purple-600 to-purple-500",
                                            "RAM" => "bg-gradient-to-r from-green-600 to-green-500",
                                            "SSD" => "bg-gradient-to-r from-yellow-600 to-yellow-500",
                                            "HDD" => "bg-gradient-to-r from-yellow-700 to-yellow-600",
                                            "MB" => "bg-gradient-to-r from-red-600 to-red-500",
                                            "PSU" => "bg-gradient-to-r from-gray-600 to-gray-500",
                                            "CASE" => "bg-gradient-to-r from-indigo-600 to-indigo-500",
                                            "COOLER" => "bg-gradient-to-r from-cyan-600 to-cyan-500",
                                            _ => "bg-gradient-to-r from-gray-600 to-gray-500"
                                        };
                                    }
                                    <span class="px-3 py-1 text-xs font-bold rounded-lg @relatedTypeBadgeClass text-white shadow-lg">
                                        @component.Type
                                    </span>
                                </div>
                        
                                <!-- Бейдж количества в правом верхнем углу -->
                                @if (component.Quantity < 10 && component.Quantity > 0)
                                {
                                    <div class="absolute top-3 right-3">
                                        <span class="px-2 py-1 text-xs rounded-lg bg-gradient-to-r from-red-600 to-red-500 text-white font-bold shadow-lg">
                                            Осталось: @component.Quantity
                                        </span>
                                    </div>
                                }
                        
                                <!-- Наложение при наведении -->
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
                                    <span class="text-white text-sm font-medium px-3 py-1 bg-black/50 rounded-full backdrop-blur-sm">
                                        Подробнее
                                    </span>
                                </div>
                            </div>
                    
                            <!-- Нижняя часть с информацией -->
                            <div class="p-5">
                                <!-- Название товара -->
                                <h3 class="text-lg font-bold text-white mb-2 line-clamp-2 h-12 group-hover:text-green-400 transition-colors" title="@component.Name">
                                    @component.Name
                                </h3>
                        
                                <!-- Цена -->
                                <div class="mb-4">
                                    <div class="text-2xl font-bold text-white">@component.Price.ToString("N0") ₽</div>
                                    <div class="text-sm text-gray-400 mt-1">за шт.</div>
                                </div>
                        
                                <!-- Статус и кнопка -->
                                <div class="pt-4 border-t border-gray-800">
                                    <div class="flex items-center justify-between mb-3">
                                        @if (component.Quantity > 0)
                                        {
                                            <div class="flex items-center">
                                                <div class="w-2 h-2 rounded-full bg-green-500 mr-2 animate-pulse"></div>
                                                <span class="text-green-400 text-sm font-medium">В наличии</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center">
                                                <div class="w-2 h-2 rounded-full bg-red-500 mr-2"></div>
                                                <span class="text-red-400 text-sm font-medium">Нет в наличии</span>
                                            </div>
                                        }
                                    </div>
                            
                                    @if (component.Quantity > 0)
                                    {
                                        <button class="w-full bg-gradient-to-r from-primary to-green-400 text-dark py-4 rounded-lg font-bold text-lg hover:shadow-lg hover:shadow-primary/25 transition duration-300 flex items-center justify-center addToCart"
                                                data-component-id="@Model.Id"
                                                data-component-name="@Model.Name">
                                            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                            Добавить в корзину
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="w-full bg-gray-800 text-gray-400 py-3 rounded-xl font-bold text-sm cursor-not-allowed"
                                                disabled>
                                            Нет в наличии
                                        </button>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }

        @{
            var recentlyViewed = ViewBag.RecentlyViewed as List<Component>;
            var recommendedComputers = ViewBag.RecommendedComputers as List<Computer>;
            var recommendedComponents = ViewBag.RecommendedComponents as List<Component>;
        }

        @if (recentlyViewed != null && recentlyViewed.Any())
        {
            @await Html.PartialAsync("_RecentlyViewed", recentlyViewed)
        }
    </div>
</div>

@section Scripts {
<script>
function addToCart(id, name, price, type) {
    fetch('/Cart/AddToCart', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify({
            productId: id,
            productName: name,
            price: price,
            productType: type,
            quantity: 1
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Обновляем счетчик корзины
            if (data.totalItems !== undefined) {
                updateCartCount(data.totalItems);
            }
            
            // Показываем уведомление
            showNotification('Товар добавлен в корзину', 'success');
        } else {
            showNotification(data.message || 'Ошибка при добавлении в корзину', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('Ошибка при добавлении в корзину', 'error');
    });
}

function updateCartCount(count) {
    const cartBadge = document.querySelector('[data-cart-count]');
    if (cartBadge) {
        cartBadge.textContent = count;
        cartBadge.classList.remove('hidden');
    }
}

function showNotification(message, type = 'info') {
    // Создаем элемент уведомления
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-xl shadow-lg text-white transition-transform transform translate-x-full ${
        type === 'success' ? 'bg-green-600' : 'bg-red-600'
    }`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    // Показываем уведомление
    setTimeout(() => {
        notification.classList.remove('translate-x-full');
        notification.classList.add('translate-x-0');
    }, 10);
    
    // Убираем уведомление через 3 секунды
    setTimeout(() => {
        notification.classList.remove('translate-x-0');
        notification.classList.add('translate-x-full');
        setTimeout(() => {
            document.body.removeChild(notification);
        }, 300);
    }, 3000);
}
</script>


<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.5;
    }
}
</style>
}