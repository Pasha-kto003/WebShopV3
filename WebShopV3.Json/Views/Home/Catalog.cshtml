@model WebShopV3.Json.Models.CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
}
<style>
     /* Стили для верхней пагинации */
    #topPaginationContainer {
        transition: all 0.3s ease;
    }
    
    .page-btn {
        min-width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(71, 85, 105, 0.3);
        border-radius: 8px;
        color: #94a3b8;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .page-btn:hover:not(.active) {
        background-color: rgba(30, 41, 59, 0.8);
        border-color: #3b82f6;
        color: #fff;
        transform: translateY(-1px);
    }
    
    .page-btn.active {
        background: linear-gradient(135deg, #3b82f6, #10b981);
        border-color: transparent;
        color: #0f172a;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    
    .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background-color: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(71, 85, 105, 0.3);
        border-radius: 8px;
        color: #94a3b8;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .nav-btn:hover:not(:disabled) {
        background-color: rgba(30, 41, 59, 0.8);
        border-color: #3b82f6;
        color: #fff;
        transform: translateY(-1px);
    }
    
    .nav-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .nav-btn.prev:hover:not(:disabled) {
        box-shadow: -2px 0 8px rgba(59, 130, 246, 0.2);
    }
    
    .nav-btn.next:hover:not(:disabled) {
        box-shadow: 2px 0 8px rgba(59, 130, 246, 0.2);
    }
    
    .page-size-select {
        min-width: 80px;
    }
    
    .page-size-select:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
    
    /* Анимация при переключении страниц */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    #topPaginationContainer > div {
        animation: slideIn 0.3s ease-out;
    }
    
    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-btn {
            min-width: 32px;
            height: 32px;
            font-size: 0.75rem;
        }
        
        .nav-btn {
            padding: 6px 12px;
            font-size: 0.75rem;
        }
        
        .nav-btn span {
            display: none;
        }
        
        .nav-btn svg {
            width: 16px;
            height: 16px;
        }
    }
</style>
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-black pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a asp-controller="Home" asp-action="Index"
                       class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-white transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                        </svg>
                        Главная
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Каталог</span>
                    </div>
                </li>
            </ol>
        </nav>
        <!-- Заголовок и управление -->
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-8">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Каталог товаров</h1>
                <p class="text-gray-400" id="resultsCount">
                    Найдено @Model.TotalCount товаров
                    (@Model.Computers.Count компьютеров, @Model.Components.Count() комплектующих)
                </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 mt-4 lg:mt-0">
                <!-- Переключение типа товаров -->
                <div class="flex bg-dark-card rounded-lg p-1 border border-gray-800">
                    <button data-product-type="all"
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "all" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Все
                    </button>
                    <button data-product-type="computers"
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "computers" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Компьютеры
                    </button>
                    <button data-product-type="components"
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "components" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Комплектующие
                    </button>
                </div>

                <!-- Переключение вида -->
                <div class="flex bg-dark-card rounded-lg p-1 border border-gray-800">
                    <button id="cardViewBtn" class="p-2 rounded-md transition duration-200 @(ViewBag.ViewMode != "list" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </button>
                    <button id="listViewBtn" class="p-2 rounded-md transition duration-200 @(ViewBag.ViewMode == "list" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                        </svg>
                    </button>
                </div>

                <!-- Сортировка -->
                <select id="sortSelect" class="bg-dark-card border border-gray-800 rounded-lg px-4 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary"
                        data-sort-by="@ViewBag.SortBy">
                    <option value="default">По умолчанию</option>
                    <option value="price_asc">Цена по возрастанию</option>
                    <option value="price_desc">Цена по убыванию</option>
                    <option value="name_asc">Название А-Я</option>
                    <option value="name_desc">Название Я-А</option>
                    <option value="newest">Сначала новые</option>
                </select>
            </div>
        </div>
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Боковая панель с фильтрами -->
            <div class="lg:w-1/4">
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 mb-6">
                    <h3 class="text-lg font-bold text-white mb-4">Фильтры</h3>

                    <!-- Поиск -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Поиск</label>
                        <input type="text" id="searchInput"
                               class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary"
                               placeholder="Введите название..."
                               value="@ViewBag.SearchQuery">
                    </div>

                    <!-- Тип комплектующих -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Тип комплектующих</label>
                        <select id="componentTypeFilter" class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary"
                                data-component-type="@ViewBag.ComponentType">
                            <option value="all">Все типы</option>
                            @foreach (var type in ViewBag.ComponentTypes)
                            {
                                <option value="@type" selected="@(ViewBag.ComponentType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <!-- Цена -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Цена</label>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="number" id="minPrice"
                                   class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary"
                                   placeholder="От"
                                   value="@ViewBag.MinPrice">
                            <input type="number" id="maxPrice"
                                   class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary"
                                   placeholder="До"
                                   value="@ViewBag.MaxPrice">
                        </div>
                    </div>

                    <!-- Кнопка сброса -->
                    <button type="button" id="resetFilters"
                            class="w-full border-2 border-gray-600 text-gray-400 px-4 py-2 rounded-lg font-semibold hover:border-gray-500 hover:text-white transition duration-300">
                        Сбросить фильтры
                    </button>
                </div>
            </div>

            <!-- Основной контент -->
            <div class="lg:w-3/4">
                <!-- Результаты поиска -->
                <div id="productList">
                    @await Html.PartialAsync("_ComputerListPartial", Model)
                </div>
                <div id="loadingIndicator" class="text-center hidden">
                    <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
                    <p class="mt-2 text-gray-400">Поиск товаров...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="currentProductType" value="@ViewBag.ProductType" />

@await Html.PartialAsync("_CatalogScriptsPartial")
@await Html.PartialAsync("_CompareScriptsPartial")