@* Views/Statistics/Dashboard.cshtml *@
@model WebShopV3.Json.Models.Statistics.SalesStatistics
@{
    ViewData["Title"] = "Панель статистики";
    var financialSummary = ViewBag.FinancialSummary as WebShopV3.Json.Models.Statistics.FinancialSummary;
    var monthlySales = ViewBag.MonthlySales as List<WebShopV3.Json.Models.Statistics.MonthlySales>;
}

<div class="min-h-screen bg-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Хлебные крошки -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a asp-controller="Home" asp-action="Index"
                       class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-white transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                        </svg>
                        Главная
                    </a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Панель статистики</span>
                    </div>
                </li>
            </ol>
        </nav>

        <!-- Заголовок -->
        <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-8">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">
                    Панель статистики
                </h1>
                <p class="text-xl text-gray-400">
                    Аналитика продаж и финансовых показателей
                </p>
            </div>
            <div class="mt-4 md:mt-0">
                <a href="@Url.Action("GenerateReport", new { period = "month" })"
                   class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-emerald-500/30 transition-all duration-300">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Экспорт отчёта
                </a>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-500/20 border border-red-500/30 rounded-lg p-4 mb-6">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-red-400">@TempData["ErrorMessage"]</span>
                </div>
            </div>
        }

        <!-- Финансовый статус -->
        <div class="mb-8">
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                <div class="flex flex-col md:flex-row items-start md:items-center">
                    <div class="flex-1 mb-4 md:mb-0">
                        <div class="text-sm font-semibold text-gray-300 uppercase mb-1">
                            Финансовый статус магазина
                        </div>
                        <div class="flex items-center flex-wrap gap-2">
                            <div class="text-2xl font-bold text-white">
                                @(financialSummary?.IsProfitable == true ? "Прибыльный" : "Убыточный")
                            </div>
                            <span class="px-3 py-1 rounded-full text-sm font-bold
                                @(financialSummary?.IsProfitable == true ? "bg-green-900/30 text-green-400" : "bg-red-900/30 text-red-400")">
                                @(financialSummary?.TotalProfit.ToString("N0") ?? "0") ₽
                            </span>
                        </div>
                        @if (financialSummary != null)
                        {
                            <div class="mt-3 flex items-center">
                                <span class="text-@(financialSummary.RevenueChangePercent >= 0 ? "green-400" : "red-400") flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="@(financialSummary.RevenueChangePercent >= 0 ? "M5 15l7-7 7 7" : "M19 9l-7 7-7-7")" />
                                    </svg>
                                    @Math.Abs(financialSummary.RevenueChangePercent).ToString("F1")%
                                </span>
                                <span class="text-gray-400 ml-2">изменение выручки за месяц</span>
                            </div>
                        }
                    </div>
                    <div class="text-gray-500">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Основные метрики -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Выручка -->
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-primary uppercase mb-1">
                            Выручка
                        </div>
                        <div class="text-2xl font-bold text-white">
                            @Model.TotalRevenue.ToString("N0") ₽
                        </div>
                        <div class="text-sm text-gray-400 mt-1">
                            за @Model.PeriodStart.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
                        </div>
                    </div>
                    <div class="text-gray-500">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Заказы -->
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-green-400 uppercase mb-1">
                            Заказы
                        </div>
                        <div class="text-2xl font-bold text-white">
                            @Model.TotalOrders
                        </div>
                        @if (Model.OrdersChangePercent != 0)
                        {
                            <div class="text-sm mt-1">
                                <span class="text-@(Model.OrdersChangePercent > 0 ? "green-400" : "red-400")">
                                    @Model.OrdersChangePercent:+#;-#;0% к прошлому периоду
                                </span>
                            </div>
                        }
                    </div>
                    <div class="text-gray-500">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Прибыль -->
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-@(Model.IsProfitable ? "blue-400" : "yellow-400") uppercase mb-1">
                            Прибыль
                        </div>
                        <div class="text-2xl font-bold text-white">
                            @Model.Profit.ToString("N0") ₽
                        </div>
                        <div class="text-sm text-gray-400 mt-1">
                            Рентабельность: @Model.ProfitMargin.ToString("F1")%
                        </div>
                    </div>
                    <div class="text-gray-500">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Средний чек -->
            <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-purple-400 uppercase mb-1">
                            Средний чек
                        </div>
                        <div class="text-2xl font-bold text-white">
                            @Model.AverageOrderValue.ToString("N0") ₽
                        </div>
                    </div>
                    <div class="text-gray-500">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Графики -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <div class="lg:col-span-2">
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-white">Динамика продаж</h3>
                        <div class="relative">
                            <button class="text-gray-400 hover:text-white transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="h-64">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>

            <div>
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg">
                    <h3 class="text-xl font-bold text-white mb-6">Распределение продаж</h3>
                    <div class="h-64">
                        <canvas id="productsChart"></canvas>
                    </div>
                    <div class="mt-4 text-center text-sm text-gray-400">
                        <div class="flex justify-center space-x-4">
                            <span class="flex items-center">
                                <span class="w-3 h-3 bg-primary rounded-full mr-2"></span>
                                Компьютеры
                            </span>
                            <span class="flex items-center">
                                <span class="w-3 h-3 bg-green-400 rounded-full mr-2"></span>
                                Комплектующие
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Топ товаров -->
        <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 shadow-lg mb-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold text-white">Топ-10 товаров по выручке</h3>
                <a href="@Url.Action("TopProducts")"
                   class="text-primary hover:text-primary/80 transition-colors font-medium">
                    Показать все →
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-700">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">#</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Товар</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Тип</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Продано</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Выручка</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Доля рынка</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var product in Model.TopProducts.Take(10))
                        {
                            <tr class="hover:bg-gray-900/50 transition-colors">
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-300">@product.Rank</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-white">@product.Name</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    @if (product.Type == "Computer")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/20 text-primary">
                                            Компьютер
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-900/30 text-green-400">
                                            @product.ComponentType
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-300">@product.QuantitySold</td>
                                <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-white">@product.Revenue.ToString("N0") ₽</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="w-full bg-gray-700 rounded-full h-2">
                                        <div class="bg-green-500 h-2 rounded-full" style="width: @(Math.Min(product.MarketSharePercent, 100))%"></div>
                                    </div>
                                    <div class="text-xs text-gray-400 mt-1">@product.MarketSharePercent.ToString("F1")%</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Данные для графиков
        var chartData = @Html.Raw(Json.Serialize(ViewBag.ChartData));

        // График выручки
        var revenueCtx = document.getElementById('revenueChart').getContext('2d');
        var revenueChart = new Chart(revenueCtx, {
            type: 'line',
            data: chartData.revenue,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'rgba(30, 41, 59, 0.9)',
                        titleColor: '#fff',
                        bodyColor: '#9ca3af',
                        borderColor: 'rgba(156, 163, 175, 0.2)',
                        borderWidth: 1,
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' +
                                    new Intl.NumberFormat('ru-RU', {
                                        style: 'currency',
                                        currency: 'RUB',
                                        minimumFractionDigits: 0,
                                        maximumFractionDigits: 0
                                    }).format(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: 'rgba(156, 163, 175, 0.1)'
                        },
                        ticks: {
                            color: '#9ca3af'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(156, 163, 175, 0.1)'
                        },
                        ticks: {
                            color: '#9ca3af',
                            callback: function(value) {
                                return value.toLocaleString('ru-RU') + ' ₽';
                            }
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    axis: 'x',
                    intersect: false
                },
                elements: {
                    line: {
                        tension: 0.4,
                        borderWidth: 3
                    },
                    point: {
                        radius: 0,
                        hitRadius: 10
                    }
                }
            }
        });

        // Круговая диаграмма продаж
        var productsCtx = document.getElementById('productsChart').getContext('2d');
        var productsChart = new Chart(productsCtx, {
            type: 'doughnut',
            data: chartData.products,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(30, 41, 59, 0.9)',
                        titleColor: '#fff',
                        bodyColor: '#9ca3af',
                        borderColor: 'rgba(156, 163, 175, 0.2)',
                        borderWidth: 1,
                        padding: 12
                    }
                },
                cutout: '65%'
            }
        });
    </script>
}