@model Component

@{
    // Определяем функцию для клика в зависимости от типа компонента
    string onClickFunction = $"toggleComponent({Model.Id}, '{Model.Type}', '{Model.Name.Replace("'", "\\'")}', {Model.Price}, '{Model.Socket}', '{Model.MemoryType}', '{Model.FormFactor}', '{Model.PowerConnector}')";

    // Получаем цвет в зависимости от типа компонента
    string getColorByType(string type)
    {
        return type switch
        {
            "CPU" => "from-blue-500 to-cyan-500",
            "GPU" => "from-purple-500 to-pink-500",
            "RAM" => "from-green-500 to-emerald-500",
            "SSD" => "from-yellow-500 to-amber-500",
            "HDD" => "from-yellow-600 to-amber-600",
            "MB" => "from-red-500 to-rose-500",
            "PSU" => "from-gray-600 to-gray-700",
            "CASE" => "from-indigo-500 to-violet-500",
            _ => "from-gray-500 to-gray-600"
        };
    }

    string gradientColor = getColorByType(Model.Type);
    string typeIcon = Model.Type switch
    {
        "CPU" => "⚡",
        "GPU" => "🎮",
        "RAM" => "💾",
        "SSD" => "💿",
        "HDD" => "💿",
        "MB" => "🔌",
        "PSU" => "⚡",
        "CASE" => "📦",
        _ => "🛠️"
    };
}

<div class="group relative bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl overflow-hidden border border-gray-700/50 hover:border-gray-600 transition-all duration-300 hover:-translate-y-1 cursor-pointer component-card"
     data-component-id="@Model.Id"
     onclick="@Html.Raw(onClickFunction)">

    <!-- Анимированный фон -->
    <div class="absolute inset-0 bg-gradient-to-r @gradientColor opacity-0 group-hover:opacity-5 transition-opacity duration-500"></div>

    <!-- Изображение компонента -->
    <div class="relative h-40 overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="/Images/components/@Model.ImageUrl"
                 alt="@Model.Name"
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                 loading="lazy">
            <!-- Градиентная полоска внизу изображения -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r @gradientColor"></div>
        }
        else
        {
            <div class="w-full h-full bg-gradient-to-br @gradientColor/20 flex flex-col items-center justify-center">
                <div class="text-4xl mb-2 opacity-50">@typeIcon</div>
                <span class="text-gray-500 text-xs">Изображение отсутствует</span>
            </div>
        }

        <!-- Бейдж типа компонента -->
        <div class="absolute top-3 left-3">
            <span class="px-2 py-1 text-xs font-bold bg-gradient-to-r @gradientColor text-white rounded-full backdrop-blur-sm">
                @Model.Type
            </span>
        </div>

        <!-- Бейдж наличия -->
        <div class="absolute top-3 right-3">
            <span class="px-2 py-1 text-xs font-bold rounded-full @(Model.Quantity > 0 ? "bg-green-500 text-green-100 border border-green-500/30" : "bg-red-500/20 text-red-400 border border-red-500/30")">
                @(Model.Quantity > 0 ? $"{Model.Quantity} шт" : "Нет в наличии")
            </span>
        </div>
    </div>

    <!-- Содержимое карточки -->
    <div class="p-4">
        <!-- Заголовок -->
        <h4 class="text-white font-bold text-sm mb-2 line-clamp-2 group-hover:text-blue-300 transition-colors duration-300"
            title="@Model.Name">
            @Model.Name
        </h4>

        <!-- Краткое описание -->
        <p class="text-gray-400 text-xs mb-3 line-clamp-2">
            @Model.Description
        </p>

        <!-- Характеристики -->
        <div class="space-y-1.5 mb-3">
            @if (!string.IsNullOrEmpty(Model.Socket))
            {
                <div class="flex items-center text-xs">
                    <div class="w-6 h-6 flex items-center justify-center bg-gray-800 rounded mr-2 flex-shrink-0">
                        <span class="text-blue-400">🔌</span>
                    </div>
                    <span class="text-gray-500 flex-1">Сокет:</span>
                    <span class="text-white font-medium">@Model.Socket</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.MemoryType))
            {
                <div class="flex items-center text-xs">
                    <div class="w-6 h-6 flex items-center justify-center bg-gray-800 rounded mr-2 flex-shrink-0">
                        <span class="text-green-400">💾</span>
                    </div>
                    <span class="text-gray-500 flex-1">Память:</span>
                    <span class="text-white font-medium">@Model.MemoryType</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.FormFactor))
            {
                <div class="flex items-center text-xs">
                    <div class="w-6 h-6 flex items-center justify-center bg-gray-800 rounded mr-2 flex-shrink-0">
                        <span class="text-purple-400">📐</span>
                    </div>
                    <span class="text-gray-500 flex-1">Форм-фактор:</span>
                    <span class="text-white font-medium">@Model.FormFactor</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.PowerConnector) && Model.Type == "PSU")
            {
                <div class="flex items-center text-xs">
                    <div class="w-6 h-6 flex items-center justify-center bg-gray-800 rounded mr-2 flex-shrink-0">
                        <span class="text-yellow-400">⚡</span>
                    </div>
                    <span class="text-gray-500 flex-1">Разъемы:</span>
                    <span class="text-white font-medium">@Model.PowerConnector</span>
                </div>
            }
        </div>

        <!-- Цена и кнопка -->
        <div class="flex items-center justify-between pt-3 border-t border-gray-700/50">
            <div>
                <div class="text-lg font-bold bg-gradient-to-r @gradientColor bg-clip-text text-transparent">
                    @Model.Price.ToString("C")
                </div>
                @if (Model.Price < 50000)
                {
                    <div class="text-xs text-gray-500 line-through">
                        @((Model.Price * 1.15m).ToString("C"))
                    </div>
                }
            </div>

            <!-- Кнопка добавления -->
            <button class="group/btn px-4 py-2 bg-gradient-to-r @gradientColor text-white text-sm font-medium rounded-lg hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 transform hover:-translate-y-0.5"
                    onclick="event.stopPropagation(); @Html.Raw(onClickFunction)">
                <div class="flex items-center gap-2">
                    <span class="group-hover/btn:rotate-12 transition-transform duration-300">+</span>
                    <span>Добавить</span>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Стили для карточки -->
<style>
    .component-card {
        transform: perspective(1000px) rotateX(0) rotateY(0);
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .component-card:hover {
            transform: perspective(1000px) rotateX(2deg) rotateY(2deg) translateY(-4px);
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.5), 0 0 30px rgba(59, 130, 246, 0.2);
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Анимация для кнопок */
    button[data-favorite].favorited {
        color: #ef4444;
    }

        button[data-favorite].favorited svg {
            fill: #ef4444;
            stroke: none;
        }
</style>