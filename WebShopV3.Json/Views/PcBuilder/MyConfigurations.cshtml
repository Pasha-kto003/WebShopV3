@model List<Computer>
@{
    ViewData["Title"] = "Мои конфигурации";
}

<div class="min-h-screen bg-gradient-to-b from-gray-900 to-black pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">Мои конфигурации</h1>
            <p class="text-gray-400">Управляйте созданными вами конфигурациями ПК</p>

            <div class="mt-4">
                <a href="@Url.Action("Index", "PcBuilder")"
                   class="inline-flex items-center px-4 py-2 bg-primary text-dark font-medium rounded-lg hover:bg-green-400 transition">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Создать новую конфигурацию
                </a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="bg-gray-800/50 border border-gray-700 rounded-2xl p-8 text-center">
                <div class="text-5xl mb-4">🖥️</div>
                <h3 class="text-xl text-white mb-2">У вас пока нет конфигураций</h3>
                <p class="text-gray-400 mb-6">Создайте свою первую сборку ПК</p>
                <a href="@Url.Action("Index", "PcBuilder")"
                   class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-500 text-white font-medium rounded-lg hover:shadow-lg hover:shadow-green-500/25 transition">
                    Начать сборку
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var computer in Model)
                {
                    <div class="bg-gray-800/30 border border-gray-700 rounded-2xl overflow-hidden hover:border-gray-600 transition-all duration-300">
                        <!-- Изображение -->
                        <div class="h-48 overflow-hidden">
                            @if (!string.IsNullOrEmpty(computer.ImageUrl))
                            {
                                <img src="/Images/computers/@computer.ImageUrl"
                                     alt="@computer.Name"
                                     class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center">
                                    <div class="text-5xl">🖥️</div>
                                </div>
                            }
                        </div>

                        <!-- Содержимое -->
                        <div class="p-5">
                            <h3 class="text-lg font-bold text-white mb-2 truncate">@computer.Name</h3>
                            <p class="text-gray-400 text-sm mb-3 line-clamp-2">@computer.Description</p>

                            <!-- Компоненты -->
                            <div class="mb-4">
                                <div class="text-xs text-gray-500 mb-1">Компоненты:</div>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var component in computer.Components.Take(3))
                                    {
                                        <span class="px-2 py-1 bg-gray-700/50 text-gray-300 text-xs rounded">
                                            @component.Type
                                        </span>
                                    }
                                    @if (computer.Components.Count > 3)
                                    {
                                        <span class="px-2 py-1 bg-gray-700/50 text-gray-300 text-xs rounded">
                                            +@(computer.Components.Count - 3)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="flex justify-between items-center mb-4">
                                <div class="text-primary font-bold text-xl">
                                    @computer.Price.ToString("C")
                                </div>
                            </div>

                            <!-- Кнопки действий -->
                            <div class="flex space-x-2">
                                <a href="@Url.Action("Details", "Computer", new { id = computer.Id })"
                                   class="flex-1 text-center px-3 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition">
                                    Просмотр
                                </a>

                                <a href="@Url.Action("EditConfiguration", "PcBuilder", new { computerId = computer.Id })"
                                   class="flex-1 text-center px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm rounded-lg transition">
                                    Редактировать
                                </a>

                                <a href="@Url.Action("CloneConfiguration", "PcBuilder", new { computerId = computer.Id })"
                                   class="flex-1 text-center px-3 py-2 bg-green-600 hover:bg-green-500 text-white text-sm rounded-lg transition">
                                    Копировать
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>