    </footer>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <style>
        /* Анимации для футера */
        @@keyframes gradient-xy {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .animate-gradient-xy {
            background-size: 400% 400%;
            animation: gradient-xy 15s ease infinite;
        }

        .animate-pulse-slow {
            animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.3;
            }

            50% {
                opacity: 0.6;
            }
        }

        /* Плавное появление */
        footer * {
            transition: all 0.3s ease;
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            #scrollToTop {
                bottom: 4;
                right: 4;
                width: 10;
                height: 10;
            }
        }

        /* Анимация градиента для логотипа */
        @@keyframes gradient {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .animate-gradient {
            background-size: 200% auto;
            animation: gradient 3s ease infinite;
        }

        /* Плавные переходы */
        nav * {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Стилизация скроллбара в выпадающих меню */
        #favorite-dropdown-items::-webkit-scrollbar {
            width: 4px;
        }

        #favorite-dropdown-items::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 2px;
        }

        #favorite-dropdown-items::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, #3b82f6, #8b5cf6);
            border-radius: 2px;
        }

        /* Эффект стекла для навбара */
        nav {
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Анимация для счетчиков */
        @@keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7);
            }

            70% {
                transform: scale(1.1);
                box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
            }

            100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
            }
        }

        .cart-counter, .favorite-counter {
            animation: pulse 2s infinite;
        }
    </style>
    <script>
            // Показать/скрыть кнопку "Наверх"
        const scrollToTopBtn = document.getElementById('scrollToTop');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
                scrollToTopBtn.style.opacity = '1';
                scrollToTopBtn.style.transform = 'translateY(0)';
            } else {
                scrollToTopBtn.style.opacity = '0';
                scrollToTopBtn.style.transform = 'translateY(20px)';
            }
        });

        // Анимация при наведении на ссылки
        document.querySelectorAll('footer a').forEach(link => {
            link.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-2px)';
            });

            link.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Анимация социальных иконок
        document.querySelectorAll('footer .flex.gap-4 a').forEach(icon => {
            icon.addEventListener('mouseenter', function() {
                this.style.transform = 'rotate(5deg) scale(1.1)';
            });

            icon.addEventListener('mouseleave', function() {
                this.style.transform = 'rotate(0) scale(1)';
            });
        });
        // Функция для добавления компьютера в корзину
        function addToCart(computerId, quantity = 1, computerName = '') {
            $.post('/Cart/AddToCart', { computerId, quantity })
                .done(function(response) {
                    if (response.success) {
                        showNotification('success', `Товар "${computerName}" добавлен в корзину`);
                        updateCartCounter(response.totalItems || response.cartItems);
                    } else {
                        showNotification('error', response.message);
                    }
                })
                .fail(function(xhr, status, error) {
                    console.error('Error adding computer to cart:', error);
                    showNotification('error', 'Ошибка при добавлении в корзину');
                });
        }

        // Функция для добавления компонента в корзину (ДОБАВЬТЕ ЭТУ ФУНКЦИЮ!)
        function addComponentToCart(componentId, quantity = 1, componentName = '') {
            $.post('/Cart/AddToCart', { componentId, quantity })
                .done(function(response) {
                    if (response.success) {
                        showNotification('success', `Товар "${componentName}" добавлен в корзину`);
                        updateCartCounter(response.totalItems || response.cartItems);
                    } else {
                        showNotification('error', response.message);
                    }
                })
                .fail(function(xhr, status, error) {
                    console.error('Error adding component to cart:', error);
                    showNotification('error', 'Ошибка при добавлении в корзину');
                });
        }

        // Обновляем счетчик корзины
        function updateCartCounter(count) {
            const cartCounter = $('#cart-counter');
            const cartCounterMobile = $('#cart-counter-mobile');

            [cartCounter, cartCounterMobile].forEach(counter => {
                if (counter.length) {
                    counter.text(count);
                    if (count > 0) {
                        counter.show();
                    } else {
                        counter.hide();
                    }
                }
            });
        }

        function showNotification(type, message) {
            // Удаляем старые уведомления
            $('.site-notification').remove();

            const alertClass = type === 'success'
                ? 'bg-green-500/20 border-green-500/30 text-green-500'
                : 'bg-red-500/20 border-red-500/30 text-red-500';

            // Простые иконки без Bootstrap Icons
            const iconSvg = type === 'success'
                ? '<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
                : '<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';

            const notification = $(`
                <div class="site-notification ${alertClass} border px-6 py-4 rounded-lg backdrop-blur-sm fixed flex items-center"
                     style="top: 20px; right: 20px; z-index: 1050; min-width: 300px;">
                    ${iconSvg}
                    <span class="flex-1">${message}</span>
                    <button type="button" class="text-current hover:opacity-70 ml-4 close-notification">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            `);

            $('body').append(notification);

            // Анимация появления
            notification.css({
                'transform': 'translateX(100%)',
                'opacity': '0'
            });

            setTimeout(() => {
                notification.css({
                    'transform': 'translateX(0)',
                    'opacity': '1',
                    'transition': 'all 0.3s ease-out'
                });
            }, 10);

            // Закрытие по клику
            notification.find('.close-notification').on('click', function() {
                closeNotification(notification);
            });

            // Автоматическое закрытие через 3 секунды
            setTimeout(() => {
                closeNotification(notification);
            }, 3000);
        }

        function closeNotification(notification) {
            notification.css({
                'transform': 'translateX(100%)',
                'opacity': '0',
                'transition': 'all 0.3s ease-out'
            });

            setTimeout(() => {
                notification.remove();
            }, 300);
        }

        // Загружаем количество товаров в корзине
        function loadCartCount() {
            $.get('/Cart/GetCartCount')
                .done(function(data) {
                    updateCartCounter(data.count);
                })
                .fail(function() {
                    console.log('Не удалось загрузить количество товаров в корзине');
                });
        }

        // Обработчики для кнопок "В корзину" (ОБНОВЛЕНО!)
        $(document).ready(function() {
            loadCartCount();

            // Обработчик для компьютеров
            $(document).on('click', '.add-to-cart', function() {
                const computerId = $(this).data('computer-id');
                const computerName = $(this).data('computer-name') || 'Компьютер';

                console.log('Adding computer:', computerId, computerName);

                if (computerId) {
                    addToCart(computerId, 1, computerName);
                } else {
                    showNotification('error', 'Не указан ID компьютера');
                }
            });

            $(document).on('click', '.add-to-cart-component', function() {
                const componentId = $(this).data('component-id');
                const componentName = $(this).data('component-name') || 'Комплектующее';

                console.log('Adding component:', componentId, componentName);

                if (componentId) {
                    addComponentToCart(componentId, 1, componentName);
                } else {
                    showNotification('error', 'Не указан ID компонента');
                }
            });

            // Универсальный обработчик (альтернативный вариант)
            $(document).on('click', '[data-add-to-cart]', function() {
                const $btn = $(this);
                const computerId = $btn.data('computer-id');
                const componentId = $btn.data('component-id');
                const productName = $btn.data('product-name') || $btn.data('computer-name') || $btn.data('component-name') || 'Товар';

                if (computerId) {
                    addToCart(computerId, 1, productName);
                } else if (componentId) {
                    addComponentToCart(componentId, 1, productName);
                }
            });
        });

        document.addEventListener('alpine:init', () => {
            Alpine.data('navbar', () => ({
                mobileMenuOpen: false,
                userMenuOpen: false
            }));
        });

        // Анимация при скролле
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('nav');
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-lg');
                navbar.classList.remove('shadow-2xl');
            } else {
                navbar.classList.remove('shadow-lg');
                navbar.classList.add('shadow-2xl');
            }
        });

        // Анимация иконок при наведении
        document.querySelectorAll('nav a').forEach(link => {
            link.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-4px)';
            });

            link.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // Инициализация при загрузке
        document.addEventListener('DOMContentLoaded', function() {
            updateFavoriteCounters();
            setupEventListeners();
            loadFavoriteDropdown();
        });

        // Обновление счетчиков
        function updateFavoriteCounters() {
            const count = @totalCount;

            // Обновляем все счетчики
            document.querySelectorAll('.favorite-counter').forEach(counter => {
                counter.textContent = count;
                counter.dataset.count = count;
                if (count > 0) {
                    counter.classList.remove('hidden');
                } else {
                    counter.classList.add('hidden');
                }
            });

            // Мобильный счетчик
            const mobileCounter = document.getElementById('favorite-counter-mobile');
            if (mobileCounter) {
                mobileCounter.textContent = count;
                mobileCounter.style.display = count > 0 ? 'flex' : 'none';
            }

            // Лимит в выпадающем списке
            const limitElement = document.getElementById('favorite-limit');
            if (limitElement) {
                limitElement.textContent = `${count}/${@maxItems}`;
            }

            // Обновляем прогресс бар
            updateProgressBar(count);
        }

        // Обновление прогресс бара
        function updateProgressBar(count) {
            const max = @maxItems;
            const percentage = (count * 100) / max;
            const progressBar = document.getElementById('limit-progress');
            if (progressBar) {
                progressBar.style.width = `${percentage}%`;
            }

            const limitCounter = document.getElementById('limit-counter');
            if (limitCounter) {
                limitCounter.textContent = `${count}/${max}`;
            }
        }

        // Загрузка выпадающего списка в хедере
        async function loadFavoriteDropdown() {
            try {
                const response = await fetch('/Favorites/Recent');
                if (response.ok) {
                    const html = await response.text();
                    const container = document.getElementById('favorite-dropdown-items');
                    if (container) {
                        container.innerHTML = html;
                        setupDropdownEventListeners();
                    }
                }
            } catch (error) {
                console.error('Error loading favorite dropdown:', error);
            }
        }

        // Настройка обработчиков событий
        function setupEventListeners() {
            // Поиск
            const searchInput = document.getElementById('search-favorites');
            if (searchInput) {
                searchInput.addEventListener('input', debounce(searchFavorites, 300));
            }

            // Сортировка
            const sortSelect = document.getElementById('sort-favorites');
            if (sortSelect) {
                sortSelect.addEventListener('change', sortFavorites);
            }

            // Удаление из избранного
            document.querySelectorAll('.remove-favorite-btn').forEach(btn => {
                btn.addEventListener('click', handleRemoveFavorite);
            });

            // Добавление в корзину
            document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
                btn.addEventListener('click', handleAddToCart);
            });

            // Выбор всех
            const selectAll = document.getElementById('select-all');
            if (selectAll) {
                selectAll.addEventListener('change', toggleSelectAll);
            }
        }

        // Обработчик удаления из избранного
        async function handleRemoveFavorite(e) {
            const button = e.currentTarget;
            const favoriteId = button.dataset.favoriteId;

            if (!confirm('Удалить товар из избранного?')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Favorites/Remove', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `favoriteId=${favoriteId}&__RequestVerificationToken=${token}`
                });

                const data = await response.json();

                if (data.success) {
                    // Удаляем элемент
                    const item = button.closest('.favorite-item');
                    item.style.opacity = '0';
                    item.style.transform = 'translateY(20px)';

                    setTimeout(() => {
                        item.remove();

                        // Обновляем счетчики
                        updateFavoriteCounters();

                        // Если список пуст, перезагружаем страницу
                        if (document.querySelectorAll('.favorite-item').length === 0) {
                            setTimeout(() => location.reload(), 300);
                        }

                        // Показываем уведомление
                        showNotification(data.message, 'success');
                    }, 300);
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                console.error('Error removing favorite:', error);
                showNotification('Ошибка при удалении из избранного', 'error');
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>