@using System.Security.Claims
@using System.Text.Json
<!DOCTYPE html>
<html lang="ru" class="h-full dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameTech PCs</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="~/logo.png" />
    
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#00ff88',
                        secondary: '#0099ff', 
                        accent: '#ff3366',
                        dark: '#0a0a0a',
                        'dark-card': '#1a1a1a',
                        'admin-sidebar': '#1f2937'
                    }
                }
            }
        }
    </script>
</head>
@{
    ViewData["Title"] = "Избранное";
    var list = new List<FavoriteWithProduct>();
    int total = list.Count;
    var totalCount = ViewBag.TotalCount ?? 0;
    var isGuest = ViewBag.IsGuest ?? false;
    var maxItems = isGuest ? 5 : 20;
    var percentage = totalCount > 0 ? (totalCount * 100 / maxItems) : 0;
}

<body class="h-full bg-dark text-gray-100" x-data="{ adminPanelOpen: false, mobileMenuOpen: false }">
    <!-- Основная навигация -->
    <nav class="sticky top-0 z-50 bg-gradient-to-b from-gray-900 via-gray-900/95 to-gray-900/90 backdrop-blur-xl border-b border-gray-800/50 shadow-2xl shadow-blue-900/10">
        <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Логотип -->
                <div class="flex items-center space-x-3">
                    <a href="/" class="group relative">
                        <!-- Анимированная подсветка -->
                        <div class="absolute -inset-1 bg-gradient-to-r from-green-500 via-blue-500 to-purple-500 rounded-xl blur opacity-20 group-hover:opacity-30 transition duration-500"></div>

                        <div class="relative flex items-center space-x-3">
                            <!-- Иконка -->
                            <div class="relative w-12 h-12">
                                <div class="absolute inset-0 bg-gradient-to-r from-green-500 to-blue-500 rounded-xl blur group-hover:blur-xl transition-all duration-500"></div>
                                <div class="relative w-full h-full bg-gradient-to-br from-green-500 via-blue-500 to-purple-500 rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-all duration-500 shadow-lg shadow-blue-500/25">
                                    <span class="text-white text-lg font-bold">🖥️</span>
                                </div>
                            </div>

                            <!-- Текст логотипа -->
                            <div class="flex flex-col">
                                <span class="text-2xl font-bold bg-gradient-to-r from-green-400 via-blue-400 to-purple-400 bg-clip-text text-transparent animate-gradient">
                                    WipeMyComputer
                                </span>
                                <span class="text-xs text-gray-400 font-medium">Профессиональная сборка ПК</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Основная навигация (Desktop) -->
                <div class="hidden lg:flex items-center space-x-1">
                    <!-- Главная -->
                    <a asp-controller="Home" asp-action="Index"
                       class="group relative px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-green-500/10 group-hover:via-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-500"></div>
                        <div class="relative flex items-center space-x-2">
                            <div class="w-6 h-6 flex items-center justify-center">
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-green-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a2 2 0 002 2h10a2 2 0 002-2V10" />
                                </svg>
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Главная</span>
                        </div>
                    </a>

                    <!-- Каталог -->
                    <a asp-controller="Home" asp-action="Catalog"
                       class="group relative px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-green-500/10 group-hover:via-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-500"></div>
                        <div class="relative flex items-center space-x-2">
                            <div class="w-6 h-6 flex items-center justify-center">
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                </svg>
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Каталог</span>
                        </div>
                    </a>

                    <!-- Избранное -->
                    <div class="relative group">
                        <a asp-controller="Favorites" asp-action="Index"
                           class="flex items-center space-x-2 px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-6 h-6 flex items-center justify-center relative">
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-red-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                </svg>

                                <!-- Счетчик -->
                                <span id="favorite-counter"
                                      class="absolute -top-2 -right-2 w-5 h-5 bg-gradient-to-br from-red-500 to-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold transform group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-red-500/25"
                                      data-count="0">
                                    @total
                                </span>
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Избранное</span>
                        </a>
                    </div>

                    <!-- Корзина -->
                    <a asp-controller="Cart" asp-action="Index"
                       class="group relative px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-green-500/10 group-hover:via-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-500"></div>
                        <div class="relative flex items-center space-x-2">
                            <div class="w-6 h-6 flex items-center justify-center relative">
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-green-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>

                                <!-- Счетчик корзины -->
                                <span id="cart-counter"
                                      class="absolute -top-2 -right-2 w-5 h-5 bg-gradient-to-br from-green-500 to-emerald-500 text-white rounded-full flex items-center justify-center text-xs font-bold transform group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-green-500/25
                                         @(ViewBag.CartItemsCount > 0 ? "" : "hidden")">
                                    @(ViewBag.CartItemsCount > 0 ? ViewBag.CartItemsCount.ToString() : "0")
                                </span>
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Корзина</span>
                        </div>
                    </a>

                    <!-- Сравнение -->
                    <a asp-controller="Compare" asp-action="Index"
                       class="group relative px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-green-500/10 group-hover:via-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-500"></div>
                        <div class="relative flex items-center space-x-2">
                            <div class="w-6 h-6 flex items-center justify-center relative">
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-purple-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>

                                <!-- Счетчик сравнения -->
                                @{
                                    var compareJson = Context.Session.GetString("CompareItems");
                                    var compareCount = 0;
                                    if (!string.IsNullOrEmpty(compareJson))
                                    {
                                        try
                                        {
                                            var compareItems = JsonSerializer.Deserialize<List<CompareItem>>(compareJson);
                                            compareCount = compareItems?.Count ?? 0;
                                        }
                                        catch { }
                                    }
                                }

                                @if (compareCount > 0)
                                {
                                    <span class="absolute -top-2 -right-2 w-5 h-5 bg-gradient-to-br from-purple-500 to-pink-500 text-white rounded-full flex items-center justify-center text-xs font-bold transform group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-purple-500/25">
                                        @compareCount
                                    </span>
                                }
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Сравнение</span>
                        </div>
                    </a>

                    <!-- Конфигуратор -->
                    <a asp-controller="PcBuilder" asp-action="Index"
                       class="group relative px-5 py-3 rounded-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-green-500/10 group-hover:via-blue-500/10 group-hover:to-purple-500/10 rounded-xl transition-all duration-500"></div>
                        <div class="relative flex items-center space-x-2">
                            <div class="w-6 h-6 flex items-center justify-center">
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-cyan-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <span class="text-gray-300 group-hover:text-white font-medium transition-colors duration-300">Конфигуратор</span>
                        </div>
                    </a>
                </div>

                <!-- Правая часть (авторизация/пользователь) -->
                <div class="flex items-center space-x-4">
                    <!-- Поиск (опционально) -->
                    <div class="hidden lg:block relative group">
                        <div class="absolute inset-0 bg-gradient-to-r from-green-500/10 to-blue-500/10 rounded-xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        <div class="relative w-10 h-10 flex items-center justify-center text-gray-400 hover:text-white cursor-pointer rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- Профиль пользователя -->
                        <div class="relative group" x-data="{ open: false }">
                            <button @@click="open = !open"
                                    class="flex items-center space-x-3 px-4 py-2 rounded-xl hover:bg-gray-800/50 transition-all duration-300 hover:-translate-y-1 group/profile">
                                <!-- Аватар -->
                                <div class="relative">
                                    <div class="absolute -inset-1 bg-gradient-to-r from-green-500 via-blue-500 to-purple-500 rounded-full blur opacity-0 group-hover/profile:opacity-50 transition-opacity duration-500"></div>
                                    <div class="relative w-10 h-10 bg-gradient-to-br from-green-500 to-blue-500 rounded-full flex items-center justify-center overflow-hidden">
                                        @if (User.IsInRole("Админ"))
                                        {
                                            <div class="absolute inset-0 bg-gradient-to-r from-red-500/20 to-orange-500/20"></div>
                                        }
                                        else if (User.IsInRole("Менеджер"))
                                        {
                                            <div class="absolute inset-0 bg-gradient-to-r from-yellow-500/20 to-amber-500/20"></div>
                                        }

                                        <span class="text-white font-bold text-sm">
                                            @User.Identity.Name.Substring(0, 1).ToUpper()
                                        </span>

                                        <!-- Онлайн статус -->
                                        <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-gray-900"></div>
                                    </div>
                                </div>

                                <!-- Имя и роль -->
                                <div class="text-left">
                                    <div class="text-sm font-medium text-white truncate max-w-[120px]">
                                        @User.Identity.Name
                                    </div>
                                    <div class="text-xs">
                                        @if (User.IsInRole("Админ"))
                                        {
                                            <span class="text-red-400 font-bold">Администратор</span>
                                        }
                                        else if (User.IsInRole("Менеджер"))
                                        {
                                            <span class="text-yellow-400 font-bold">Менеджер</span>
                                        }
                                        else
                                        {
                                            <span class="text-blue-400 font-bold">Пользователь</span>
                                        }
                                    </div>
                                </div>

                                <!-- Стрелка -->
                                <svg class="w-4 h-4 text-gray-400 transform transition-transform duration-300"
                                     :class="{ 'rotate-180': open }"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Выпадающее меню профиля -->
                            <div x-show="open" @@click.outside="open = false"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 scale-95"
                                 x-transition:enter-end="opacity-100 scale-100"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 scale-100"
                                 x-transition:leave-end="opacity-0 scale-95"
                                 class="absolute right-0 mt-2 w-64 bg-gradient-to-br from-gray-900 via-gray-900 to-gray-800 rounded-2xl shadow-2xl shadow-blue-900/30 border border-gray-800/50 z-50 overflow-hidden">

                                <!-- Заголовок профиля -->
                                <div class="p-6 border-b border-gray-800/50 bg-gradient-to-r from-gray-900/50 to-gray-800/50">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-blue-500 rounded-xl flex items-center justify-center">
                                            <span class="text-white font-bold text-lg">
                                                @User.Identity.Name.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                        <div>
                                            <h3 class="text-lg font-bold text-white">@User.Identity.Name</h3>
                                            <p class="text-sm text-gray-400">Личный кабинет</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Основные ссылки -->
                                <div class="p-4 space-y-1">
                                    <a asp-controller="Auth" asp-action="Profile"
                                       class="group flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                                        <div class="w-8 h-8 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-lg flex items-center justify-center">
                                            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                        </div>
                                        <span class="text-gray-300 group-hover:text-white">Профиль</span>
                                    </a>

                                    <a asp-controller="Order" asp-action="MyOrders"
                                       class="group flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                                        <div class="w-8 h-8 bg-gradient-to-br from-green-500/20 to-emerald-500/20 rounded-lg flex items-center justify-center">
                                            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                            </svg>
                                        </div>
                                        <span class="text-gray-300 group-hover:text-white">Мои заказы</span>
                                    </a>

                                    <!-- Админ панель -->
                                    @if (User.IsInRole("Админ") || User.IsInRole("Менеджер"))
                                    {
                                        <div class="pt-4 mt-4 border-t border-gray-800/50">
                                            <div class="px-4 mb-2">
                                                <span class="text-xs text-gray-500 font-bold">Администрация</span>
                                            </div>

                                            <a asp-controller="Order" asp-action="Index"
                                               class="group flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                                                <div class="w-8 h-8 bg-gradient-to-br from-purple-500/20 to-pink-500/20 rounded-lg flex items-center justify-center">
                                                    <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                </div>
                                                <span class="text-gray-300 group-hover:text-white">Все заказы</span>
                                            </a>

                                            @if (User.IsInRole("Админ"))
                                            {
                                                <a asp-controller="Computer" asp-action="Index"
                                                   class="group flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                                                    <div class="w-8 h-8 bg-gradient-to-br from-red-500/20 to-orange-500/20 rounded-lg flex items-center justify-center">
                                                        <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                                                        </svg>
                                                    </div>
                                                    <span class="text-gray-300 group-hover:text-white">Компьютеры</span>
                                                </a>

                                                <a asp-controller="Component" asp-action="Index"
                                                   class="group flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-800/50 transition-all duration-300">
                                                    <div class="w-8 h-8 bg-gradient-to-br from-yellow-500/20 to-amber-500/20 rounded-lg flex items-center justify-center">
                                                        <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                                        </svg>
                                                    </div>
                                                    <span class="text-gray-300 group-hover:text-white">Комплектующие</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Выход -->
                                <div class="p-4 border-t border-gray-800/50 bg-gray-900/50">
                                    <a asp-controller="Auth" asp-action="Logout"
