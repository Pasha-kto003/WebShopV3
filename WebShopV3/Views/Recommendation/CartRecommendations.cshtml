@using WebShopV3.Models.Recommendation
@model WebShopV3.Controllers.RecommendationViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">@Model.Title</h1>
        <p class="text-gray-600">@Model.Description</p>
        
        <!-- Ссылка на корзину -->
        <div class="mt-4">
            <a href="@Url.Action("Index", "Cart")" 
               class="inline-flex items-center text-blue-600 hover:text-blue-800">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"/>
                </svg>
                Вернуться в корзину
            </a>
        </div>
    </div>

    @if (Model.Recommendations.Any())
{
    <!-- Сетка рекомендаций -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
        @foreach (var item in Model.Recommendations)
        {
            <div class="bg-dark-card rounded-xl border border-gray-800 overflow-hidden hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 product-card flex flex-col h-full">
                <!-- Бейдж "Советуем" -->
                <div class="absolute top-2 left-2 z-10">
                    <span class="px-3 py-1 text-xs font-bold bg-gradient-to-r from-primary to-purple-600 text-white rounded-full flex items-center">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        👑 Советуем
                    </span>
                </div>
                
                <!-- Изображение -->
                <a href="@GetProductUrl(item)" class="block">
                    <div class="relative h-48 bg-gradient-to-br from-primary/20 to-primary/10 overflow-hidden">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            @if(item.ProductType == "Computer")
                            {
                                <img src="~/Images/computers/@item.ImageUrl" alt="@item.Name" class="w-full h-full object-cover transform hover:scale-105 transition duration-500">
                            }
                            else
                            {
                                <img src="~/Images/components/@item.ImageUrl" alt="@item.Name" class="w-full h-full object-cover transform hover:scale-105 transition duration-500">
                            }
                            
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full">
                                <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 0 002 2z"/>
                                </svg>
                            </div>
                        }
                        
                        <!-- Бейдж типа товара -->
                        <div class="absolute top-2 right-2">
                            @{
                                var isComputer = item.ProductType == "Computer";
                                var bgClass = isComputer ? "bg-primary/20 text-primary" : "bg-blue-500/20 text-blue-400";
                                var typeText = isComputer ? "ПК" : GetShortTypeName(item.ComponentType);
                            }
                            <span class="@bgClass text-xs font-bold px-2 py-1 rounded-full">
                                @typeText
                            </span>
                        </div>
                    </div>
                </a>
                
                <!-- Контент -->
                <div class="p-4 flex-grow flex flex-col">
                    <!-- Название -->
                    <h3 class="font-bold text-white mb-2 line-clamp-2 hover:text-primary transition duration-200">
                        <a href="@GetProductUrl(item)" class="hover:text-primary">
                            @item.Name
                        </a>
                    </h3>
                    
                    <!-- Цена -->
                    <div class="mb-3">
                        <span class="text-xl font-bold text-primary">
                            @item.Price.ToString("C")
                        </span>
                    </div>
                    
                    <!-- Кнопка быстрого добавления -->
                    <button onclick="addToCartAndContinue('@item.ProductType', @item.Id)" 
                            class="w-full py-2 bg-primary/10 text-primary hover:bg-primary hover:text-dark rounded-lg 
                                   transition duration-200 font-medium flex items-center justify-center add-to-cart-btn"
                            data-product-id="@item.Id"
                            data-product-type="@item.ProductType.ToLower()"
                            data-product-name="@item.Name">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                  d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                        Добавить в корзину
                    </button>
                    
                    <!-- Ссылка подробнее -->
                    <a href="@GetProductUrl(item)" 
                       class="block mt-2 text-center text-sm text-primary hover:text-primary/80 transition duration-200">
                        Подробнее о товаре
                    </a>
                </div>
            </div>
        }
    </div>
    
    <!-- Панель действий -->
    <div class="mt-8 pt-6 border-t border-gray-800">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <p class="text-gray-400">Выбрали что-то интересное?</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <a href="@Url.Action("Index", "Cart")" 
                   class="px-6 py-3 border border-gray-700 text-gray-400 hover:text-white hover:bg-gray-800 rounded-lg 
                          transition duration-200 text-center">
                    Вернуться в корзину
                </a>
                <a href="@Url.Action("Checkout", "Cart")" 
                   class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg 
                          hover:from-green-700 hover:to-emerald-700 transition duration-200 font-medium text-center shadow-lg shadow-green-600/20">
                    Перейти к оформлению
                </a>
            </div>
        </div>
    </div>
}
    else
    {
        <div class="text-center py-12">
            <div class="inline-flex items-center justify-center w-16 h-16 
                        bg-blue-100 text-blue-600 rounded-full mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Отличный выбор!</h3>
            <p class="text-gray-600 mb-6">Вы уже добавили все необходимое в корзину</p>
            <a href="@Url.Action("Checkout", "Cart")" 
               class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                Оформить заказ
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addToCartAndContinue(productType, productId) {
            const data = productType === 'Computer' 
                ? { computerId: productId } 
                : { componentId: productId };
            
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Обновляем счетчик корзины
                    updateCartCount(result.cartItems);
                    
                    // Показываем уведомление
                    showNotification('Товар добавлен в корзину!', 'success');
                    
                    // Обновляем страницу через секунду
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    showNotification(result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Ошибка при добавлении в корзину', 'error');
            });
        }
        
        function updateCartCount(count) {
            document.querySelectorAll('.cart-count').forEach(el => {
                el.textContent = count;
            });
        }
        
        function showNotification(message, type) {
            // Здесь можно использовать Toast или другой компонент
            alert(message);
        }
    </script>
}

@functions {
    string GetProductUrl(RecommendationItem item)
    {
        return item.ProductType == "Computer" 
            ? Url.Action("ComputerDetails", "Home", new { id = item.Id })
            : Url.Action("ComponentDetails", "Home", new { id = item.Id });
    }
    string GetShortTypeName(string? type)
    {
        return type switch
        {
            "CPU" => "Проц.",
            "GPU" => "Видео",
            "RAM" => "ОЗУ",
            "SSD" => "SSD",
            "HDD" => "HDD",
            "PSU" => "БП",
            "MB" => "Мат. плата",
            "Case" => "Корпус",
            _ => type?.Length > 4 ? type.Substring(0, 4) : type ?? ""
        };
    }
}