@using WebShopV3.Models.Recommendation
@model WebShopV3.Controllers.RecommendationViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <!-- Заголовок и описание -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">@Model.Title</h1>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-gray-400">@Model.Description</p>
                }
            </div>
            
            <!-- Статистика -->
            @if (Model.Count > 0)
            {
                <div class="bg-dark-card border border-gray-800 rounded-lg px-4 py-2">
                    <div class="text-sm text-gray-400">Найдено товаров:</div>
                    <div class="text-xl font-bold text-primary">@Model.Count</div>
                </div>
            }
        </div>
        
        <!-- Индикаторы типов рекомендаций -->
        <div class="flex items-center space-x-4 text-sm">
            <div class="flex items-center">
                <span class="w-3 h-3 bg-gradient-to-r from-primary to-purple-600 rounded-full mr-2"></span>
                <span class="text-gray-400">AI-рекомендации</span>
            </div>
            <div class="flex items-center">
                <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                <span class="text-gray-400">Популярные товары</span>
            </div>
            <div class="flex items-center">
                <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                <span class="text-gray-400">Похожие товары</span>
            </div>
        </div>
    </div>

    @if (Model.ShowCartInfo)
    {
        <!-- Информация о корзине -->
        <div class="bg-gradient-to-r from-primary/10 to-blue-500/10 border border-primary/20 rounded-xl p-4 mb-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="text-white font-medium">Ваша корзина</div>
                        <div class="text-gray-400 text-sm">
                            @Model.CartItemCount товаров • @Model.CartTotal.ToString("C")
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "Cart")" 
                   class="px-4 py-2 bg-primary/20 text-primary hover:bg-primary hover:text-dark rounded-lg transition duration-200 text-sm font-medium">
                    Перейти в корзину
                </a>
            </div>
        </div>
    }

    @if (Model.Categories != null && Model.Categories.Any())
    {
        <!-- Фильтр по категориям -->
        <div class="mb-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-semibold text-white">Категории комплектующих</h2>
                <div class="text-sm text-gray-400">Выберите категорию:</div>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var category in Model.Categories)
                {
                    <a href="@Url.Action("Components", new { category })" 
                       class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200
                              @(Model.SelectedCategory == category 
                                ? "bg-gradient-to-r from-primary to-blue-600 text-white shadow-lg" 
                                : "bg-dark-card text-gray-300 hover:bg-gray-800 hover:text-white border border-gray-800")">
                        <div class="flex items-center">
                            <span class="mr-2 text-lg">@GetCategoryIcon(category)</span>
                            @GetCategoryDisplayName(category)
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Recommendations.Any())
    {
        <!-- Сетка товаров -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var item in Model.Recommendations)
            {
                <div class="bg-dark-card rounded-xl border border-gray-800 overflow-hidden hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 group">
                    <!-- Изображение -->
                    <div class="relative overflow-hidden">
                        <a href="@GetProductUrl(item)" class="block">
                            @if(item.ProductType == "Computer")
                            {
                                <div class="aspect-w-16 aspect-h-9 bg-gradient-to-br @(item.ProductType == "Computer" ? "from-primary/20 to-primary/10" : "from-blue-500/20 to-blue-500/10")">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="~/Images/computers/@item.ImageUrl" alt="@item.Name" 
                                             class="object-cover w-full h-48 group-hover:scale-105 transition-transform duration-500">
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-center h-48">
                                            <span class="text-5xl">
                                                @if (item.ProductType == "Computer")
                                                {
                                                    @:🖥️
                                                }
                                                else
                                                {
                                                    @GetComponentIcon(item.ComponentType)
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="aspect-w-16 aspect-h-9 bg-gradient-to-br @(item.ProductType == "Component" ? "from-primary/20 to-primary/10" : "from-blue-500/20 to-blue-500/10")">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="~/Images/components/@item.ImageUrl" alt="@item.Name" 
                                             class="object-cover w-full h-48 group-hover:scale-105 transition-transform duration-500">
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-center h-48">
                                            <span class="text-5xl">
                                                @GetComponentIcon(item.ComponentType)
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            
                        </a>
                        
                        <!-- Бейджи -->
                        <div class="absolute top-3 left-3 right-3 flex justify-between">
                            <!-- Тип товара -->
                            <div>
                                <span class="@(item.ProductType == "Computer" ? "bg-primary/20 text-primary" : "bg-blue-500/20 text-blue-400") text-xs font-bold px-3 py-1 rounded-full">
                                    @if (item.ProductType == "Computer")
                                    {
                                        @:ПК
                                    }
                                    else
                                    {
                                        @GetShortTypeName(item.ComponentType)
                                    }
                                </span>
                            </div>
                            
                            <!-- Рейтинг релевантности -->
                            @if (item.RelevanceScore > 0.7)
                            {
                                <div class="flex items-center bg-gradient-to-r from-yellow-500/20 to-orange-500/20 text-yellow-400 text-xs font-bold px-3 py-1 rounded-full">
                                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                    @((item.RelevanceScore * 100).ToString("F0"))%
                                </div>
                            }
                        </div>
                        
                        <!-- Наличие -->
                        <div class="absolute bottom-3 right-3">
                            @if (item.StockQuantity > 10)
                            {
                                <span class="bg-green-500/20 text-green-400 text-xs font-bold px-3 py-1 rounded-full">
                                    ✓ В наличии
                                </span>
                            }
                            else if (item.StockQuantity > 0)
                            {
                                <span class="bg-yellow-500/20 text-yellow-400 text-xs font-bold px-3 py-1 rounded-full">
                                    Осталось: @item.StockQuantity
                                </span>
                            }
                            else
                            {
                                <span class="bg-red-500/20 text-red-400 text-xs font-bold px-3 py-1 rounded-full">
                                    Нет в наличии
                                </span>
                            }
                        </div>
                    </div>
                    
                    <!-- Контент -->
                    <div class="p-4">
                        <!-- Тип рекомендации -->
                        @if (!string.IsNullOrEmpty(item.RecommendationType))
                        {
                            <div class="mb-2">
                                <span class="text-xs font-medium @GetRecommendationTypeColor(item.RecommendationType) px-2 py-1 rounded">
                                    @GetRecommendationTypeText(item.RecommendationType)
                                </span>
                            </div>
                        }
                        
                        <!-- Название -->
                        <h3 class="font-bold text-white mb-2 line-clamp-2 group-hover:text-primary transition duration-200">
                            <a href="@GetProductUrl(item)" class="hover:text-primary">
                                @item.Name
                            </a>
                        </h3>
                        
                        <!-- Описание -->
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="text-gray-400 text-sm mb-3 line-clamp-2">
                                @item.Description
                            </p>
                        }
                        
                        <!-- Цена -->
                        <div class="mb-4">
                            <div class="text-xl font-bold text-primary">@item.Price.ToString("C")</div>
                            @if (item.RelevanceScore > 0.8)
                            {
                                <div class="text-xs text-green-400 mt-1">
                                    <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                                    </svg>
                                    Высокая релевантность
                                </div>
                            }
                        </div>
                        
                        <!-- Кнопки действий -->
                        <div class="flex gap-2">
                            <a href="@GetProductUrl(item)" 
                               class="flex-1 text-center px-4 py-2 bg-gray-800 text-white hover:bg-gray-700 rounded-lg transition duration-200 text-sm font-medium">
                                Подробнее
                            </a>
                            @if (item.StockQuantity > 0)
                            {
                                <button onclick="addToCart('@item.ProductType', @item.Id, '@item.Name')" 
                                        class="px-4 py-2 bg-primary/20 text-primary hover:bg-primary hover:text-dark rounded-lg transition duration-200 flex items-center justify-center"
                                        title="Добавить в корзину">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                              d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                    </svg>
                                </button>
                                
                                <button onclick="addToCompare('@item.ProductType', @item.Id)" 
                                        class="px-4 py-2 bg-gray-800 text-gray-400 hover:text-white hover:bg-gray-700 rounded-lg transition duration-200"
                                        title="Добавить к сравнению">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Навигация -->
        @if (!string.IsNullOrEmpty(Model.FilterType) || Model.CurrentProductId.HasValue)
        {
            <div class="mt-8 flex justify-center">
                @if (Model.CurrentProductId.HasValue)
                {
                    <a href="@Url.Action("Similar", "Recommendation", new { 
                            productType = Model.CurrentProductType, 
                            productId = Model.CurrentProductId.Value, 
                            limit = Model.Count + 8 
                        })" 
                       class="px-6 py-3 bg-gradient-to-r from-primary/20 to-blue-500/20 text-primary hover:from-primary hover:to-blue-600 hover:text-white rounded-lg transition-all duration-200 font-medium border border-primary/30">
                        Показать больше похожих товаров
                    </a>
                }
                else if (!string.IsNullOrEmpty(Model.FilterType))
                {
                    <a href="@Url.Action("Popular", new { type = Model.FilterType, limit = Model.Count + 12 })" 
                       class="px-6 py-3 bg-gradient-to-r from-primary/20 to-blue-500/20 text-primary hover:from-primary hover:to-blue-600 hover:text-white rounded-lg transition-all duration-200 font-medium border border-primary/30">
                        Показать еще
                    </a>
                }
            </div>
        }
        
        <!-- Быстрые действия -->
        <div class="mt-8 pt-6 border-t border-gray-800">
            <div class="flex flex-wrap gap-3 justify-center">
                <a href="@Url.Action("ForCart", "Recommendation")" 
                   class="px-4 py-2 bg-gradient-to-r from-green-500/20 to-emerald-500/20 text-green-400 hover:from-green-500 hover:to-emerald-600 hover:text-white rounded-lg transition-all duration-200 text-sm">
                    <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"/>
                    </svg>
                    Для корзины
                </a>
                
                <a href="@Url.Action("ForYou", "Recommendation")" 
                   class="px-4 py-2 bg-gradient-to-r from-purple-500/20 to-pink-500/20 text-purple-400 hover:from-purple-500 hover:to-pink-600 hover:text-white rounded-lg transition-all duration-200 text-sm">
                    <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                    </svg>
                    Для вас
                </a>
                
                <a href="@Url.Action("Components", "Recommendation")" 
                   class="px-4 py-2 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 text-blue-400 hover:from-blue-500 hover:to-cyan-600 hover:text-white rounded-lg transition-all duration-200 text-sm">
                    <svg class="w-4 h-4 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                    </svg>
                    Комплектующие
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Нет рекомендаций -->
        <div class="text-center py-12">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-primary/20 to-blue-500/20 text-primary rounded-full mb-4">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-2">Рекомендации отсутствуют</h3>
            <p class="text-gray-400 mb-6">Попробуйте посмотреть другие товары или обновите страницу</p>
            <div class="flex flex-wrap gap-3 justify-center">
                <a href="@Url.Action("Index", "Home")" 
                   class="px-6 py-3 bg-gradient-to-r from-primary to-blue-600 text-white rounded-lg hover:shadow-lg hover:shadow-primary/30 transition-all duration-200">
                    На главную
                </a>
                <button id="refreshRecommendationsBtn" 
                        class="px-6 py-3 bg-gray-800 text-gray-300 hover:text-white hover:bg-gray-700 rounded-lg transition duration-200">
                    Обновить рекомендации
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addToCart(productType, productId, productName) {
            const data = productType === 'Computer' 
                ? { computerId: productId } 
                : { componentId: productId };
            
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Обновляем счетчик корзины
                    document.querySelectorAll('.cart-count').forEach(el => {
                        el.textContent = result.cartItems;
                    });
                    
                    // Показываем уведомление
                    showNotification(productName + ' добавлен в корзину!', 'success');
                    
                    // Анимация добавления
                    const button = event.target.closest('button');
                    if (button) {
                        button.classList.add('bg-green-500', 'text-white');
                        setTimeout(() => {
                            button.classList.remove('bg-green-500', 'text-white');
                        }, 1000);
                    }
                } else {
                    showNotification(result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Ошибка при добавлении в корзину', 'error');
            });
        }
        
        function addToCompare(productType, productId) {
            fetch('/Compare/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `productId=${productId}&productType=${productType}`
            })
            .then(response => {
                if (response.ok) {
                    showNotification('Товар добавлен к сравнению', 'success');
                    
                    // Анимация
                    const button = event.target.closest('button');
                    if (button) {
                        button.classList.add('bg-blue-500', 'text-white');
                        setTimeout(() => {
                            button.classList.remove('bg-blue-500', 'text-white');
                        }, 1000);
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Ошибка при добавлении к сравнению', 'error');
            });
        }
        
        function showNotification(message, type) {
            // Создаем уведомление
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 ${
                type === 'success' 
                    ? 'bg-gradient-to-r from-green-500 to-emerald-600 text-white' 
                    : 'bg-gradient-to-r from-red-500 to-pink-600 text-white'
            }`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            // Автоматическое скрытие
            setTimeout(() => {
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
        
        // Обновление рекомендаций
        document.getElementById('refreshRecommendationsBtn')?.addEventListener('click', function() {
            this.disabled = true;
            this.innerHTML = '<span class="animate-spin mr-2">⟳</span> Обновление...';
            
            // Здесь можно добавить AJAX запрос для обновления рекомендаций
            setTimeout(() => {
                location.reload();
            }, 1000);
        });
        
        // Плавная прокрутка для ссылок с якорями
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;
                
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
}

@functions {
    string GetProductUrl(RecommendationItem item)
    {
        return item.ProductType == "Computer" 
            ? Url.Action("ComputerDetails", "Home", new { id = item.Id })
            : Url.Action("ComponentDetails", "Home", new { id = item.Id });
    }
    
    string GetCategoryDisplayName(string category)
    {
        return category switch
        {
            "CPU" => "Процессоры",
            "GPU" => "Видеокарты",
            "RAM" => "Оперативная память",
            "SSD" => "SSD накопители",
            "HDD" => "Жесткие диски",
            "MB" => "Материнские платы",
            "PSU" => "Блоки питания",
            "CASE" => "Корпуса",
            "Cooler" => "Охлаждение",
            "Monitor" => "Мониторы",
            _ => category
        };
    }
    
    string GetCategoryIcon(string category)
    {
        return category switch
        {
            "CPU" => "⚡",
            "GPU" => "🎮",
            "RAM" => "💾",
            "SSD" => "🚀",
            "HDD" => "💿",
            "MB" => "🔌",
            "PSU" => "⚡",
            "CASE" => "🖥️",
            "Cooler" => "❄️",
            "Monitor" => "🖥️",
            _ => "🔧"
        };
    }
    
    string GetComponentIcon(string category)
    {
        return category switch
        {
            "CPU" => "⚙️",
