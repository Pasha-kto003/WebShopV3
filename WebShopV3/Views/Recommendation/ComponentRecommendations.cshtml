@model WebShopV3.Controllers.RecommendationViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <!-- Заголовок -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">@Model.Title</h1>
        <p class="text-gray-600">@Model.Description</p>
    </div>

    <!-- Категории компонентов -->
    @if (Model.Categories != null && Model.Categories.Any())
    {
        <div class="mb-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Категории комплектующих</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                @foreach (var category in Model.Categories)
                {
                    <a href="@Url.Action("Components", new { category })" 
                       class="group p-4 border border-gray-200 rounded-lg text-center 
                              hover:border-blue-500 hover:bg-blue-50 transition-all
                              @(Model.SelectedCategory == category ? "border-blue-500 bg-blue-50" : "")">
                        <div class="text-2xl mb-2">
                            @GetCategoryIcon(category)
                        </div>
                        <div class="text-sm font-medium text-gray-700 group-hover:text-blue-700">
                            @GetCategoryDisplayName(category)
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Выбранная категория -->
    @if (!string.IsNullOrEmpty(Model.SelectedCategory))
    {
        <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">
                @GetCategoryDisplayName(Model.SelectedCategory)
                <span class="text-sm font-normal text-gray-500 ml-2">
                    (@Model.Count товаров)
                </span>
            </h2>
        </div>
    }

    @if (Model.Recommendations.Any())
    {
        <!-- Сетка товаров -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var item in Model.Recommendations)
            {
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden 
                            hover:border-blue-300 hover:shadow-md transition-all">
                    <!-- Изображение -->
                    <a href="@Url.Action("ComponentDetails", "Home", new { id = item.Id })" 
                       class="block relative">
                        <div class="aspect-w-16 aspect-h-9 bg-gray-50">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" 
                                     class="w-full h-48 object-contain p-4">
                            }
                            else
                            {
                                <div class="flex items-center justify-center h-48">
                                    <div class="text-4xl">
                                        @GetCategoryIcon(item.ComponentType)
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <!-- Бейдж категории -->
                        @if (!string.IsNullOrEmpty(item.ComponentType))
                        {
                            <div class="absolute top-2 left-2">
                                <span class="px-2 py-1 text-xs font-semibold 
                                            bg-gray-800 text-white rounded">
                                    @GetCategoryShortName(item.ComponentType)
                                </span>
                            </div>
                        }
                    </a>
                    
                    <!-- Контент -->
                    <div class="p-4">
                        <!-- Название -->
                        <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">
                            <a href="@Url.Action("ComponentDetails", "Home", new { id = item.Id })" 
                               class="hover:text-blue-600">
                                @item.Name
                            </a>
                        </h3>
                        
                        <!-- Характеристики (кратко) -->
                        @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 100)
                        {
                            <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                                @item.Description.Substring(0, Math.Min(100, item.Description.Length))...
                            </p>
                        }
                        
                        <!-- Цена и кнопка -->
                        <div class="flex items-center justify-between mt-4">
                            <div>
                                <span class="text-lg font-bold text-gray-900">
                                    @item.Price.ToString("C")
                                </span>
                                <div class="text-xs text-gray-500 mt-1">
                                    @if (item.StockQuantity > 10)
                                    {
                                        <span class="text-green-600">✓ В наличии</span>
                                    }
                                    else if (item.StockQuantity > 0)
                                    {
                                        <span class="text-yellow-600">Осталось мало</span>
                                    }
                                </div>
                            </div>
                            <button onclick="addComponentToCart(@item.Id)" 
                                    class="px-4 py-2 bg-blue-600 text-white rounded-lg 
                                           hover:bg-blue-700 transition-colors text-sm font-medium">
                                В корзину
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Кнопка "Показать еще" -->
        @if (!string.IsNullOrEmpty(Model.SelectedCategory))
        {
            <div class="mt-8 text-center">
                <a href="@Url.Action("Popular", new { type = "Component", limit = Model.Count + 12 })" 
                   class="inline-flex items-center px-6 py-3 border border-gray-300 
                          text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                              d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    Показать все комплектующие
                </a>
            </div>
        }
    }
    else
    {
        <div class="text-center py-12">
            <div class="inline-flex items-center justify-center w-16 h-16 
                        bg-gray-100 text-gray-400 rounded-full mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                          d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Товары не найдены</h3>
            <p class="text-gray-600 mb-6">В данной категории пока нет доступных товаров</p>
            <a href="@Url.Action("Components")" 
               class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                Посмотреть другие категории
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addComponentToCart(componentId) {
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ componentId: componentId })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Обновляем счетчик корзины
                    document.querySelectorAll('.cart-count').forEach(el => {
                        el.textContent = result.cartItems;
                    });
                    
                    // Показываем уведомление
                    showNotification(result.message, 'success');
                } else {
                    showNotification(result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Ошибка при добавлении в корзину', 'error');
            });
        }
        
        function showNotification(message, type) {
            // Реализация показа уведомления
            alert(message);
        }
    </script>
}

@functions {
    string GetCategoryIcon(string? category)
    {
        return category?.ToUpper() switch
        {
            "CPU" => "⚡",
            "GPU" => "🎮",
            "RAM" => "💾",
            "SSD" => "🚀",
            "HDD" => "💿",
            "MB" => "🔌",
            "PSU" => "🔋",
            "CASE" => "🖥️",
            "COOLER" => "❄️",
            "MONITOR" => "🖥️",
            _ => "🔧"
        };
    }
    
    string GetCategoryDisplayName(string? category)
    {
        return category?.ToUpper() switch
        {
            "CPU" => "Процессоры",
            "GPU" => "Видеокарты",
            "RAM" => "Оперативная память",
            "SSD" => "SSD накопители",
            "HDD" => "Жесткие диски",
            "MB" => "Материнские платы",
            "PSU" => "Блоки питания",
            "CASE" => "Корпуса",
            "COOLER" => "Системы охлаждения",
            "MONITOR" => "Мониторы",
            _ => category ?? "Комплектующие"
        };
    }
    
    string GetCategoryShortName(string? category)
    {
        return category?.ToUpper() switch
        {
            "CPU" => "CPU",
            "GPU" => "GPU",
            "RAM" => "RAM",
            "SSD" => "SSD",
            "HDD" => "HDD",
            "MB" => "MB",
            "PSU" => "PSU",
            "CASE" => "CASE",
            "COOLER" => "COOLER",
            "MONITOR" => "MON",
            _ => category ?? "COMP"
        };
    }
}