@model WebShopV3.Models.Computer

@if (Model.ComputerComponents.Any(cc => cc.Component.ComponentCharacteristics.Any()))
{
    <div class="bg-dark-card rounded-2xl p-8 border border-gray-800 mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">Полные технические характеристики</h2>
        
        <div class="space-y-8">
            @foreach (var computerComponent in Model.ComputerComponents.Where(cc => cc.Component.ComponentCharacteristics.Any()))
            {
                <div class="bg-gray-800/30 rounded-xl p-6 border border-gray-700">
                    <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                        @GetComponentIcon(computerComponent.Component.Type)
                        @computerComponent.Component.Name
                        <span class="ml-3 text-sm font-normal text-gray-400 bg-gray-700 px-3 py-1 rounded-full">
                            @GetTypeDisplayName(computerComponent.Component.Type)
                        </span>
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var charItem in computerComponent.Component.ComponentCharacteristics)
                        {
                            <div class="bg-gray-700/50 rounded-lg p-4 border border-gray-600 hover:border-primary/50 transition duration-200">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-white font-semibold text-sm">@charItem.Characteristic?.Name</span>
                                    @if (!string.IsNullOrEmpty(charItem.Characteristic?.Unit))
                                    {
                                        <span class="text-gray-400 text-xs bg-gray-600 px-2 py-1 rounded-full">@charItem.Characteristic.Unit</span>
                                    }
                                </div>
                                <div class="text-primary text-lg font-bold">@charItem.Value</div>
                                @if (!string.IsNullOrEmpty(charItem.Characteristic?.Description))
                                {
                                    <div class="text-gray-400 text-xs mt-2">@charItem.Characteristic.Description</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@functions {
    public string GetComponentIcon(string type)
    {
        return type switch
        {
            "CPU" => "⚙️",
            "GPU" => "🎮",
            "RAM" => "💾",
            "SSD" => "💿",
            "HDD" => "📀",
            "PSU" => "⚡",
            _ => "🔧"
        };
    }

    public string GetTypeDisplayName(string type)
    {
        return type switch
        {
            "CPU" => "Процессор",
            "GPU" => "Видеокарта",
            "RAM" => "Оперативная память",
            "SSD" => "SSD накопитель",
            "HDD" => "Жесткий диск",
            "PSU" => "Блок питания",
            _ => type
        };
    }
}