<!--_Benefits-->
@using WebShopV3.Models.DTO
@{
    var categoryData = ViewBag.ComponentCategoriesData as List<CategoryData> ?? new List<CategoryData>();
    var totalComponents = ViewBag.TotalComponents ?? 0;
    var totalTypes = ViewBag.TotalTypes ?? 0;
}

<section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-900 to-blue-500/5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Комплектующие
            </h2>
            <p class="text-xl text-gray-400">
                Все необходимое для сборки вашего ПК
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            @{
                var categoryConfig = new Dictionary<string, (string Name, string Desc, string Gradient, string Icon, string GlowColor)>
                        {
                        { "CPU", ("Процессоры", "Intel & AMD", "from-blue-500 via-blue-400 to-cyan-500", "⚡", "rgba(59, 130, 246, 0.3)") },
                        { "GPU", ("Видеокарты", "NVIDIA & AMD", "from-purple-500 via-purple-400 to-pink-500", "🎮", "rgba(168, 85, 247, 0.3)") },
                        { "RAM", ("Память", "DDR4/DDR5", "from-green-500 via-green-400 to-emerald-500", "💾", "rgba(16, 185, 129, 0.3)") },
                        { "SSD", ("Накопители", "SSD & HDD", "from-yellow-500 via-yellow-400 to-amber-500", "💿", "rgba(245, 158, 11, 0.3)") },
                        { "HDD", ("Жесткие диски", "SATA & SAS", "from-yellow-600 via-yellow-500 to-amber-600", "💿", "rgba(217, 119, 6, 0.3)") },
                        { "MB", ("Материнские платы", "ATX, mATX, ITX", "from-red-500 via-red-400 to-rose-500", "🔌", "rgba(244, 63, 94, 0.3)") },
                        { "PSU", ("Блоки питания", "Модульные и стандартные", "from-gray-700 via-gray-600 to-gray-700", "⚡", "rgba(75, 85, 99, 0.3)") },
                        { "CASE", ("Корпуса", "ATX, mATX, Mini-ITX", "from-indigo-500 via-indigo-400 to-violet-500", "📦", "rgba(99, 102, 241, 0.3)") }
                        };

                foreach (var category in categoryData)
                {
                    if (categoryConfig.ContainsKey(category.Type))
                    {
                        var config = categoryConfig[category.Type];

                        <a asp-action="ComponentDetails" asp-controller="Home" asp-route-id="@category.Component.Id"
                           class="group relative bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-6 text-center transition-all duration-500 hover:-translate-y-3 overflow-hidden card-hover">

                            <!-- Анимированный градиентный фон -->
                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                                 style="background: radial-gradient(circle at center, @config.GlowColor 0%, transparent 70%)"></div>

                            <!-- Светящаяся рамка -->
                            <div class="absolute inset-0 rounded-3xl border border-transparent group-hover:border-opacity-30 transition-all duration-500"
                                 style="border-image: linear-gradient(to bottom right, var(--tw-gradient-stops)) 1; --tw-gradient-from: @config.Gradient.Split(' ')[0]; --tw-gradient-to: @config.Gradient.Split(' ')[2];"></div>

                            <!-- Иконка категории -->
                            <div class="relative w-24 h-24 mx-auto mb-6">
                                <!-- Фон со свечением -->
                                <div class="absolute inset-0 bg-gradient-to-r @config.Gradient rounded-2xl blur-xl opacity-30 group-hover:opacity-50 transition duration-500"></div>

                                <!-- Основная иконка -->
                                <div class="relative w-full h-full bg-gradient-to-br @config.Gradient rounded-2xl flex items-center justify-center
                                                        group-hover:scale-110 group-hover:rotate-3 transition-all duration-500 shadow-xl">
                                    <span class="text-4xl drop-shadow-lg">@config.Icon</span>

                                    <!-- Анимированные элементы -->
                                    <div class="absolute -top-2 -right-2 w-4 h-4 bg-gradient-to-r @config.Gradient rounded-full animate-pulse"></div>
                                    <div class="absolute -bottom-2 -left-2 w-3 h-3 bg-gradient-to-r @config.Gradient rounded-full animate-pulse delay-300"></div>
                                </div>
                            </div>

                            <!-- Название категории -->
                            <h3 class="relative text-xl font-bold mb-2 bg-gradient-to-r @config.Gradient bg-clip-text text-transparent
                                                   group-hover:scale-105 transition-transform duration-300">
                                @config.Name
                            </h3>

                            <!-- Описание -->
                            <p class="text-gray-400 text-sm mb-6 relative">
                                <span class="relative inline-block">
                                    @config.Desc
                                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r @config.Gradient group-hover:w-full transition-all duration-300"></span>
                                </span>
                            </p>

                            @if (category.Component != null)
                            {
                                var component = category.Component;
                                var componentName = component.Name.Length > 20 ? component.Name.Substring(0, 17) + "..." : component.Name;

                                <div class="relative mt-6 pt-6 border-t border-gray-700/50 group-hover:border-opacity-30 transition-colors duration-300"
                                     style="border-image: linear-gradient(to right, transparent, @config.Gradient.Split(' ')[0], transparent) 1;">

                                    <!-- Название товара -->
                                    <div class="mb-4">
                                        <p class="text-sm font-semibold text-white truncate mb-2" title="@component.Name">
                                            @componentName
                                        </p>

                                        <!-- Цена -->
                                        <div class="flex items-center justify-center gap-2">
                                            <span class="text-2xl font-bold bg-gradient-to-r @config.Gradient bg-clip-text text-transparent">
                                                @component.Price.ToString("N0") ₽
                                            </span>

                                            <!-- Бейдж скидки -->
                                            @if (component.Price < 100000)
                                            {
                                                <span class="px-2 py-1 text-xs bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-full font-bold">
                                                    -@((int)((100000 - component.Price) / 1000))%
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Статус и дополнительные данные -->
                                    <div class="space-y-3">
                                        <!-- Статус наличия -->
                                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full backdrop-blur-sm
                                                                  @(component.Quantity > 0 ? "bg-green-500/20" : "bg-red-500/20")">
                                            <span class="relative flex h-2 w-2">
                                                @if (component.Quantity > 0)
                                                {
                                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                                                }
                                                else
                                                {
                                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                                                }
                                            </span>
                                            <span class="text-sm font-medium @(component.Quantity > 0 ? "text-green-400" : "text-red-400")">
                                                @(component.Quantity > 0 ? "В наличии" : "Нет в наличии")
                                            </span>
                                            <span class="text-xs text-gray-400">• @component.Quantity шт</span>
                                        </div>

                                        <!-- Быстрый просмотр -->
                                        <div class="mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                            <span class="inline-flex items-center gap-1 text-xs text-gray-400">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                Нажмите для деталей
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="relative mt-6 pt-6 border-t border-gray-700/50">
                                    <p class="text-sm text-gray-500 italic">Товары скоро появятся</p>
                                    <p class="text-xs text-gray-600 mt-2">Ожидайте обновления</p>
                                </div>
                            }

                            <!-- Бейдж категории в углу -->
                            <div class="absolute top-4 right-4">
                                <span class="inline-flex items-center gap-1 px-3 py-1 bg-gradient-to-r @config.Gradient text-white text-xs font-bold rounded-full">
                                    @category.Type
                                </span>
                            </div>
                        </a>
                    }
                }

                <!-- Карточка "Все комплектующие" -->
                @if (categoryData.Count < 8)
                {
                    <a href="/Home/Catalog?productType=components"
                       class="group relative bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-6 text-center transition-all duration-500 hover:-translate-y-3 overflow-hidden card-hover">

                        <!-- Анимированные звездочки -->
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
                            <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-blue-400 rounded-full animate-ping"></div>
                            <div class="absolute top-3/4 left-1/3 w-1 h-1 bg-purple-400 rounded-full animate-ping delay-300"></div>
                            <div class="absolute top-1/3 left-3/4 w-1.5 h-1.5 bg-cyan-400 rounded-full animate-ping delay-700"></div>
                        </div>

                        <!-- Иконка -->
                        <div class="relative w-24 h-24 mx-auto mb-6">
                            <div class="absolute inset-0 bg-gradient-to-r from-blue-500 via-cyan-400 to-blue-600 rounded-2xl blur-xl opacity-30 group-hover:opacity-50 transition duration-500"></div>
                            <div class="relative w-full h-full bg-gradient-to-br from-blue-500 via-cyan-400 to-blue-600 rounded-2xl flex items-center justify-center
                                                group-hover:scale-110 group-hover:rotate-12 transition-all duration-500 shadow-xl animate-pulse-slow">
                                <span class="text-4xl drop-shadow-lg">📦</span>
                            </div>
                        </div>

                        <!-- Заголовок -->
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:bg-gradient-to-r group-hover:from-blue-400 group-hover:to-cyan-400 group-hover:bg-clip-text group-hover:text-transparent transition-all duration-300">
                            Все комплектующие
                        </h3>
                        <p class="text-gray-400 text-sm mb-6">Более 1000 товаров</p>

                        <!-- Информация -->
                        <div class="mt-6 pt-6 border-t border-gray-700/50 group-hover:border-blue-500/30 transition-colors duration-300">
                            <p class="text-sm font-medium text-blue-300 mb-3">Смотреть все категории</p>

                            <!-- Анимированная стрелка -->
                            <div class="relative w-12 h-12 mx-auto">
                                <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full blur opacity-30 group-hover:opacity-50 transition duration-300"></div>
                                <div class="relative w-full h-full bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center
                                                    group-hover:scale-110 group-hover:rotate-90 transition-all duration-500">
                                    <span class="text-xl font-bold">→</span>
                                </div>
                            </div>

                            <!-- Подсказка -->
                            <p class="text-xs text-gray-500 mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                Перейти в каталог
                            </p>
                        </div>

                        <!-- Бейдж -->
                        <div class="absolute top-4 right-4">
                            <span class="inline-flex items-center gap-1 px-3 py-1 bg-gradient-to-r from-blue-500 to-cyan-500 text-white text-xs font-bold rounded-full">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                ВСЕ
                            </span>
                        </div>
                    </a>
                }
            }
        </div>

        <!-- Статистика под категориями -->
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-gray-900/50 rounded-xl p-4 text-center border border-gray-700/50">
                <div class="text-2xl font-bold text-white mb-1">
                    @totalComponents
                </div>
                <div class="text-sm text-gray-400">Товаров в наличии</div>
            </div>

            <div class="bg-gray-900/50 rounded-xl p-4 text-center border border-gray-700/50">
                <div class="text-2xl font-bold text-white mb-1">
                    @totalTypes
                </div>
                <div class="text-sm text-gray-400">Категорий</div>
            </div>

            <div class="bg-gray-900/50 rounded-xl p-4 text-center border border-gray-700/50">
                <div class="text-2xl font-bold text-white mb-1">24/7</div>
                <div class="text-sm text-gray-400">Поддержка</div>
            </div>

            <div class="bg-gray-900/50 rounded-xl p-4 text-center border border-gray-700/50">
                <div class="text-2xl font-bold text-white mb-1">100%</div>
                <div class="text-sm text-gray-400">Гарантия качества</div>
            </div>
        </div>
    </div>
</section>