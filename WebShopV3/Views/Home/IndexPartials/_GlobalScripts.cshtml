<script>
            document.querySelectorAll('.stats-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateY = ((x - centerX) / centerX) * 3;
                const rotateX = ((centerY - y) / centerY) * 3;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-16px)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
                setTimeout(() => {
                    card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(-4px)';
                }, 50);
            });
        });

        // Анимация счетчиков статистики
        function animateCounters() {
            const counters = document.querySelectorAll('.stats-counter');

            counters.forEach(counter => {
                const target = parseFloat(counter.dataset.target);
                const isPercentage = counter.textContent.includes('%');
                const isRange = counter.textContent.includes('-');
                const isYears = counter.textContent.includes('год');

                if (isRange || isYears) return; // Не анимируем диапазоны и годы

                let current = 0;
                const duration = 1500;
                const increment = target / (duration / 16);

                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }

                    if (isPercentage) {
                        counter.textContent = current.toFixed(1) + '%';
                    } else {
                        counter.textContent = Math.floor(current) + '+';
                    }
                }, 16);
            });
        }

        // Запуск анимации при скролле
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounters();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        observer.observe(document.querySelector('.grid.grid-cols-2'));

        // Параллакс для иконок статистики
        document.querySelectorAll('.stats-card').forEach(card => {
            const iconContainer = card.querySelector('.relative.w-16');

            card.addEventListener('mousemove', (e) => {
                if (!iconContainer) return;

                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const moveX = (x - centerX) / 15;
                const moveY = (y - centerY) / 15;

                iconContainer.style.transform = `translate(${moveX}px, ${moveY}px) scale(1.1) rotate(12deg)`;
            });

            card.addEventListener('mouseleave', () => {
                if (iconContainer) {
                    iconContainer.style.transform = 'translate(0, 0) scale(1) rotate(0)';
                }
            });
        });

        // Интерактивность для кнопок социальных сетей
        document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();

                // Анимация нажатия
                this.style.transform = 'scale(0.9)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 200);

                // Можно добавить логику открытия социальных сетей
                console.log('Открытие социальной сети');
            });
        });

        // Анимация при наведении на контакты
        document.querySelectorAll('.grid.grid-cols-3 > div').forEach(contact => {
            contact.addEventListener('mouseenter', () => {
                contact.style.transform = 'translateY(-5px)';
            });

            contact.addEventListener('mouseleave', () => {
                contact.style.transform = 'translateY(0)';
            });
        });
    // 3D эффект при движении мыши
    document.querySelectorAll('.card-hover').forEach(card => {
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateY = ((x - centerX) / centerX) * 3;
            const rotateX = ((centerY - y) / centerY) * 3;

            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-12px)`;
        });

        card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
            setTimeout(() => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(-3px)';
            }, 50);
        });
    });

    // Параллакс эффект для иконок
    document.querySelectorAll('.card-hover').forEach(card => {
        const icon = card.querySelector('.relative.w-24');

        card.addEventListener('mousemove', (e) => {
            if (!icon) return;

            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = (x - centerX) / 20;
            const moveY = (y - centerY) / 20;

            icon.style.transform = `translate(${moveX}px, ${moveY}px)`;
        });

        card.addEventListener('mouseleave', () => {
            if (icon) {
                icon.style.transform = 'translate(0, 0)';
            }
        });
    });

        // Интерактивность для карточек типов сборок
        document.querySelectorAll('.grid.grid-cols-2.gap-4.mb-8 > div').forEach(card => {
            card.addEventListener('click', function() {
                // Снимаем активность со всех карточек
                document.querySelectorAll('.grid.grid-cols-2.gap-4.mb-8 > div').forEach(c => {
                    c.classList.remove('ring-2', 'ring-purple-500');
                    c.querySelector('.text-sm').classList.remove('text-white', 'font-bold');
                });

                // Добавляем активность текущей
                this.classList.add('ring-2', 'ring-purple-500');
                this.querySelector('.text-sm').classList.add('text-white', 'font-bold');

                // Можно добавить логику загрузки конфигурации
                const type = this.querySelector('.font-bold').textContent;
                console.log(`Выбрана сборка: ${type}`);
            });
        });

        // Интерактивность для кнопок целей
        document.querySelectorAll('.flex.flex-wrap.gap-3 button').forEach(button => {
            button.addEventListener('click', function() {
                // Снимаем активность со всех кнопок
                document.querySelectorAll('.flex.flex-wrap.gap-3 button').forEach(b => {
                    b.classList.remove('ring-2', 'ring-purple-500');
                });

                // Добавляем активность текущей
                this.classList.add('ring-2', 'ring-purple-500');

                // Можно добавить логику фильтрации
                const goal = this.textContent.trim();
                console.log(`Выбрана цель: ${goal}`);
            });
        });

        // Параллакс эффект для конфигуратора
        const configurator = document.getElementById('configurator');
        if (configurator) {
            configurator.addEventListener('mousemove', (e) => {
                const cards = configurator.querySelectorAll('.grid.grid-cols-2.gap-4.mb-8 > div');
                const rect = configurator.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                cards.forEach((card, index) => {
                    const moveX = ((x - centerX) / centerX) * 10;
                    const moveY = ((y - centerY) / centerY) * 10;
                    const delay = index * 100;

                    setTimeout(() => {
                        card.style.transform = `translate(${moveX}px, ${moveY}px)`;
                    }, delay);
                });
            });

            configurator.addEventListener('mouseleave', () => {
                const cards = configurator.querySelectorAll('.grid.grid-cols-2.gap-4.mb-8 > div');
                cards.forEach(card => {
                    card.style.transform = 'translate(0, 0)';
                });
            });
        }

        // Анимация счетчика пользователей
        function animateCounter() {
            const counter = document.querySelector('.text-green-400');
            if (!counter) return;

            let count = 1234;
            const target = Math.floor(Math.random() * 500) + 1500; // Случайное число для демонстрации
            const duration = 2000;
            const increment = (target - count) / (duration / 16);

            const timer = setInterval(() => {
                count += increment;
                if (count >= target) {
                    count = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(count).toLocaleString();
            }, 16);
        }

        // Запускаем счетчик при входе в зону видимости
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounter();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        observer.observe(document.getElementById('configurator'));

            // 3D эффект для карточек при движении мыши
        document.querySelectorAll('.computer-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateY = ((x - centerX) / centerX) * 3;
                const rotateX = ((centerY - y) / centerY) * 3;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-16px)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
                setTimeout(() => {
                    card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(-4px)';
                }, 50);
            });
        });

        // Обработка добавления в корзину
        document.querySelectorAll('button[data-computer-id]').forEach(button => {
            button.addEventListener('click', function() {
                const computerId = this.dataset.computerId;
                const computerName = this.dataset.computerName;
                const computerPrice = this.dataset.computerPrice;

                // Временная анимация
                const originalContent = this.innerHTML;
                this.innerHTML = `
                    <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                `;

                // Симуляция AJAX запроса
                setTimeout(() => {
                    this.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    `;

                    // Показываем уведомление
                    showNotification(`Компьютер "${computerName}" добавлен в корзину!`);

                    setTimeout(() => {
                        this.innerHTML = originalContent;
                    }, 1500);
                }, 500);
            });
        });

        // Функция показа уведомления
        function showNotification(message) {
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-6 py-4 rounded-xl shadow-2xl z-50 transform translate-x-full animate-slide-in';
            notification.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>${message}</span>
                </div>
            `;

            document.body.appendChild(notification);

            setTimeout(() => {
                notification.classList.remove('animate-slide-in');
                notification.classList.add('animate-slide-out');
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        // Анимация для уведомлений
        const style = document.createElement('style');
        style.textContent = `
        @@keyframes slide-in {
            from {
                transform: translateX(100%);
            }
            to {
                transform: translateX(0);
            }
        }

        @@keyframes slide-out {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(100%);
            }
        }

        .animate-slide-in {
            animation: slide-in 0.3s ease-out forwards;
        }

        .animate-slide-out {
            animation: slide-out 0.3s ease-out forwards;
        }
        `;
        document.head.appendChild(style);

        // Параллакс для изображений
        document.querySelectorAll('.computer-card').forEach(card => {
            const img = card.querySelector('img');
            if (!img) return;

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const moveX = (x - centerX) / 20;
                const moveY = (y - centerY) / 20;

                img.style.transform = `scale(1.1) translate(${moveX}px, ${moveY}px)`;
            });

            card.addEventListener('mouseleave', () => {
                img.style.transform = 'scale(1.1) translate(0, 0)';
            });
        });

            // 3D эффект для карточек при движении мыши
        document.querySelectorAll('.review-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateY = ((x - centerX) / centerX) * 3;
                const rotateX = ((centerY - y) / centerY) * 3;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-16px)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
                setTimeout(() => {
                    card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(-4px)';
                }, 50);
            });
        });

        // Обработка лайков
        document.querySelectorAll('button.group\\/like').forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();

                const span = this.querySelector('span');
                let count = parseInt(span.textContent);

                if (this.classList.contains('liked')) {
                    count--;
                    this.classList.remove('liked', 'text-red-500', 'bg-red-500/10');
                    this.classList.add('text-gray-400', 'bg-gray-800/50');

                    const svg = this.querySelector('svg');
                    svg.innerHTML = `
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    `;
                } else {
                    count++;
                    this.classList.add('liked', 'text-red-500', 'bg-red-500/10');
                    this.classList.remove('text-gray-400', 'bg-gray-800/50');

                    const svg = this.querySelector('svg');
                    svg.innerHTML = `
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                              fill="currentColor"/>
                    `;
                }

                span.textContent = count;

                // Анимация
                this.style.transform = 'scale(1.1)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 200);
            });
        });

        // Анимация счетчиков статистики
        function animateStats() {
            const stats = [
                { element: document.querySelectorAll('.text-4xl, .text-5xl')[0], target: 1234 },
                { element: document.querySelectorAll('.text-4xl, .text-5xl')[1], target: 4.9 },
                { element: document.querySelectorAll('.text-4xl, .text-5xl')[2], target: 98 },
                { element: document.querySelectorAll('.text-4xl, .text-5xl')[3], target: 24 }
            ];

            stats.forEach((stat, index) => {
                let current = 0;
                const duration = 1500;
                const increment = stat.target / (duration / 16);

                const timer = setInterval(() => {
                    current += increment;
                    if (current >= stat.target) {
                        current = stat.target;
                        clearInterval(timer);
                    }

                    if (index === 1) { // Для рейтинга
                        stat.element.textContent = current.toFixed(1);
                    } else if (index === 2) { // Для процентов
                        stat.element.textContent = Math.floor(current) + '%';
                    } else if (index === 3) { // Для 24/7
                        stat.element.textContent = '24/7';
                    } else {
                        stat.element.textContent = Math.floor(current) + '+';
                    }
                }, 16);
            });
        }

        // Запуск анимации при скролле
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateStats();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        observer.observe(document.querySelector('.grid.grid-cols-2'));

        // Параллакс для аватаров
        document.querySelectorAll('.review-card').forEach(card => {
            const avatar = card.querySelector('.relative.mr-5');

            card.addEventListener('mousemove', (e) => {
                if (!avatar) return;

                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const moveX = (x - centerX) / 15;
                const moveY = (y - centerY) / 15;

                avatar.style.transform = `translate(${moveX}px, ${moveY}px)`;
            });

            card.addEventListener('mouseleave', () => {
                if (avatar) {
                    avatar.style.transform = 'translate(0, 0)';
                }
            });
        });
</script>