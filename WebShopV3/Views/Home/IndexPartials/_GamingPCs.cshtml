@model List<WebShopV3.Models.Computer>
<!-- Gaming PCs Section с градиентным фоном -->
<section id="gaming" class="py-24 relative overflow-hidden">
    <!-- Анимированный фон -->
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-gray-900 to-green-500/10 animate-gradient-xy"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-500/5 via-transparent to-green-500/5"></div>

        <!-- Анимированные частицы -->
        <div class="absolute top-20 left-1/4 w-64 h-64 bg-gradient-to-r from-blue-500/15 to-cyan-500/15 rounded-full blur-3xl animate-pulse-slow"></div>
        <div class="absolute bottom-20 right-1/4 w-96 h-96 bg-gradient-to-r from-green-500/10 to-emerald-500/10 rounded-full blur-3xl animate-pulse-slow delay-1000"></div>

        <!-- Плавающие элементы -->
        <div class="absolute top-1/3 left-20 w-3 h-3 bg-blue-500 rounded-full animate-bounce-slow opacity-30"></div>
        <div class="absolute top-1/2 right-32 w-2 h-2 bg-green-500 rounded-full animate-bounce-slow delay-300 opacity-20"></div>
        <div class="absolute bottom-1/4 left-1/3 w-4 h-4 bg-cyan-500 rounded-full animate-bounce-slow delay-700 opacity-25"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Заголовок -->
        <div class="text-center mb-20">
            <div class="relative inline-block mb-6">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 via-cyan-500 to-green-500 rounded-lg blur opacity-30 group-hover:opacity-70 transition duration-1000 animate-gradient"></div>
                <h2 class="relative text-4xl md:text-5xl font-bold text-white mb-4">
                    <span class="bg-gradient-to-r from-blue-400 via-cyan-400 to-green-400 bg-clip-text text-transparent">
                        Популярные компьютеры
                    </span>
                </h2>
            </div>

            <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
                Лучшие игровые и рабочие станции, собранные из проверенных компонентов с гарантией качества
            </p>

            <!-- Декоративная линия -->
            <div class="flex items-center justify-center gap-4">
                <div class="w-16 h-0.5 bg-gradient-to-r from-transparent to-blue-500"></div>
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
                    <div class="w-2 h-2 bg-cyan-500 rounded-full animate-pulse delay-300"></div>
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse delay-600"></div>
                </div>
                <div class="w-16 h-0.5 bg-gradient-to-l from-transparent to-green-500"></div>
            </div>
        </div>

        <!-- Сетка компьютеров -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var computer in Model)
            {
                <div class="group relative bg-gradient-to-br from-gray-900/90 to-gray-800/90 rounded-3xl p-6 transition-all duration-500 hover:-translate-y-4 overflow-hidden border border-gray-700/50 backdrop-blur-xl computer-card">
                    <!-- Анимированный градиентный фон -->
                    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-transparent to-green-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                    <!-- Светящаяся рамка -->
                    <div class="absolute inset-0 rounded-3xl border-2 border-transparent group-hover:border-green-500/30 transition-all duration-500"></div>

                    <!-- Изображение -->
                    <div class="relative overflow-hidden rounded-2xl mb-6 h-56">
                        @if (!string.IsNullOrEmpty(computer.ImageUrl))
                        {
                            <img src="/Images/computers/@computer.ImageUrl"
                                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                 alt="@computer.Name"
                                 loading="lazy">

                            <!-- Градиентная полоска внизу -->
                            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 via-cyan-500 to-green-500 z-10"></div>
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-700 rounded-2xl flex flex-col items-center justify-center">
                                <div class="text-5xl mb-4">🖥️</div>
                                <span class="text-gray-500 text-sm">Изображение отсутствует</span>
                            </div>
                        }

                        <!-- Бейджи -->
                        <div class="absolute top-4 left-4 flex flex-col gap-2">
                            @if (computer.Price < 150000)
                            {
                                <div class="inline-flex items-center gap-1 bg-gradient-to-r from-green-500 to-emerald-500 text-gray-900 px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
                                    </svg>
                                    ХИТ ПРОДАЖ
                                </div>
                            }

                            @if (computer.Quantity > 0)
                            {
                                <div class="inline-flex items-center gap-1 bg-gradient-to-r from-blue-500 to-cyan-500 text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                                    </span>
                                    В наличии
                                </div>
                            }
                            else
                            {
                                <div class="inline-flex items-center gap-1 bg-gradient-to-r from-red-500 to-orange-500 text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                                    <span class="relative flex h-2 w-2">
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                                    </span>
                                    Под заказ
                                </div>
                            }
                        </div>

                        <!-- Кнопка быстрого просмотра -->
                        <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <button class="w-10 h-10 flex items-center justify-center bg-gray-900/80 hover:bg-blue-500 text-gray-300 hover:text-white rounded-full backdrop-blur-sm transition-all duration-300"
                                    onclick="window.location.href='/Home/ComputerDetails/@computer.Id'">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Название и описание -->
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-green-400 transition-colors duration-300">
                            <a href="/Home/ComputerDetails/@computer.Id" class="hover:underline decoration-green-500/50">
                                @computer.Name
                            </a>
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed line-clamp-2 group-hover:text-gray-300 transition-colors duration-300">
                            @computer.Description
                        </p>
                    </div>

                    <!-- Характеристики -->
                    <div class="grid grid-cols-2 gap-3 mb-6">
                        <div class="flex items-center gap-2 text-xs text-gray-400">
                            <div class="w-6 h-6 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-lg flex items-center justify-center">
                                <svg class="w-3 h-3 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span>Intel i7</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-400">
                            <div class="w-6 h-6 bg-gradient-to-br from-purple-500/20 to-pink-500/20 rounded-lg flex items-center justify-center">
                                <svg class="w-3 h-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span>RTX 3070</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-400">
                            <div class="w-6 h-6 bg-gradient-to-br from-green-500/20 to-emerald-500/20 rounded-lg flex items-center justify-center">
                                <svg class="w-3 h-3 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span>16 ГБ RAM</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-400">
                            <div class="w-6 h-6 bg-gradient-to-br from-yellow-500/20 to-amber-500/20 rounded-lg flex items-center justify-center">
                                <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
                                    <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span>1 ТБ SSD</span>
                        </div>
                    </div>

                    <!-- Цена и количество -->
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <div class="text-2xl font-bold bg-gradient-to-r from-green-500 to-emerald-500 bg-clip-text text-transparent">
                                @computer.Price.ToString("C")
                            </div>
                            @if (computer.Price < 150000)
                            {
                                <div class="text-sm text-gray-500 line-through">
                                    @((computer.Price * 1.2m).ToString("C"))
                                </div>
                            }
                        </div>

                        <div class="text-sm text-gray-400">
                            <span class="font-medium text-white">@computer.Quantity шт.</span> доступно
                        </div>
                    </div>

                    <!-- Кнопки действий -->
                    <div class="flex gap-3">
                        <a asp-controller="Home" asp-action="ComputerDetails" asp-route-id="@computer.Id"
                           class="flex-1 bg-gradient-to-r from-green-500 to-emerald-500 text-gray-900 py-3 rounded-xl font-bold text-center
                                          hover:shadow-2xl hover:shadow-green-500/40 transform hover:scale-105 transition-all duration-300
                                          flex items-center justify-center gap-2 group/btn">
                            <svg class="w-5 h-5 group-hover/btn:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Подробнее
                        </a>

                        <button class="w-14 flex items-center justify-center bg-gradient-to-r from-blue-500 to-cyan-500 text-gray-900 rounded-xl font-bold
                                              hover:shadow-2xl hover:shadow-blue-500/40 transform hover:scale-105 transition-all duration-300 group/add"
                                data-computer-id="@computer.Id"
                                data-computer-name="@computer.Name"
                                data-computer-price="@computer.Price">
                            <span class="group-hover/add:scale-110 transition-transform duration-300">🛒</span>
                        </button>
                    </div>

                    <!-- Рейтинг -->
                    <div class="absolute bottom-24 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="flex items-center gap-1 text-yellow-400 text-sm">
                            <span>★</span>
                            <span>★</span>
                            <span>★</span>
                            <span>★</span>
                            <span class="text-gray-600">★</span>
                            <span class="text-gray-400 text-xs">4.2</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Кнопка "Смотреть все" -->
        <div class="text-center mt-16">
            <div class="relative inline-block group">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 via-cyan-500 to-green-500 rounded-2xl blur opacity-30
                            group-hover:opacity-70 transition-opacity duration-500 animate-gradient"></div>

                <a asp-controller="Home" asp-action="Catalog"
                   class="relative border-2 border-transparent bg-gradient-to-r from-blue-500 via-cyan-500 to-green-500 text-gray-900 px-10 py-4
                          rounded-xl font-bold text-lg hover:shadow-2xl hover:shadow-green-500/30 transform hover:scale-105 transition-all duration-500
                          inline-flex items-center justify-center gap-3 group/btn overflow-hidden">

                    <!-- Эффект свечения -->
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent translate-x-[-100%]
                                group-hover/btn:translate-x-[100%] transition-transform duration-1000"></div>

                    <span class="text-2xl group-hover/btn:rotate-12 transition-transform duration-300">👀</span>
                    <span>Смотреть все компьютеры</span>
                    <svg class="w-6 h-6 group-hover/btn:translate-x-2 transition-transform duration-300"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>

            <!-- Статистика -->
            <div class="mt-10 flex flex-wrap items-center justify-center gap-8 text-sm text-gray-500">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                    <span>Более <span class="text-white font-bold">@(Model.Count() * 15)</span> компьютеров в каталоге</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse delay-300"></div>
                    <span>Средний рейтинг: <span class="text-white font-bold">4.5</span>/5</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-cyan-500 rounded-full animate-pulse delay-600"></div>
                    <span>Гарантия: <span class="text-white font-bold">3 года</span></span>
                </div>
            </div>
        </div>
    </div>
</section>