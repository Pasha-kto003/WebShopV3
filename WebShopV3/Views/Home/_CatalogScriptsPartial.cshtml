// Предотвращаем множественные submit'ы форм
document.addEventListener('submit', function(e) {
    if (e.target.tagName === 'FORM') {
        const submitBtn = e.target.querySelector('[type="submit"]');
        if (submitBtn && submitBtn.disabled) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
        if (submitBtn) {
            submitBtn.disabled = true;
            setTimeout(() => {
                submitBtn.disabled = false;
            }, 2000);
        }
    }
}, true); // Используем capture phase

// Ловим клики на кнопках и предотвращаем множественные нажатия
let lastClickTime = 0;
document.addEventListener('click', function(e) {
    const now = Date.now();
    if (now - lastClickTime < 500) { // 500ms cooldown
        e.preventDefault();
        e.stopPropagation();
        console.log('Click too fast, preventing...');
        return false;
    }
    lastClickTime = now;
    
    // Для кнопок фильтров добавляем дополнительную защиту
    if (e.target.closest('.product-type-btn') || 
        e.target.closest('#cardViewBtn') || 
        e.target.closest('#listViewBtn') ||
        e.target.closest('#resetFilters')) {
        
        const element = e.target.closest('button');
        if (element) {
            element.disabled = true;
            setTimeout(() => {
                element.disabled = false;
            }, 1000);
        }
    }
}, true);
</script>