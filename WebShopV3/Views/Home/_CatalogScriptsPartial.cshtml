    // Инициализируем CatalogSearch
    if (typeof CatalogSearch !== 'undefined') {
        console.log('Creating CatalogSearch instance...');
        window.catalogSearchInstance = new CatalogSearch();
        window.catalogSearch = window.catalogSearchInstance; // для обратной совместимости
        console.log('CatalogSearch initialized successfully');
        
        // Одноразовый поиск при загрузке
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.toString()) {
            console.log('URL has params, performing initial search...');
            // Используем setTimeout для гарантии что все инициализировано
