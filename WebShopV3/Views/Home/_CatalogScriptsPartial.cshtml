<script>
    // Класс для управления поиском в каталоге
// Класс для управления поиском в каталоге
class CatalogSearch {
    constructor() {
        this.currentProductType = document.getElementById('currentProductType')?.value || 'all';
        this.isLoading = false;
        this.debounceTimeout = null;
        this.debounceDelay = 500; // Увеличиваем задержку
        this.lastSearchParams = null; // Добавляем кэш последних параметров
        this.isInitialized = false; // Флаг инициализации
        
        console.log('CatalogSearch constructor called');
        
        this.initializeFromURL();
        this.initialize();
    }

    initializeFromURL() {
        const urlParams = new URLSearchParams(window.location.search);
        
        // Устанавливаем значения из URL
        const search = urlParams.get('search');
        const sortBy = urlParams.get('sortBy');
        const componentType = urlParams.get('componentType');
        const minPrice = urlParams.get('minPrice');
        const maxPrice = urlParams.get('maxPrice');
        const productType = urlParams.get('productType');
        
        console.log('URL params:', {
            search, sortBy, componentType, minPrice, maxPrice, productType
        });
        
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const componentTypeFilter = document.getElementById('componentTypeFilter');
        const minPriceInput = document.getElementById('minPrice');
        const maxPriceInput = document.getElementById('maxPrice');
        
        if (search && searchInput) searchInput.value = search;
        if (sortBy && sortSelect) sortSelect.value = sortBy;
        if (componentType && componentTypeFilter) componentTypeFilter.value = componentType;
        if (minPrice && minPriceInput) minPriceInput.value = minPrice;
        if (maxPrice && maxPriceInput) maxPriceInput.value = maxPrice;
        if (productType) {
            this.currentProductType = productType;
            this.updateProductTypeButtons(productType);
        }
    }

    updateProductTypeButtons(productType) {
        document.querySelectorAll('.product-type-btn').forEach(btn => {
            const btnType = btn.dataset.productType;
            if (btnType === productType) {
                btn.classList.add('bg-primary', 'text-dark');
                btn.classList.remove('text-gray-400');
            } else {
                btn.classList.remove('bg-primary', 'text-dark');
                btn.classList.add('text-gray-400');
            }
        });
    }

initialize() {
    if (this.isInitialized) {
        console.log('CatalogSearch already initialized, skipping...');
        return;
    }
    
    console.log('Initializing CatalogSearch...');
    
    this.bindAllFilterEvents();
    this.initializeViewMode();
    this.updateSortSelect();
    
    // Проверяем, есть ли начальные параметры поиска
    const hasInitialParams = this.hasInitialSearchParams();
    if (hasInitialParams) {
        console.log('Found initial search params, performing search...');
        setTimeout(() => this.searchProducts(), 300);
    }
    
    this.isInitialized = true;
}

    hasInitialSearchParams() {
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const componentTypeFilter = document.getElementById('componentTypeFilter');
        const minPriceInput = document.getElementById('minPrice');
        const maxPriceInput = document.getElementById('maxPrice');
        
        return (
            (searchInput && searchInput.value.trim() !== '') ||
            (sortSelect && sortSelect.value !== 'default') ||
            (componentTypeFilter && componentTypeFilter.value !== 'all') ||
            (minPriceInput && minPriceInput.value !== '') ||
            (maxPriceInput && maxPriceInput.value !== '') ||
            this.currentProductType !== 'all'
        );
    }

   bindAllFilterEvents() {
    console.log('Binding filter events...');
    
    // Удаляем старые обработчики перед добавлением новых
    this.removeAllEventListeners();
    
    // Кнопки переключения типа товаров
    document.querySelectorAll('.product-type-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation(); // Останавливаем всплытие
            e.preventDefault();
            console.log('Product type button clicked:', e.currentTarget.dataset.productType);
            this.onProductTypeChange(e);
        });
    });

    // Кнопки переключения вида
    const cardViewBtn = document.getElementById('cardViewBtn');
    const listViewBtn = document.getElementById('listViewBtn');
    
    if (cardViewBtn) {
        cardViewBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            console.log('Card view button clicked');
            this.switchViewMode('cards');
        });
    }
    
    if (listViewBtn) {
        listViewBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            console.log('List view button clicked');
            this.switchViewMode('list');
        });
    }

    // Сортировка
    const sortSelect = document.getElementById('sortSelect');
    if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
            e.stopPropagation();
            console.log('Sort changed to:', sortSelect.value);
            this.debouncedSearch();
        });
    }

    // Поиск с debounce
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            e.stopPropagation();
            this.debouncedSearch();
        });
    }

    // Фильтр типа комплектующих
    const componentTypeFilter = document.getElementById('componentTypeFilter');
    if (componentTypeFilter) {
        componentTypeFilter.addEventListener('change', (e) => {
            e.stopPropagation();
            console.log('Component type changed:', e.target.value);
            this.debouncedSearch();
        });
    }

    // Фильтр цены с debounce
    const minPrice = document.getElementById('minPrice');
    if (minPrice) {
        minPrice.addEventListener('change', (e) => {
            e.stopPropagation();
            this.debouncedSearch();
        });
        
        minPrice.addEventListener('blur', (e) => {
            e.stopPropagation();
            this.debouncedSearch();
        });
    }

    const maxPrice = document.getElementById('maxPrice');
    if (maxPrice) {
        maxPrice.addEventListener('change', (e) => {
            e.stopPropagation();
            this.debouncedSearch();
        });
        
        maxPrice.addEventListener('blur', (e) => {
            e.stopPropagation();
            this.debouncedSearch();
        });
    }

    // Кнопка сброса фильтров
    const resetBtn = document.getElementById('resetFilters');
    if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            console.log('Reset filters clicked');
            this.resetFilters();
        });
    }
}

// Добавьте метод для удаления всех обработчиков
removeAllEventListeners() {
    const elements = [
        '.product-type-btn',
        '#cardViewBtn',
        '#listViewBtn',
        '#sortSelect',
        '#searchInput',
        '#componentTypeFilter',
        '#minPrice',
        '#maxPrice',
        '#resetFilters'
    ];
    
    elements.forEach(selector => {
        const element = selector.startsWith('#') 
            ? document.getElementById(selector.substring(1))
            : document.querySelectorAll(selector);
        
        if (element) {
            if (element instanceof NodeList) {
                element.forEach(el => {
                    const newEl = el.cloneNode(true);
                    el.parentNode.replaceChild(newEl, el);
                });
            } else {
                const newEl = element.cloneNode(true);
                element.parentNode.replaceChild(newEl, element);
            }
        }
    });
}

// Добавьте метод debouncedSearch для централизованного debounce
debouncedSearch() {
    clearTimeout(this.debounceTimeout);
    this.debounceTimeout = setTimeout(() => {
        console.log('Debounced search triggered');
        this.searchProducts();
    }, this.debounceDelay);
}

onProductTypeChange(event) {
    const btn = event.currentTarget;
    const productType = btn.dataset.productType;
    
    console.log('Changing product type to:', productType);
    
    // Если уже выбран этот тип - не делаем ничего
    if (this.currentProductType === productType) {
        console.log('Product type already selected, skipping');
        return;
    }
    
    // Обновляем активную кнопку
    document.querySelectorAll('.product-type-btn').forEach(b => {
        b.classList.remove('bg-primary', 'text-dark');
        b.classList.add('text-gray-400');
    });
    btn.classList.add('bg-primary', 'text-dark');
    btn.classList.remove('text-gray-400');
    
    this.currentProductType = productType;
    
    // Используем debounce для поиска
    this.debouncedSearch();
}

switchViewMode(mode) {
    console.log('Switching view mode to:', mode);
    
    // Если уже выбран этот режим - не делаем ничего
    const currentMode = localStorage.getItem('catalogViewMode') || 'cards';
    if (currentMode === mode) {
        console.log('View mode already selected, skipping');
        return;
    }
    
    // Сохраняем в localStorage
    localStorage.setItem('catalogViewMode', mode);
    
    // Обновляем отображение без вызова searchProducts
    this.updateViewDisplay(mode);
}

updateViewDisplay(mode) {
    const cardsView = document.getElementById('cardsView');
    const listView = document.getElementById('listViewContainer');
    
    console.log('Updating view display for mode:', mode);
    
    if (mode === 'cards') {
        if (cardsView) {
            cardsView.classList.remove('hidden');
            console.log('Cards view shown');
        }
        if (listView) {
            listView.classList.add('hidden');
        }
        
        // Обновляем активную кнопку
        const cardBtn = document.getElementById('cardViewBtn');
        const listBtn = document.getElementById('listViewBtn');
        if (cardBtn) {
            cardBtn.classList.add('bg-primary', 'text-dark');
            cardBtn.classList.remove('text-gray-400');
        }
        if (listBtn) {
            listBtn.classList.remove('bg-primary', 'text-dark');
            listBtn.classList.add('text-gray-400');
        }
    } else {
        if (cardsView) {
            cardsView.classList.add('hidden');
        }
        if (listView) {
            listView.classList.remove('hidden');
            console.log('List view shown');
        }
        
        // Обновляем активную кнопку
        const cardBtn = document.getElementById('cardViewBtn');
        const listBtn = document.getElementById('listViewBtn');
        if (listBtn) {
            listBtn.classList.add('bg-primary', 'text-dark');
            listBtn.classList.remove('text-gray-400');
        }
        if (cardBtn) {
            cardBtn.classList.remove('bg-primary', 'text-dark');
            cardBtn.classList.add('text-gray-400');
        }
    }
}

     // Добавьте метод проверки изменились ли параметры
    haveParamsChanged(newParams) {
        if (!this.lastSearchParams) return true;
        
        const oldParams = new URLSearchParams(this.lastSearchParams);
        const newParamsObj = new URLSearchParams(newParams);
        
        // Сравниваем ключевые параметры
        const keys = ['search', 'sortBy', 'componentType', 'minPrice', 'maxPrice', 'productType'];
        for (let key of keys) {
            if (oldParams.get(key) !== newParamsObj.get(key)) {
                return true;
            }
        }
        
        return false;
    }

    async searchProducts() {
        if (this.isLoading) {
            console.log('Search already in progress, skipping...');
            return;
        }
        
        const params = this.getSearchParams();
        
        // Проверяем, изменились ли параметры
        if (!this.haveParamsChanged(params)) {
            console.log('Parameters not changed, skipping search');
            return;
        }
        
        console.log('Starting search with new params...');
        this.lastSearchParams = params; // Сохраняем параметры
        this.showLoading(true);
        
        try {
            const params = this.getSearchParams();
            
            // Формируем URL
            let url = '/Home/SearchProducts';
            if (params) {
                url += '?' + params;
            }
            
            console.log('Sending request to:', url);
            
            const response = await fetch(url, {
                method: 'GET',
                headers: {
                    'Accept': 'text/html',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin'
            });
            
            console.log('Response status:', response.status);
            console.log('Response headers:', [...response.headers.entries()]);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const contentType = response.headers.get('content-type');
            console.log('Content-Type:', contentType);
            
            // Проверяем, не вернул ли сервер JSON с ошибкой
            if (contentType && contentType.includes('application/json')) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Unknown server error');
            }
            
            const html = await response.text();
            console.log('Response length:', html.length);
            console.log('Response first 500 chars:', html.substring(0, 500));
            
            if (!html || html.trim() === '') {
                throw new Error('Empty response from server');
            }
            
            // Обновляем контент
            const productList = document.getElementById('productList');
            if (productList) {
                productList.innerHTML = html;
                
                // После загрузки контента инициализируем обработчики
                setTimeout(() => {
                    this.reinitializeAfterAjax();
                }, 100);
            }
            
            // Обновляем URL в браузере
            this.updateBrowserURL(params);
            
            console.log('Search completed successfully');
            
        } catch (error) {
            console.error('Error searching products:', error);
            this.showError('Ошибка при загрузке товаров: ' + error.message);
            
            // Показываем сообщение об ошибке
            const productList = document.getElementById('productList');
            if (productList) {
                productList.innerHTML = `
                    <div class="text-center py-16">
                        <div class="inline-flex items-center justify-center w-24 h-24 bg-red-500/20 rounded-full mb-6">
                            <svg class="w-12 h-12 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-3">Ошибка загрузки</h3>
                        <p class="text-gray-400 mb-6">${error.message}</p>
                        <button onclick="window.location.reload()" 
                                class="btn-gradient text-white px-8 py-3 rounded-xl font-bold hover:shadow-lg hover:shadow-primary/25 transition-all duration-300">
                            Обновить страницу
                        </button>
                    </div>
                `;
            }
        } finally {
            this.showLoading(false);
        }
    }

    getSearchParams() {
        const params = new URLSearchParams();
        
        // Собираем значения из полей
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const componentTypeFilter = document.getElementById('componentTypeFilter');
        const minPriceInput = document.getElementById('minPrice');
        const maxPriceInput = document.getElementById('maxPrice');
        
        const search = searchInput ? searchInput.value.trim() : '';
        const sortBy = sortSelect ? sortSelect.value : 'default';
        const componentType = componentTypeFilter ? componentTypeFilter.value : 'all';
        const minPrice = minPriceInput ? minPriceInput.value : '';
        const maxPrice = maxPriceInput ? maxPriceInput.value : '';
        const savedMode = localStorage.getItem('catalogViewMode') || 'cards';
        
        // Добавляем параметры
        if (search) params.append('search', search);
        if (sortBy && sortBy !== 'default') params.append('sortBy', sortBy);
        if (componentType && componentType !== 'all') params.append('componentType', componentType);
        if (minPrice) params.append('minPrice', minPrice);
        if (maxPrice) params.append('maxPrice', maxPrice);
        params.append('productType', this.currentProductType);
        params.append('viewMode', savedMode);
        
        const paramsObj = {
            search,
            sortBy,
            componentType,
            minPrice,
            maxPrice,
            productType: this.currentProductType,
            viewMode: savedMode,
            queryString: params.toString()
        };
        
        console.log('Search params:', paramsObj);
        
        return params.toString();
    }

    updateResultsCount() {
        // Считаем компьютеры и комплектующие
        const computerCards = document.querySelectorAll('.product-card').length;
        const total = computerCards;
        
        // Можно добавить более точный подсчет, если есть классы
        const computersCount = document.querySelectorAll('[data-product-type="Computer"]').length;
        const componentsCount = document.querySelectorAll('[data-product-type="Component"]').length;
        
        const actualTotal = computersCount + componentsCount;
        
        const resultsElement = document.getElementById('resultsCount');
        if (resultsElement) {
            if (actualTotal > 0) {
                resultsElement.textContent = `Найдено ${actualTotal} товаров (${computersCount} компьютеров, ${componentsCount} комплектующих)`;
            } else {
                resultsElement.textContent = `Найдено ${total} товаров`;
            }
        }
    }

    switchViewMode(mode) {
        console.log('Switching view mode to:', mode);
        
        // Сохраняем в localStorage
        localStorage.setItem('catalogViewMode', mode);
        
        // Обновляем отображение
        const cardsView = document.getElementById('cardsView');
        const listView = document.getElementById('listViewContainer');
        
        if (mode === 'cards') {
            if (cardsView) cardsView.classList.remove('hidden');
            if (listView) listView.classList.add('hidden');
            
            // Обновляем активную кнопку
            const cardBtn = document.getElementById('cardViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            if (cardBtn) {
                cardBtn.classList.add('bg-primary', 'text-dark');
                cardBtn.classList.remove('text-gray-400');
            }
            if (listBtn) {
                listBtn.classList.remove('bg-primary', 'text-dark');
                listBtn.classList.add('text-gray-400');
            }
        } else {
            if (cardsView) cardsView.classList.add('hidden');
            if (listView) listView.classList.remove('hidden');
            
            // Обновляем активную кнопку
            const cardBtn = document.getElementById('cardViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            if (listBtn) {
                listBtn.classList.add('bg-primary', 'text-dark');
                listBtn.classList.remove('text-gray-400');
            }
            if (cardBtn) {
                cardBtn.classList.remove('bg-primary', 'text-dark');
                cardBtn.classList.add('text-gray-400');
            }
        }
        
        // Обновляем URL с новым viewMode
        this.searchProducts();
    }

    updateViewMode() {
        const savedMode = localStorage.getItem('catalogViewMode') || 'cards';
        console.log('Updating view mode from localStorage:', savedMode);
        this.switchViewMode(savedMode);
    }

    initializeViewMode() {
        const savedMode = localStorage.getItem('catalogViewMode') || 'cards';
        console.log('Initializing view mode:', savedMode);
        
        // Устанавливаем правильные классы на кнопках
        const cardBtn = document.getElementById('cardViewBtn');
        const listBtn = document.getElementById('listViewBtn');
        
        if (savedMode === 'cards') {
            if (cardBtn) {
                cardBtn.classList.add('bg-primary', 'text-dark');
                cardBtn.classList.remove('text-gray-400');
            }
            if (listBtn) {
                listBtn.classList.remove('bg-primary', 'text-dark');
                listBtn.classList.add('text-gray-400');
            }
        } else {
            if (listBtn) {
                listBtn.classList.add('bg-primary', 'text-dark');
                listBtn.classList.remove('text-gray-400');
            }
            if (cardBtn) {
                cardBtn.classList.remove('bg-primary', 'text-dark');
                cardBtn.classList.add('text-gray-400');
            }
        }
    }

    updateSortSelect() {
        const sortSelect = document.getElementById('sortSelect');
        const currentSort = sortSelect?.dataset.sortBy;
        
        if (sortSelect && currentSort) {
            sortSelect.value = currentSort;
            console.log('Updated sort select to:', currentSort);
        }
    }

    resetFilters() {
        console.log('Resetting all filters...');
        
        // Сброс полей ввода
        const searchInput = document.getElementById('searchInput');
        const componentTypeFilter = document.getElementById('componentTypeFilter');
        const minPriceInput = document.getElementById('minPrice');
        const maxPriceInput = document.getElementById('maxPrice');
        const sortSelect = document.getElementById('sortSelect');
        
        if (searchInput) searchInput.value = '';
        if (componentTypeFilter) componentTypeFilter.value = 'all';
        if (minPriceInput) minPriceInput.value = '';
        if (maxPriceInput) maxPriceInput.value = '';
        if (sortSelect) sortSelect.value = 'default';
        
        // Сброс кнопок типа товаров
        document.querySelectorAll('.product-type-btn').forEach(btn => {
            btn.classList.remove('bg-primary', 'text-dark');
            btn.classList.add('text-gray-400');
        });
        
        const allBtn = document.querySelector('[data-product-type="all"]');
        if (allBtn) {
            allBtn.classList.add('bg-primary', 'text-dark');
            allBtn.classList.remove('text-gray-400');
            this.currentProductType = 'all';
        }
        
        // Выполняем поиск
        setTimeout(() => this.searchProducts(), 100);
    }

    updateBrowserURL(params) {
        try {
            const url = new URL(window.location.href);
            const searchParams = new URLSearchParams(params);
            
            // Обновляем все параметры
            ['search', 'sortBy', 'componentType', 'minPrice', 'maxPrice', 'productType'].forEach(param => {
                const value = searchParams.get(param);
                if (value) {
                    url.searchParams.set(param, value);
                } else {
                    url.searchParams.delete(param);
                }
            });
            
            // Обновляем историю браузера без перезагрузки
            window.history.replaceState({}, '', url.toString());
            console.log('URL updated:', url.toString());
        } catch (error) {
            console.error('Error updating URL:', error);
        }
    }

    showLoading(show) {
        this.isLoading = show;
        const loadingIndicator = document.getElementById('loadingIndicator');
        const productList = document.getElementById('productList');
        
        console.log('Loading:', show);
        
        if (loadingIndicator) {
            loadingIndicator.classList.toggle('hidden', !show);
        }
        
        if (productList && show) {
            productList.classList.add('opacity-50');
        } else if (productList) {
            productList.classList.remove('opacity-50');
        }
    }

    showError(message) {
        console.error('Showing error:', message);
        
        // Создаем уведомление об ошибке
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 z-50 px-6 py-3 rounded-xl shadow-lg bg-red-600 text-white transition-transform transform translate-x-full';
        notification.innerHTML = `
            <div class="flex items-center gap-3">
                <span class="text-xl">✗</span>
                <span>${message}</span>
            </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.classList.remove('translate-x-full');
            notification.classList.add('translate-x-0');
        }, 10);
        
        setTimeout(() => {
            notification.classList.remove('translate-x-0');
            notification.classList.add('translate-x-full');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 5000);
    }

reinitializeAfterAjax() {
    console.log('=== Reinitializing after AJAX ===');
    
    // Обновляем счетчик результатов
    this.updateResultsCount();
    
    // Восстанавливаем текущий режим отображения
    const savedMode = localStorage.getItem('catalogViewMode') || 'cards';
    this.updateViewDisplay(savedMode);
    
    // Сбрасываем флаг инициализации для перепривязки событий
    this.isInitialized = false;
    
    // Привязываем события к новым элементам
    setTimeout(() => {
        this.bindAllFilterEvents();
        
        // Инициализируем кнопки избранного
        if (typeof initializeFavoriteButtons === 'function') {
            console.log('Initializing favorite buttons...');
            initializeFavoriteButtons();
        }
    }, 100);
}

    bindNewFilterEvents() {
        // Привязываем обработчики к новым кнопкам типа товаров
        document.querySelectorAll('.product-type-btn').forEach(btn => {
            // Удаляем старые обработчики
            btn.replaceWith(btn.cloneNode(true));
        });
        
        // Повторно привязываем все обработчики
        this.bindAllFilterEvents();
    }

    bindCartButtons() {
        // Обработчики для кнопок корзины в новом контенте
        document.querySelectorAll('.add-to-cart').forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                this.addToCart(button);
            });
        });
        
        document.querySelectorAll('.add-to-cart-component').forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                this.addComponentToCart(button);
            });
        });
    }

    async addToCart(button) {
        const computerId = button.dataset.computerId;
        const computerName = button.dataset.computerName;
        
        console.log('Adding computer to cart:', { computerId, computerName });
        
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) {
                console.error('Anti-forgery token not found');
                this.showCartNotification('Ошибка безопасности', null, 'error');
                return;
            }
            
            const response = await fetch('/Cart/AddComputer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `computerId=${computerId}&quantity=1`
            });
            
            const data = await response.json();
            
            if (data.success) {
                this.showCartNotification(`${computerName} добавлен в корзину!`, data.cartItemsCount);
                this.updateCartCounter(data.cartItemsCount);
            } else {
                this.showCartNotification(data.message, null, 'error');
            }
        } catch (error) {
            console.error('Error adding to cart:', error);
            this.showCartNotification('Ошибка при добавлении в корзину', null, 'error');
        }
    }

    async addComponentToCart(button) {
        const componentId = button.dataset.componentId;
        const componentName = button.dataset.componentName;
        
        console.log('Adding component to cart:', { componentId, componentName });
        
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) {
                console.error('Anti-forgery token not found');
                this.showCartNotification('Ошибка безопасности', null, 'error');
                return;
            }
            
            const response = await fetch('/Cart/AddComponent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `componentId=${componentId}&quantity=1`
            });
            
            const data = await response.json();
            
            if (data.success) {
                this.showCartNotification(`${componentName} добавлен в корзину!`, data.cartItemsCount);
                this.updateCartCounter(data.cartItemsCount);
            } else {
                this.showCartNotification(data.message, null, 'error');
            }
        } catch (error) {
            console.error('Error adding component to cart:', error);
            this.showCartNotification('Ошибка при добавлении в корзину', null, 'error');
        }
    }

    showCartNotification(message, count, type = 'success') {
        const notification = document.createElement('div');
        notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-xl shadow-lg text-white transition-transform transform translate-x-full ${
            type === 'success' ? 'bg-green-600' : 'bg-red-600'
        }`;
        notification.innerHTML = `
            <div class="flex items-center gap-3">
                <span class="text-xl">${type === 'success' ? '✓' : '✗'}</span>
                <span>${message}</span>
                ${count ? `<span class="ml-2 bg-white/20 px-2 py-1 rounded text-xs">${count}</span>` : ''}
            </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.classList.remove('translate-x-full');
            notification.classList.add('translate-x-0');
        }, 10);
        
        setTimeout(() => {
            notification.classList.remove('translate-x-0');
            notification.classList.add('translate-x-full');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 3000);
    }

    updateCartCounter(count) {
        console.log('Updating cart counter:', count);
        
        // Обновляем счетчик в шапке
        const counterElements = document.querySelectorAll('[data-cart-count]');
        counterElements.forEach(el => {
            el.textContent = count;
            el.classList.toggle('hidden', count === 0);
        });
    }
}

