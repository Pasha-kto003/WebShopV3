@model WebShopV3.Models.Computer
@{
    ViewData["Title"] = Model.Name;
}

<div class="min-h-screen bg-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Хлебные крошки -->
        <nav class="flex mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="text-gray-400 hover:text-white transition duration-200">Главная</a>
                </li>
                <li class="flex items-center">
                    <span class="text-gray-600 mx-2">/</span>
                    <a asp-controller="Home" asp-action="Catalog" class="text-gray-400 hover:text-white transition duration-200">Каталог</a>
                </li>
                <li class="flex items-center">
                    <span class="text-gray-600 mx-2">/</span>
                    <span class="text-primary">@Model.Name</span>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div>
                @await Html.PartialAsync("Partials/_ComputerGallery", Model)
            </div>

            <div>
                @await Html.PartialAsync("Partials/_ComputerInfo", Model)
            </div>
        </div>

        @await Html.PartialAsync("Partials/_ComputerComponents", Model)

        @await Html.PartialAsync("Partials/_ComputerSpecs", Model)

        @await Html.PartialAsync("Partials/_ComponentGroups", Model)

        @await Html.PartialAsync("Partials/_RecommendedProducts", Model)

        @{
            var recentlyViewed = ViewBag.RecentlyViewed as List<Computer>;
            var recommendedComputers = ViewBag.RecommendedComputers as List<Computer>;
            var recommendedComponents = ViewBag.RecommendedComponents as List<Component>;
        }

        @if (recentlyViewed != null && recentlyViewed.Any())
        {
            @await Html.PartialAsync("_RecentlyViewed", recentlyViewed)
        }
        else if (ViewBag.RecentlyViewedCount > 0)
        {
            <!-- Показываем только текущий компьютер в истории -->
            <div class="mt-12 pt-8 border-t border-gray-800">
                <div class="text-center text-gray-400 py-8">
                    <p>Вы просмотрели только эту сборку</p>
                    <p class="text-sm mt-2">Посмотрите другие сборки, чтобы увидеть их здесь</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("Partials/_ComputerDetailsScripts")
    <script>
        // AJAX очистка истории
        function clearViewHistory() {
            if (!confirm('Очистить историю просмотров?')) return;
            
            fetch('@Url.Action("ClearViewHistory", "Computer")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) {
                    document.querySelector('[data-recently-viewed]').innerHTML = `
                        <div class="text-center py-12">
                            <div class="text-4xl mb-4">✅</div>
                            <p class="text-gray-400">История просмотров очищена</p>
                        </div>
                    `;
                }
            });
        }
        
        // Анимация появления истории просмотров
        document.addEventListener('DOMContentLoaded', function() {
            const historySection = document.querySelector('[data-recently-viewed]');
            if (historySection) {
                setTimeout(() => {
                    historySection.classList.add('opacity-100');
                }, 500);
            }
        });
    </script>
}