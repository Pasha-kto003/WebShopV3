@model WebShopV3.Models.Computer
@{
    ViewData["Title"] = Model.Name;
}

<div class="min-h-screen bg-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Хлебные крошки -->
        <nav class="flex mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="text-gray-400 hover:text-white transition duration-200">Главная</a>
                </li>
                <li class="flex items-center">
                    <span class="text-gray-600 mx-2">/</span>
                    <a asp-controller="Home" asp-action="Catalog" class="text-gray-400 hover:text-white transition duration-200">Каталог</a>
                </li>
                <li class="flex items-center">
                    <span class="text-gray-600 mx-2">/</span>
                    <span class="text-primary">@Model.Name</span>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div>
                @await Html.PartialAsync("Partials/_ComputerGallery", Model)
            </div>

            <div>
                @await Html.PartialAsync("Partials/_ComputerInfo", Model)
            </div>
        </div>

        @await Html.PartialAsync("Partials/_ComputerComponents", Model)

        @await Html.PartialAsync("Partials/_ComputerSpecs", Model)

        @await Html.PartialAsync("Partials/_ComponentGroups", Model)

        @await Html.PartialAsync("Partials/_RecommendedProducts", Model)
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("Partials/_ComputerDetailsScripts")
}