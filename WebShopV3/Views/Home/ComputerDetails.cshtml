@model WebShopV3.Models.Computer
@{
    ViewData["Title"] = Model.Name;
}

<div class="min-h-screen bg-gradient-to-b from-gray-900 to-black pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Хлебные крошки -->
        <nav class="flex mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a asp-action="Index" asp-controller="Home" class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-white">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                        </svg>
                        Главная
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <a asp-action="Catalog" asp-controller="Home" asp-route-productType="computers" class="ml-1 text-sm font-medium text-gray-400 hover:text-white md:ml-2">Компьютеры</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">@Model.Name</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div>
                @await Html.PartialAsync("Partials/_ComputerGallery", Model)
            </div>

            <div>
                @await Html.PartialAsync("Partials/_ComputerInfo", Model)
            </div>
        </div>

        @await Html.PartialAsync("Partials/_ComputerComponents", Model)

        @await Html.PartialAsync("Partials/_ComputerSpecs", Model)

        @await Html.PartialAsync("Partials/_ComponentGroups", Model)

        @await Html.PartialAsync("Partials/_RecommendedProducts", Model)

        @{
            var recentlyViewed = ViewBag.RecentlyViewed as List<Computer>;
            var recommendedComputers = ViewBag.RecommendedComputers as List<Computer>;
            var recommendedComponents = ViewBag.RecommendedComponents as List<Component>;
        }

        @if (recentlyViewed != null && recentlyViewed.Any())
        {
            @await Html.PartialAsync("_RecentlyViewed", recentlyViewed)
        }
        else if (ViewBag.RecentlyViewedCount > 0)
        {
            <!-- Показываем только текущий компьютер в истории -->
            <div class="mt-12 pt-8 border-t border-gray-800">
                <div class="text-center text-gray-400 py-8">
                    <p>Вы просмотрели только эту сборку</p>
                    <p class="text-sm mt-2">Посмотрите другие сборки, чтобы увидеть их здесь</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("Partials/_ComputerDetailsScripts")
    <script>
        // AJAX очистка истории
        function clearViewHistory() {
            if (!confirm('Очистить историю просмотров?')) return;
            
            fetch('@Url.Action("ClearViewHistory", "Computer")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) {
                    document.querySelector('[data-recently-viewed]').innerHTML = `
                        <div class="text-center py-12">
                            <div class="text-4xl mb-4">✅</div>
                            <p class="text-gray-400">История просмотров очищена</p>
                        </div>
                    `;
                }
            });
        }
        
        // Анимация появления истории просмотров
        document.addEventListener('DOMContentLoaded', function() {
            const historySection = document.querySelector('[data-recently-viewed]');
            if (historySection) {
                setTimeout(() => {
                    historySection.classList.add('opacity-100');
                }, 500);
            }
        });
    </script>
}