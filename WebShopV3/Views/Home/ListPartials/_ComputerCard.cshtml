@* Views/Shared/ListPartials/_ComputerCard.cshtml *@
@model WebShopV3.Models.Computer
@using System.Text.Json

@{
    var stockClass = Model.Quantity > 10 ? "stock-high" : Model.Quantity > 3 ? "stock-medium" : "stock-low";
    var stockText = Model.Quantity > 10 ? "Много" : Model.Quantity > 3 ? "Мало" : "Заканчивается";
}

<div class="product-card bg-dark-card rounded-2xl border border-gray-800/50 overflow-hidden card-hover gradient-border">
    <div class="relative">
        <!-- Бейдж скидки (если есть) -->
        @if (Model.Price < 150000)
        {
            <div class="discount-badge">
                <span class="inline-flex items-center gap-1">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm4.707 3.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L8.414 9H10a3 3 0 013 3v1a1 1 0 102 0v-1a5 5 0 00-5-5H8.414l1.293-1.293z" clip-rule="evenodd" />
                    </svg>
                    ХИТ ПРОДАЖ
                </span>
            </div>
        }

        <!-- Кнопка сравнения справа -->
        <div class="absolute top-4 right-4 z-20">
            <!-- Форма для добавления в сравнение -->
            <form asp-action="Add" asp-controller="Compare" method="post" class="inline-block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="productType" value="Computer" />
                <button type="submit"
                        class="compare-btn @(IsInCompare(Model.Id, "Computer") ? "checked" : "")"
                        title="@(IsInCompare(Model.Id, "Computer") ? "Удалить из сравнения" : "Добавить к сравнению")">
                    @if (IsInCompare(Model.Id, "Computer"))
                    {
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    }
                </button>
            </form>
        </div>

        <!-- Кнопка избранного слева -->
        <button class="absolute top-12 left-4 z-20 favorite-btn w-10 h-10 flex items-center justify-center bg-gray-900/80 hover:bg-red-600 text-gray-300 hover:text-white rounded-full transition-all duration-200 backdrop-blur-sm"
                data-product-id="@Model.Id"
                data-product-type="Computer"
                title="Добавить в избранное">
            <svg class="w-5 h-5 favorite-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
        </button>

        <!-- Изображение -->
        <div class="image-container h-56">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="/Images/computers/@Model.ImageUrl" alt="@Model.Name"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-110"
                     loading="lazy" />
            }
            else
            {
                <div class="w-full h-full bg-gradient-to-br from-primary/20 to-green-400/20 flex items-center justify-center">
                    <div class="text-center">
                        <div class="text-5xl mb-2">🖥️</div>
                        <p class="text-gray-400 text-sm">Изображение отсутствует</p>
                    </div>
                </div>
            }

            <!-- Градиентная полоска внизу изображения -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-green-400 to-purple-500 z-10"></div>
        </div>
    </div>

    <!-- Контент карточки -->
    <div class="product-content p-6">
        <!-- Категория и рейтинг -->
        <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                </svg>
                Компьютер
            </span>

            <!-- Рейтинг -->
            <div class="rating-stars">
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star text-gray-600">★</span>
                <span class="text-xs text-gray-400 ml-1">4.0</span>
            </div>
        </div>

        <!-- Название -->
        <h3 class="text-lg font-bold text-white mb-2 line-clamp-1">
            <a href="@Url.Action("ComputerDetails", "Home", new { id = Model.Id })"
               class="hover:text-primary transition-colors duration-200">
                @Model.Name
            </a>
        </h3>

        <!-- Краткое описание -->
        <p class="text-gray-400 text-sm mb-4 line-clamp-2 flex-grow">@Model.Description</p>

        <!-- Основные характеристики -->
        @if (Model.ComputerComponents != null && Model.ComputerComponents.Any())
        {
            // Создаем словарь для группировки компонентов по типу
            var componentsByType = Model.ComputerComponents
            .Where(cc => cc.Component != null)
            .GroupBy(cc => cc.Component.Type)
            .ToDictionary(g => g.Key, g => g.First().Component);

            <div class="specs-grid mb-4">
                @{
                    var componentDisplayNames = new Dictionary<string, string>
                        {
                        { "CPU", "Процессор" },
                        { "GPU", "Видеокарта" },
                        { "RAM", "ОЗУ" },
                        { "SSD", "Накопитель" },
                        { "HDD", "Жесткий диск" },
                        { "Motherboard", "Материнская плата" },
                        { "PSU", "Блок питания" },
                        { "Cooler", "Охлаждение" },
                        { "Case", "Корпус" }
                        };
                }

                @if (componentsByType.TryGetValue("CPU", out var cpuComponent))
                {
                    <div class="spec-item">
                        <div class="spec-icon">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span>
                            @componentDisplayNames.GetValueOrDefault("CPU", "Процессор"):
                            @cpuComponent.Name
                            @{
                                var cpuClock = cpuComponent.ComponentCharacteristics?
                                .FirstOrDefault(cc => cc.Characteristic.Name.Contains("частота") ||
                                cc.Characteristic.Name.Contains("Frequency"))?
                                .Value;
                            }
                            @if (!string.IsNullOrEmpty(cpuClock))
                            {
                                <text>(@cpuClock)</text>
                            }
                        </span>
                    </div>
                }

                @if (componentsByType.TryGetValue("GPU", out var gpuComponent))
                {
                    <div class="spec-item">
                        <div class="spec-icon">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span>
                            @componentDisplayNames.GetValueOrDefault("GPU", "Видеокарта"):
                            @gpuComponent.Name
                            @{
                                var gpuMemory = gpuComponent.ComponentCharacteristics?
                                .FirstOrDefault(cc => cc.Characteristic.Name.Contains("память") ||
                                cc.Characteristic.Name.Contains("Memory"))?
                                .Value;
                            }
                            @if (!string.IsNullOrEmpty(gpuMemory))
                            {
                                <text>(@gpuMemory)</text>
                            }
                        </span>
                    </div>
                }

                @if (componentsByType.TryGetValue("RAM", out var ramComponent))
                {
                    <div class="spec-item">
                        <div class="spec-icon">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span>
                            @componentDisplayNames.GetValueOrDefault("RAM", "ОЗУ"):
                            @{
                                var ramSize = ramComponent.ComponentCharacteristics?
                                .FirstOrDefault(cc => cc.Characteristic.Name.Contains("объем") ||
                                cc.Characteristic.Name.Contains("Size"))?
                                .Value;
                            }
                            @if (!string.IsNullOrEmpty(ramSize))
                            {
                                @ramSize
                            }
                            else
                            {
                                @ramComponent.Name
                            }
                        </span>
                    </div>
                }

                @{
                    var storageComponent = componentsByType.ContainsKey("SSD") ? componentsByType["SSD"] :
                    componentsByType.ContainsKey("HDD") ? componentsByType["HDD"] : null;
                }
                @if (storageComponent != null)
                {
                    <div class="spec-item">
                        <div class="spec-icon">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <span>
                            Память:
                            @{
                                var storageSize = storageComponent.ComponentCharacteristics?
                                .FirstOrDefault(cc => cc.Characteristic.Name.Contains("емкость") ||
                                cc.Characteristic.Name.Contains("Capacity"))?
                                .Value;
                            }
                            @if (!string.IsNullOrEmpty(storageSize))
                            {
                                @storageSize
                            }
                            else
                            {
                                @storageComponent.Name
                            }
                        </span>
                    </div>
                }

                @if (!componentsByType.ContainsKey("CPU") && !componentsByType.ContainsKey("GPU") &&
                            !componentsByType.ContainsKey("RAM") && storageComponent == null)
                {
                    <div class="spec-item">
                        <div class="spec-icon"></div>
                        <span>Характеристики не указаны</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="specs-grid mb-4">
                <div class="spec-item">
                    <div class="spec-icon"></div>
                    <span>Компоненты не указаны</span>
                </div>
            </div>
        }

        <!-- Статус и цена -->
        <div class="mt-auto pt-4 border-t border-gray-800/50">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center mb-2 sm:mb-1">
                        <span class="stock-indicator @stockClass flex-shrink-0"></span>
                        <span class="text-xs text-gray-400 truncate">@stockText (@Model.Quantity шт.)</span>
                    </div>
                    <div class="text-2xl font-bold price-tag truncate">
                        @Model.Price.ToString("C")
                    </div>
                </div>

                <!-- Старая цена (если есть скидка) -->
                @if (Model.Price < 150000)
                {
                    <div class="text-right flex-shrink-0">
                        <div class="text-sm text-gray-500 line-through">
                            @((Model.Price * 1.2m).ToString("C"))
                        </div>
                        <div class="text-xs text-green-400 font-semibold">
                            Экономия @((Model.Price * 0.2m).ToString("C"))
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Кнопки действий -->
        <div class="flex gap-2 mt-4">
            <button class="add-to-cart flex-1 btn-gradient text-white py-3 rounded-xl font-bold hover:shadow-lg hover:shadow-primary/25 transition-all duration-300 flex items-center justify-center gap-2"
                    data-computer-id="@Model.Id"
                    data-computer-name="@Model.Name">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                В корзину
            </button>

            <button class="w-12 flex items-center justify-center bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white rounded-xl transition-all duration-200 flex-shrink-0"
                    title="Быстрый просмотр"
                    onclick="window.location.href='@Url.Action("ComputerDetails", "Home", new { id = Model.Id })'">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </button>
        </div>
    </div>
</div>

@functions {
    private bool IsInCompare(int productId, string productType)
    {
        try
        {
            var compareJson = Context.Session.GetString("CompareItems");
            if (!string.IsNullOrEmpty(compareJson))
            {
                var compareItems = JsonSerializer.Deserialize<List<CompareItem>>(compareJson);
                return compareItems?.Any(x => x.Id == productId.ToString() && x.Type == productType) ?? false;
            }
        }
        catch
        {
            
        }
        return false;
    }
}