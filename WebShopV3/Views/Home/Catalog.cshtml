@model WebShopV3.Models.CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
}

<div class="min-h-screen bg-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Заголовок и управление -->
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-8">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Каталог товаров</h1>
                <p class="text-gray-400" id="resultsCount">
                    Найдено @Model.TotalCount товаров 
                    (@Model.Computers.Count компьютеров, @Model.Components.Count комплектующих)
                </p>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4 mt-4 lg:mt-0">
                <!-- Переключение типа товаров -->
                <div class="flex bg-dark-card rounded-lg p-1 border border-gray-800">
                    <button data-product-type="all" 
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "all" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Все
                    </button>
                    <button data-product-type="computers" 
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "computers" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Компьютеры
                    </button>
                    <button data-product-type="components" 
                            class="product-type-btn p-2 px-4 rounded-md text-sm font-medium transition duration-200 @(ViewBag.ProductType == "components" ? "bg-primary text-dark" : "text-gray-400 hover:text-white")">
                        Комплектующие
                    </button>
                </div>
                
                <!-- Переключение вида -->
                <div class="flex bg-dark-card rounded-lg p-1 border border-gray-800">
                    <button id="cardViewBtn" class="p-2 rounded-md bg-primary text-dark transition duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                    </button>
                    <button id="listViewBtn" class="p-2 rounded-md text-gray-400 hover:text-white transition duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
                
                <!-- Сортировка -->
                <select id="sortSelect" class="bg-dark-card border border-gray-800 rounded-lg px-4 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary"
                    data-sort-by="@ViewBag.SortBy">
                    <option value="default">По умолчанию</option>
                    <option value="price_asc">Цена по возрастанию</option>
                    <option value="price_desc">Цена по убыванию</option>
                    <option value="name_asc">Название А-Я</option>
                    <option value="name_desc">Название Я-А</option>
                    <option value="newest">Сначала новые</option>
                </select>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Боковая панель с фильтрами -->
            <div class="lg:w-1/4">
                <div class="bg-dark-card rounded-2xl p-6 border border-gray-800 mb-6">
                    <h3 class="text-lg font-bold text-white mb-4">Фильтры</h3>
                    
                    <!-- Поиск -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Поиск</label>
                        <input type="text" id="searchInput" 
                               class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary" 
                               placeholder="Введите название..." 
                               value="@ViewBag.SearchQuery">
                    </div>

                    <!-- Тип комплектующих -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Тип комплектующих</label>
                        <select id="componentTypeFilter" class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white focus:border-primary focus:ring-1 focus:ring-primary"
                        data-component-type="@ViewBag.ComponentType">
                            <option value="all">Все типы</option>
                            @foreach (var type in ViewBag.ComponentTypes)
                            {
                                <option value="@type" selected="@(ViewBag.ComponentType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <!-- Цена -->
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-300 mb-2">Цена</label>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="number" id="minPrice" 
                                   class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary" 
                                   placeholder="От" 
                                   value="@ViewBag.MinPrice">
                            <input type="number" id="maxPrice" 
                                   class="w-full bg-dark border border-gray-700 rounded-lg px-3 py-2 text-white placeholder-gray-500 focus:border-primary focus:ring-1 focus:ring-primary" 
                                   placeholder="До" 
                                   value="@ViewBag.MaxPrice">
                        </div>
                    </div>

                    <!-- Кнопка сброса -->
                    <button type="button" id="resetFilters" 
                            class="w-full border-2 border-gray-600 text-gray-400 px-4 py-2 rounded-lg font-semibold hover:border-gray-500 hover:text-white transition duration-300">
                        Сбросить фильтры
                    </button>
                </div>
            </div>

            <!-- Основной контент -->
            <div class="lg:w-3/4">
                <!-- Результаты поиска -->
                <div id="productList">
                    @await Html.PartialAsync("_ComputerListPartial", Model)
                </div>

                <!-- Индикатор загрузки -->
                <div id="loadingIndicator" class="text-center hidden">
                    <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
                    <p class="mt-2 text-gray-400">Поиск товаров...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="currentProductType" value="@ViewBag.ProductType" />

@section Scripts {
    <script>
        // Функции уведомлений и обновления счетчика корзины
function showNotification(message, type = 'info') {
    // Простая реализация уведомлений
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg border-l-4 ${
        type === 'success' ? 'bg-green-500/20 border-green-500 text-green-300' :
        type === 'error' ? 'bg-red-500/20 border-red-500 text-red-300' :
        'bg-blue-500/20 border-blue-500 text-blue-300'
    }`;
    
    notification.innerHTML = `
        <div class="flex items-center">
            <span class="text-lg mr-2">
                ${type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️'}
            </span>
            <span>${message}</span>
        </div>
    `;
    
    document.body.appendChild(notification);
    
    // Автоматическое скрытие через 3 секунды
    setTimeout(() => {
        if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
        }
    }, 3000);
}

function updateCartCounter(count) {
    const cartCounter = document.getElementById('cart-counter');
    if (cartCounter) {
        if (count > 0) {
            cartCounter.textContent = count;
            cartCounter.classList.remove('hidden');
        } else {
            cartCounter.classList.add('hidden');
        }
    }
}

// Функция для получения текущего количества товаров в корзине
function getCartCount() {
    fetch('/Cart/GetCartCount')
        .then(response => response.json())
        .then(data => {
            updateCartCounter(data.count);
        })
        .catch(error => {
            console.error('Error getting cart count:', error);
        });
}

// Инициализация при загрузке страницы
document.addEventListener('DOMContentLoaded', function() {
    // Получаем начальное количество товаров в корзине
    getCartCount();
});

// Функция для показа уведомлений из TempData
function showTempDataMessages() {
    // Проверяем есть ли сообщения в TempData
    const successMessage = document.querySelector('[data-success-message]');
    const errorMessage = document.querySelector('[data-error-message]');
    
    if (successMessage) {
        showNotification(successMessage.dataset.successMessage, 'success');
    }
    
    if (errorMessage) {
        showNotification(errorMessage.dataset.errorMessage, 'error');
    }
}

// Показываем сообщения при загрузке страницы
document.addEventListener('DOMContentLoaded', function() {
    showTempDataMessages();
});

// Основной код каталога
document.addEventListener('DOMContentLoaded', function() {
    // Элементы управления
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const componentTypeFilter = document.getElementById('componentTypeFilter');
    const minPrice = document.getElementById('minPrice');
    const maxPrice = document.getElementById('maxPrice');
    const resetFilters = document.getElementById('resetFilters');
    const cardViewBtn = document.getElementById('cardViewBtn');
    const listViewBtn = document.getElementById('listViewBtn');
    const cardsView = document.getElementById('cardsView');
    const listViewContainer = document.getElementById('listViewContainer');
    const productTypeBtns = document.querySelectorAll('.product-type-btn');
    const currentProductType = document.getElementById('currentProductType');



    // Инициализация значений из ViewBag
    initializeFilters();

    // События поиска и фильтрации
    searchInput.addEventListener('input', debounce(searchProducts, 500));
    sortSelect.addEventListener('change', searchProducts);
    componentTypeFilter.addEventListener('change', searchProducts);
    minPrice.addEventListener('input', debounce(searchProducts, 500));
    maxPrice.addEventListener('input', debounce(searchProducts, 500));

    // Сброс фильтров
    resetFilters.addEventListener('click', function() {
        searchInput.value = '';
        sortSelect.value = 'default';
        componentTypeFilter.value = 'all';
        minPrice.value = '';
        maxPrice.value = '';
        searchProducts();
    });

    // Переключение вида (карточки/список)
    cardViewBtn.addEventListener('click', function() {
        cardViewBtn.classList.add('bg-primary', 'text-dark');
        cardViewBtn.classList.remove('text-gray-400');
        listViewBtn.classList.remove('bg-primary', 'text-dark');
        listViewBtn.classList.add('text-gray-400');
        cardsView.classList.remove('hidden');
        listViewContainer.classList.add('hidden');
    });

    listViewBtn.addEventListener('click', function() {
        listViewBtn.classList.add('bg-primary', 'text-dark');
        listViewBtn.classList.remove('text-gray-400');
        cardViewBtn.classList.remove('bg-primary', 'text-dark');
        cardViewBtn.classList.add('text-gray-400');
        listViewContainer.classList.remove('hidden');
        cardsView.classList.add('hidden');
    });

    // Переключение типа товаров
    productTypeBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            // Обновляем активную кнопку
            productTypeBtns.forEach(b => {
                b.classList.remove('bg-primary', 'text-dark');
                b.classList.add('text-gray-400', 'hover:text-white');
            });
            this.classList.add('bg-primary', 'text-dark');
            this.classList.remove('text-gray-400', 'hover:text-white');
            
            // Обновляем значение и выполняем поиск
            currentProductType.value = this.dataset.productType;
            searchProducts();
        });
    });

    // Обработка добавления в корзину
    document.addEventListener('click', function(e) {
        // Компьютеры
        if (e.target.classList.contains('add-to-cart')) {
            const computerId = e.target.dataset.computerId;
            const computerName = e.target.dataset.computerName;
            addComputerToCart(computerId, computerName);
        }
        
        // Комплектующие
        if (e.target.classList.contains('add-to-cart-component')) {
            const componentId = e.target.dataset.componentId;
            const componentName = e.target.dataset.componentName;
            addComponentToCart(componentId, componentName);
        }
    });

    // Функции для работы с корзиной
    function addComputerToCart(computerId, computerName) {
        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: `computerId=${computerId}&quantity=1`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(`"${computerName}" добавлен в корзину`, 'success');
                updateCartCounter(data.totalItems);
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Ошибка при добавлении в корзину', 'error');
        });
    }

    function addComponentToCart(componentId, componentName) {
        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: `componentId=${componentId}&quantity=1`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(`"${componentName}" добавлен в корзину`, 'success');
                updateCartCounter(data.totalItems);
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Ошибка при добавлении в корзину', 'error');
        });
    }

    // Функция поиска товаров
    function searchProducts() {
        const search = searchInput.value;
        const sortBy = sortSelect.value;
        const componentType = componentTypeFilter.value;
        const minPriceValue = minPrice.value;
        const maxPriceValue = maxPrice.value;
        const productType = currentProductType.value;

        // Строим URL с параметрами
        let url = '/Home/SearchProducts?';
        const params = [];
        
        if (search) params.push(`search=${encodeURIComponent(search)}`);
        if (sortBy && sortBy !== 'default') params.push(`sortBy=${sortBy}`);
        if (componentType && componentType !== 'all') params.push(`componentType=${componentType}`);
        if (minPriceValue) params.push(`minPrice=${minPriceValue}`);
        if (maxPriceValue) params.push(`maxPrice=${maxPriceValue}`);
        if (productType && productType !== 'all') params.push(`productType=${productType}`);
        
        url += params.join('&');

        fetch(url, {
            method: 'GET',
            headers: {
                'Accept': 'text/html'
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            return response.text();
        })
        .then(html => {
            document.getElementById('productList').innerHTML = html;
            updateResultsCount();
            restoreViewAfterSearch();
        })
        .catch(error => {
            console.error('Search failed:', error);
            showNotification('Ошибка поиска: ' + error.message, 'error');
        });
    }

    // Восстанавливает выбранный вид после поиска
    function restoreViewAfterSearch() {
        const isListView = listViewBtn.classList.contains('bg-primary');
        
        if (isListView) {
            cardsView.classList.add('hidden');
            listViewContainer.classList.remove('hidden');
        } else {
            cardsView.classList.remove('hidden');
            listViewContainer.classList.add('hidden');
        }
    }

    // Вспомогательные функции
    function initializeFilters() {
        const sortBy = sortSelect.dataset.sortBy;
        const componentType = componentTypeFilter.dataset.componentType;
        
        if (sortBy) {
            sortSelect.value = sortBy;
        }
        if (componentType) {
            componentTypeFilter.value = componentType;
        }
        
        const currentType = currentProductType.value;
        productTypeBtns.forEach(btn => {
            if (btn.dataset.productType === currentType) {
                btn.classList.add('bg-primary', 'text-dark');
                btn.classList.remove('text-gray-400', 'hover:text-white');
            }
        });
    }

    function updateResultsCount() {
        const computerCards = document.querySelectorAll('.computer-card').length;
        const componentCards = document.querySelectorAll('.component-card').length;
        const totalCount = computerCards + componentCards;
        
        const productType = document.getElementById('currentProductType').value;
        let message = '';
        
        if (productType === 'computers') {
            message = `Найдено ${computerCards} компьютеров`;
        } else if (productType === 'components') {
            message = `Найдено ${componentCards} комплектующих`;
        } else {
            message = `Найдено ${totalCount} товаров (${computerCards} компьютеров, ${componentCards} комплектующих)`;
        }
        
        const resultsCount = document.getElementById('resultsCount');
        if (resultsCount) {
            resultsCount.textContent = message;
        }
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Инициализация при загрузке
    updateResultsCount();
});
    </script>
}